;; Messages and patches that a hand-written participant may send: the host
;; (and the participants) must refuse them and go on. A modification with a
;; path that is too short once made the process die in C++ (tm_throw "empty
;; path" in index (modification)); now such a patch is refused by its shape,
;; and by is_applicable in C++ whatever the caller.
(load (string-append (getenv "SH_DIR") "/lib.scm"))
(define STEP-TIMEOUT 90000)   ; (the deep trees take a while to build and to scan)

(define (A-steps)
  (list
   (act "interactive" (shared-set-interactive! #t))
   (act "load" (load-buffer FILE))
   (act "direct" (shared-set-agent-mode! (the-name) 'direct))
   (act "go" (sync-set! "a-loaded"))
   (wait-sync "b-ready")
   ;; a host that sends patches which do not apply (a participant used to abort in patch-invert)
   (act "bad applied" (let ((st (state-of)))
                        (shared-test-send-peers! (the-name) (list 'applied st "+bad" "host" #f '(compound (pair (remove (1 99 5) "") (insert (1 99) "x")))))
                        (shared-test-send-peers! (the-name) (list 'applied st "+bad2" "host" #f '(compound (pair (insert (1 4) "x") (remove (1 4 1) "")))))
                        (shared-test-send-peers! (the-name) (list 'applied st "+bad3" "host" #f '(compound (pair (join (1 2147483647) "") (split (1 0 0) "")))))
                        (shared-test-send-peers! (the-name) (list 'applied st "+bad4" "host" #f 'garbage))
                        (sync-set! "a-bad-sent")))
   (wait-sync "b-done")
   (act "alive" (check "the host is alive and hosts" (== (role-of) 'host))
        (check "its document is unchanged but for the good patches"
               (== (body-stree) '(document (section "Intro") "Hello world." "Second paragraph." "Third one." "good one" "good two" (ornament "x"))))
        (check "it counted the malformed ones" (>= (shared-stat 'malformed) 8))
        (publish-body!) (sync-set! "a-done"))))

(define nraw 0)
(define (raw-connect)
  (set! nraw (+ nraw 1))
  (let* ((e (shared-entry (the-name))) (c (local-connect (caddr e)))
         (id (string-append "agent.raw" (number->string nraw))))
    (local-send c (object->string (list 'hello (cadddr e) (cadr e) id 4242 #f #f #f)))
    (list c id)))
(define (recv-all c ms)
  (let ((end (+ (texmacs-time) ms)))
    (let loop ((acc '()))
      (let ((s (local-receive c)))
        (cond ((!= s "") (loop (cons s acc)))
              ((> (texmacs-time) end) (reverse acc))
              (else (loop acc)))))))
(define (attempt name mk expect)
  ;; mk: state id -> the message (a string, or an object); expect: a word in the answer
  (let* ((ci (raw-connect)) (c (car ci)) (id (cadr ci))
         (w (recv-all c 500))
         (wm (and (pair? w) (string->object (car w))))
         (cur (and wm (pair? wm) (> (length wm) 1) (cadr wm))))
    (if (not cur)
        (check (string-append name " (no welcome)") #f)
        (let ((msg (mk cur id)))
          (local-send c (if (string? msg) msg (object->string msg)))
          (let ((r (recv-all c 600)))
            (check (string-append name " -> " (or expect "nothing"))
                   (if expect (and (nnull? r) (list-or (map (lambda (x) (string-contains? x expect)) r))) #t)))))
    (local-close c)))
(define (pp ins inv) (list 'pair ins inv))
(define (ins-block i st) (pp `(insert (1 ,i) (document ,st)) `(remove (1 ,i 1) "")))
(define (patch-msg p) (lambda (cur id) (list 'patch (string-append id "/1") cur p)))
(define (deep n) (let loop ((i 0) (x (ins-block 4 "deep"))) (if (= i n) x (loop (+ i 1) (list 'compound x)))))

(define (B-steps)
  (list
   (wait-sync "a-loaded")
   (act "agent" (shared-set-agent! #t))
   (act "load" (load-buffer FILE))
   (act "root-insert-1" (attempt "a root insert with a path of one item" (patch-msg (pp '(insert (1) (document "z")) '(remove (1 1) ""))) "refused"))
   (act "root-insert-3" (attempt "a root insert at 3" (patch-msg (pp '(insert (3) (document "z")) '(remove (3 1) ""))) "refused"))
   (act "short-remove" (attempt "a remove with a short path" (patch-msg (pp '(remove (1 2) "") '(insert (1) "x"))) "refused"))
   (act "wrong-part" (attempt "a wrong part" (patch-msg (pp '(insert (5 0) "x") '(remove (5 0 1) ""))) "refused"))
   (act "no-inverse" (attempt "no inverse" (patch-msg '(pair (insert (1 4) "noinv"))) "refused"))
   (act "garbage" (attempt "garbage" (patch-msg '(frob 1 2 3)) "refused"))
   (act "deep" (attempt "5000 levels (dropped)" (patch-msg (deep 5000)) #f))
   (act "withdraw" (attempt "(withdraw)" (lambda (c i) "(withdraw)") "refused"))
   (act "patch-short" (attempt "(patch 1)" (lambda (c i) "(patch 1)") "refused"))
   (act "patch-badid" (attempt "(patch 5 ...)" (lambda (c i) (list 'patch 5 c '(pair))) "refused"))
   (act "set-cursor" (attempt "a set-cursor in a patch" (patch-msg (pp '(set-cursor (1 1 3) "") '(set-cursor (1 1 3) ""))) "refused"))
   (act "deep-tree" (attempt "a tree 100000 levels deep (no answer, no crash)"
                             (lambda (c i)
                               (string-append "(patch \"" i "/1\" \"" c "\" (pair (insert (1 4) (document "
                                              (apply string-append (make-list 100000 "(frac "))
                                              "\"a\""
                                              (make-string 100000 #\))
                                              ")) (remove (1 4 1) \"\")))")) #f))
   (act "alive after deep" (attempt "and the host answers after it" (patch-msg (ins-block 4 "good one")) "applied"))
   (act "dishonest" (attempt "a dishonest inverse: the forward patch counts" (patch-msg (pp '(insert (1 5) (document "good two")) '(insert (1 0) (document "evil")))) "applied"))
   (act "table-x" (attempt "a table with a string for a row is refused (typesetter crash)" (patch-msg (ins-block 4 '(table "X"))) "arity"))
   (act "empty-table" (attempt "an empty table is refused" (patch-msg (ins-block 4 '(table (row)))) "arity"))
   (act "assign-node-string" (attempt "assign-node to the label of a string" (patch-msg (pp '(assign-node (1 3) "string") '(assign-node (1 3) concat))) "refused"))
   (act "symbol-quote" (attempt "a long message with a tag like l'x is read (and refused as unknown), not dropped"
                                (patch-msg (ins-block 4 (list 'concat (make-string 3500 #\x) (list (string->symbol "l'x") "a")))) "refused"))
   (act "table-tuple" (attempt "a table of tuples is refused" (patch-msg (ins-block 4 '(table (tuple)))) "arity"))
   (act "table-frac" (attempt "a table with a child that is not a row is refused" (patch-msg (ins-block 4 '(table (frac "a" "b")))) "arity"))
   (act "decoration" (attempt "the decoration of a cell is refused" (patch-msg (ins-block 4 '(tformat (cwith "1" "1" "1" "1" "cell-decoration" "x") (table (row (cell "a")))))) "refused"))
   (act "row-span" (attempt "a span that goes beyond the table is refused" (patch-msg (ins-block 4 '(tformat (cwith "1" "1" "1" "1" "cell-row-span" "3") (table (row (cell "a")) (row (cell "b")))))) "refused"))
   (act "ornament" (attempt "an ornament is inserted" (patch-msg (ins-block 6 '(ornament "x"))) "applied"))
   (act "ornament-empty" (attempt "removing the only child of the ornament is refused (arity)" (patch-msg (pp '(remove (1 6 0 1) "") '(insert (1 6 0) "x"))) "arity"))
   (act "wrong-syntax" (attempt "a deep tree hidden by #| |# is dropped"
                                (lambda (c i)
                                  (string-append "(patch \"" i "/1\" \"" c "\" #| \" |# (pair (insert (1 4) (document "
                                                 (apply string-append (make-list 100000 "(frac "))
                                                 "\"a\""
                                                 (make-string 100000 #\))
                                                 ")) (remove (1 4 1) \"\")))")) #f))
   (act "alive after syntax" (attempt "and the host answers after it" (lambda (c i) "(withdraw)") "refused"))
   (act "ready" (sync-set! "b-ready"))
   (wait-sync "a-bad-sent")
   (step "told" (and (>= (shared-stat 'bad-remote) 1) (>= (shared-stat 'resync) 1)))
   (step "resynced" (= (para-count) 7))
   (act "ok" (check "the participant survived a host that sends patches that do not apply" #t))
   (act "b-done" (sync-set! "b-done"))
   (wait-sync "a-done")
   (step "synced" (= (para-count) 7))
   (act "out" (publish-body!))))

(run-steps (if (== ROLE "A") (A-steps) (B-steps)))
