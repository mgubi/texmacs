;; The host (the person: A, interactive) applies the modes to a participant
;; marked as an agent (B, which edits the tree directly, as a client that
;; bypasses texmacs --mcp would): propose (a proposal in the document, accepted
;; or rejected by the person, withdrawn by the agent), direct, read-only, and
;; the content rules of the MCP server applied by the host.
(load (string-append (getenv "SH_DIR") "/lib.scm"))

(define (has-version? st)
  (and (pair? st)
       (or (and (memq (car st) '(version-both version-old version-new)) #t)
           (list-or (map has-version? (cdr st))))))
(define (version-in-doc?) (has-version? (body-stree)))
(define (sync-n n s) (string-append "r" (number->string n) "-" s))
(define (insert-block! i st)
  (tree-var-insert (body) i (stree->tree (list 'document st))))

(define (A-steps)
  (list
   (act "interactive" (shared-set-interactive! #t))
   (act "load" (load-buffer FILE))
   (act "host" (check "A hosts" (== (role-of) 'host)))
   (act "mode" (check "default mode with a person: propose" (eq? (shared-agent-mode (the-name)) 'propose)))
   (act "go" (sync-set! "a-loaded"))
   (wait-sync "b-joined")
   (step "agent listed" (= (length (shared-file-agents (the-name))) 1))
   (act "menu" (switch-to-buffer (the-name))
        (let ((tm (menu-expand '(link tools-menu))))
          (display* "TOOLSMENU " (length tm) "\n")
          (check "the Tools menu has Agents" (string-contains? (object->string tm) "\"Agents\""))
          (let ((am (catch #t (lambda () (menu-expand '(link agents-menu))) (lambda args (display* "AMERR " args "\n") #f))))
            (display* "AGENTSMENU " (object->string am) "\n")
            (check "the Agents menu expands" (and am (string-contains? (object->string am) "Propose edits"))))))
   (act "agent" (check "the host lists the agent" (shared-agent-id? (car (shared-file-agents (the-name))))))
   ;; 1. propose, accept
   (wait-sync (sync-n 1 "b"))
   (step "proposal 1" (nnull? (shared-proposals (the-name))))
   (act "check 1" (check "a proposal, pending" (equal? (list-head (car (shared-proposals (the-name))) 2) '("p1" "pending")))
        (check "the document holds version markup" (version-in-doc?))
        (check "both versions are there" (let ((s (object->string (body-stree)))) (and (string-contains? s "\"Hello \"") (string-contains? s "\"HelloAA \""))))
        (check "the other paragraphs are untouched" (== (para-text 2) "Second paragraph."))
        (check "the host proposed, did not apply" (and (= (shared-stat 'agent-proposed) 1) (= (shared-stat 'peer-patches) 0)))
        (check "accepting works" (shared-proposal-resolve! (the-name) "p1" 'new))
        (check "the new version is in" (and (== (para-text 1) "HelloAA world.") (not (version-in-doc?))))
        (check "the proposal is accepted" (== (cadr (car (shared-proposals (the-name)))) "accepted"))
        (sync-set! (sync-n 1 "a")))
   ;; 2. reject
   (wait-sync (sync-n 2 "b"))
   (step "proposal 2" (= (length (shared-proposals (the-name))) 2))
   (act "check 2" (check "reject: the old version is back" (and (shared-proposal-resolve! (the-name) "p2" 'old) (== (para-text 2) "Second paragraph.") (not (version-in-doc?))))
        (check "a resolved proposal cannot be resolved again" (not (shared-proposal-resolve! (the-name) "p2" 'new)))
        (sync-set! (sync-n 2 "a")))
   ;; 3. withdraw by the agent
   (wait-sync (sync-n 3 "b"))
   (act "check 3" (check "withdrawn: the old version is back" (and (not (version-in-doc?)) (== (para-text 3) "Third one.")))
        (check "status withdrawn" (== (cadr (list-ref (shared-proposals (the-name)) 2)) "withdrawn"))
        (sync-set! (sync-n 3 "a")))
   ;; 4. the person's undo after accepting
   (wait-sync (sync-n 4 "b"))
   (step "proposal 4" (= (length (shared-proposals (the-name))) 4))
   (act "accept 4" (shared-proposal-resolve! (the-name) "p4" 'new)
        (check "accepted" (string-contains? (para-text 1) "QQ")))
   (act "undo" (with-buffer (the-name) (undo 0)))
   (act "check 4" (check "the person's undo brings the markup back" (version-in-doc?))
        (check "and nothing was lost" (string-contains? (object->string (body-stree)) "HelloAAQQ"))
        (with-buffer (the-name) (redo 0)))
   (act "redo" (check "redo: accepted again" (and (not (version-in-doc?)) (string-contains? (para-text 1) "QQ")))
        (sync-set! (sync-n 4 "a")))
   ;; 5. direct
   (act "direct" (check "set the mode" (shared-set-agent-mode! (the-name) 'direct))
        (sync-set! (sync-n 5 "a")))
   (wait-sync (sync-n 5 "b"))
   (act "check 5" (check "direct: applied, no proposal" (and (string-contains? (para-text 2) "DD") (not (version-in-doc?))))
        (sync-set! (sync-n 5 "a2")))
   ;; 6. the content rules in direct mode
   (wait-sync (sync-n 6 "b"))
   (act "check 6" (check "direct: nothing of the refused edits" (and (not (string-contains? (object->string (body-stree)) "javascript")) (not (string-contains? (object->string (body-stree)) "foo"))))
        (check "refused: counted" (= (shared-stat 'agent-refused) 3))
        (check "a good link was applied" (string-contains? (object->string (body-stree)) "https://ok.org"))
        (sync-set! (sync-n 6 "a")))
   ;; 7. the rules in propose mode: a refused content never becomes a proposal
   (act "propose" (shared-set-agent-mode! (the-name) 'propose) (sync-set! (sync-n 7 "a")))
   (wait-sync (sync-n 7 "b"))
   (act "check 7" (check "no proposal for refused content" (and (= (length (shared-proposals (the-name))) 4) (not (version-in-doc?))
                                                                (not (string-contains? (object->string (body-stree)) "javascript"))))
        (sync-set! (sync-n 7 "a2")))
   ;; 8. read-only
   (act "ro" (check "read-only" (shared-set-agent-mode! (the-name) 'read-only)) (sync-set! (sync-n 8 "a")))
   (wait-sync (sync-n 8 "b"))
   (act "check 8" (check "read-only: unchanged" (not (string-contains? (para-text 1) "RO")))
        (sync-set! (sync-n 8 "a2")))
   ;; 9. a saved document with a pending proposal
   (act "propose again" (shared-set-agent-mode! (the-name) 'propose) (sync-set! (sync-n 9 "a")))
   (wait-sync (sync-n 9 "b"))
   (step "proposal 5" (= (length (shared-proposals (the-name))) 5))
   (act "save" (save-buffer-main (the-name)))
   (step "saved" (file-has? FILE "version-both"))
   (act "check 9" (check "the saved file holds both versions" (and (file-has? FILE "SAVEME") (file-has? FILE "paragraph")))
        (check "the tag is plain markup" (not (file-has? FILE "agent")))
        (check "reject" (shared-proposal-resolve! (the-name) "p5" 'old))
        (let ((c (shared-file-gate-stats (the-name))))
          (display* "GATE " c "\n")
          (check "the gate ran for every patch of the agent" (>= (car c) 9)))
        (sync-set! (sync-n 9 "a2")))
   ;; 10. the agent's Save
   (act "ro again" (shared-set-agent-mode! (the-name) 'propose) (sync-set! (sync-n 10 "a")))
   (wait-sync (sync-n 10 "b"))
   (act "check 10" (check "propose: the agent's Save is refused" (= (shared-stat 'save-refused) 1))
        (shared-set-agent-mode! (the-name) 'direct)
        (sync-set! (sync-n 10 "a2")))
   (wait-sync (sync-n 10 "b2"))
   (act "check 10b" (check "direct: the agent's Save is done" (>= (shared-stat 'saves) 2))
        (shared-set-agent-mode! (the-name) 'read-only))
   (wait-sync "b-done")
   (act "A out" (publish-body!) (sync-set! "a-done"))))

(define (verdict-kind) (let ((v (shared-file-verdict (the-name)))) (and v (car v))))
(define last-verdict #f)
(define (take-verdict!) (set! last-verdict (shared-file-verdict (the-name))) last-verdict)
(define rb0 0)

(define (edit-and-wait n edit!)
  ;; edit, and wait for the host's verdict (the edit is taken back)
  (list (act (sync-n n "edit") (set! rb0 (shared-stat 'rolled-back)) (edit!))
        (step (sync-n n "verdict") (and (> (shared-stat 'rolled-back) rb0) (take-verdict!)))))

(define (B-steps)
  (append
   (list
    (wait-sync "a-loaded")
    (act "agent" (shared-set-agent! #t))
    (act "load" (load-buffer FILE))
    (act "participant" (check "B participates" (== (role-of) 'participant)))
    (step "mode" (shared-agent-mode (the-name)))
    (act "mode" (check "B is told the mode" (eq? (shared-agent-mode (the-name)) 'propose)))
    (act "sig" (sync-set! "b-joined")))
   ;; 1
   (edit-and-wait 1 (lambda () (insert-text! 1 5 "AA")))
   (list
    (act "v1" (check "verdict: proposed p1" (and last-verdict (eq? (car last-verdict) 'proposed) (== (caddr last-verdict) "p1")))
          (check "the edit is taken back" (== (pending-count) 0)))
    (step "markup" (version-in-doc?))
    (act "b1" (sync-set! (sync-n 1 "b")))
    (wait-sync (sync-n 1 "a"))
    (step "accepted" (and (not (version-in-doc?)) (== (para-text 1) "HelloAA world.") (nnull? (shared-proposals (the-name)))
                          (== (cadr (car (shared-proposals (the-name)))) "accepted")))
    (act "c1" (check "the agent hears: accepted" #t)))
   ;; 2
   (edit-and-wait 2 (lambda () (insert-text! 2 6 "ZZ")))
   (list
    (step "markup2" (version-in-doc?))
    (act "b2" (sync-set! (sync-n 2 "b")))
    (wait-sync (sync-n 2 "a"))
    (step "rejected" (and (not (version-in-doc?)) (== (para-text 2) "Second paragraph.")
                          (= (length (shared-proposals (the-name))) 2)
                          (== (cadr (cadr (shared-proposals (the-name)))) "rejected")))
    (act "c2" (check "the agent hears: rejected, its copy is the host's" #t)))
   ;; 3
   (edit-and-wait 3 (lambda () (insert-text! 3 5 "WW")))
   (list
    (step "markup3" (version-in-doc?))
    (step "listed" (= (length (shared-proposals (the-name))) 3))
    (act "withdraw" (check "withdraw sent" (shared-file-send-withdraw (the-name) "p3")))
    (step "withdrawn" (and (== (cadr (list-ref (shared-proposals (the-name)) 2)) "withdrawn") (not (version-in-doc?))))
    (act "c3" (check "withdrawn: the old text is back" (== (para-text 3) "Third one."))
          (sync-set! (sync-n 3 "b")))
    (wait-sync (sync-n 3 "a")))
   ;; 4
   (edit-and-wait 4 (lambda () (insert-text! 1 7 "QQ")))
   (list
    (step "markup4" (version-in-doc?))
    (act "b4" (sync-set! (sync-n 4 "b")))
    (wait-sync (sync-n 4 "a")))
   ;; 5: direct
   (list (step "direct" (eq? (shared-agent-mode (the-name)) 'direct))
         (act "edit5" (set! rb0 (shared-stat 'rolled-back)) (insert-text! 2 6 "DD")))
   (list (step "applied" (and (== (pending-count) 0) (not (take-verdict!))))
         (timed-wait 500)
         (act "c5" (check "direct: nothing taken back" (= (shared-stat 'rolled-back) rb0))
               (check "direct: the text stays" (string-contains? (para-text 2) "DD"))
               (sync-set! (sync-n 5 "b"))))
   (list (wait-sync (sync-n 5 "a2")))
   ;; 6: rules
   (edit-and-wait 61 (lambda () (insert-block! 4 '(hlink "x" "javascript:alert(1)"))))
   (list (act "v61" (check "refused: a link to javascript" (and last-verdict (eq? (car last-verdict) 'refused)
                                                                  (== (car (car (caddr last-verdict))) "link")
                                                                  (== (cadr (car (caddr last-verdict))) "links")
                                                                  (string-contains? (caddr (car (caddr last-verdict))) "javascript")))
               (check "and the edit is taken back" (not (string-contains? (object->string (body-stree)) "javascript")))))
   (edit-and-wait 62 (lambda () (insert-block! 4 '(assign "foo" "bar"))))
   (list (act "v62" (check "refused: a definition" (and last-verdict (eq? (car last-verdict) 'refused)
                                                         (== (cadr (car (caddr last-verdict))) "style")))))
   (edit-and-wait 63 (lambda () (insert-block! 4 '(version-both (document "A") (document "B")))))
   (list (act "v63" (check "refused: version markup written by the agent" (and last-verdict (eq? (car last-verdict) 'refused)
                                                                            (== (car (car (caddr last-verdict))) "version-markup")))))
   (list (act "good" (set! rb0 (shared-stat 'rolled-back)) (insert-block! 4 '(hlink "site" "https://ok.org")))
         (step "good applied" (and (== (pending-count) 0) (string-contains? (object->string (body-stree)) "https://ok.org")))
         (timed-wait 500)
         (act "c6" (check "a good link is applied" (= (shared-stat 'rolled-back) rb0))
               (sync-set! (sync-n 6 "b"))))
   ;; 7
   (list (wait-sync (sync-n 7 "a")))
   (edit-and-wait 7 (lambda () (insert-block! 4 '(hlink "x" "javascript:alert(2)"))))
   (list (act "v7" (check "propose mode: refused as well" (and last-verdict (eq? (car last-verdict) 'refused)))
               (sync-set! (sync-n 7 "b"))))
   (list (wait-sync (sync-n 7 "a2")))
   ;; 8
   (list (wait-sync (sync-n 8 "a")))
   (edit-and-wait 8 (lambda () (insert-text! 1 5 "RO")))
   (list (act "v8" (check "read-only: refused with the rule" (and last-verdict (eq? (car last-verdict) 'refused)
                                                                 (== (car (car (caddr last-verdict))) "read-only")))
               (check "read-only: the edit is taken back" (not (string-contains? (para-text 1) "RO")))
               (sync-set! (sync-n 8 "b"))))
   (list (wait-sync (sync-n 8 "a2")))
   ;; 9
   (list (wait-sync (sync-n 9 "a")))
   (edit-and-wait 9 (lambda () (insert-text! 2 0 "SAVEME ")))
   (list (step "markup9" (version-in-doc?))
         (act "b9" (sync-set! (sync-n 9 "b")))
         (wait-sync (sync-n 9 "a2"))
         (step "back" (not (version-in-doc?)))
         (wait-sync (sync-n 10 "a"))
         (act "save" (save-buffer-main (the-name)))
         (step "refused save" (shared-file-save-refused (the-name)))
         (act "c10" (check "the agent is told why" #t) (sync-set! (sync-n 10 "b")))
         (wait-sync (sync-n 10 "a2"))
         (act "save2" (insert-text! 1 5 "ZZ") (save-buffer-main (the-name)))
         (step "saved" (not (buffer-modified? (the-name))))
         (act "c10b" (sync-set! (sync-n 10 "b2")))
         (act "out" (publish-body!) (sync-set! "b-done"))
         (wait-sync "a-done"))))

(run-steps (if (== ROLE "A") (A-steps) (B-steps)))
