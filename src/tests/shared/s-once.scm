(load (string-append (getenv "SH_DIR") "/lib.scm"))
;; "Allow this edit" is for the patch that was shown, not for the patch id: a hand-written client
;; asked about ftp://p1.org keeps sending other patches with the same id (ftp://evil.org); when the
;; person allows, only the first is applied. (Probe of the audit of stage B.)
(define (policy) (if (sync-has? "policy") (sync-read "policy") "hold"))
(define (person!)
  (exec-delayed-pause
   (lambda ()
     (for (q (or (shared-asks (the-name)) '()))
       (let ((pol (string-tokenize-by-char (policy) #\space)))
         (when (!= (car pol) "hold")
           (apply shared-ask-answer! (cons (the-name) (cons (car q) pol))))))
     20)))
(define (A-steps)
  (list
   (act "interactive" (shared-set-interactive! #t))
   (act "load" (load-buffer FILE))
   (act "direct" (shared-set-agent-mode! (the-name) 'direct))
   (act "go" (sync-set! "a-loaded") (person!))
   (wait-sync "b-done")
   (act "check"
        (let ((s (object->string (body-stree))))
          (check "the edit the person was shown is applied" (string-contains? s "p1.org"))
          (check "the edit that reused its id is not" (not (string-contains? s "evil.org")))
          (check "the person was asked" (>= (shared-stat 'agent-asked) 1))
          (check "and nothing stays granted" (null? (shared-trust (the-name)))))
        (publish-body!) (sync-set! "a-done"))))
(define (recv-all c ms)
  (let ((end (+ (texmacs-time) ms)))
    (let loop ((acc '()))
      (let ((s (local-receive c)))
        (cond ((!= s "") (loop (cons s acc)))
              ((> (texmacs-time) end) (reverse acc))
              (else (loop acc)))))))
(define (pp ins inv) (list 'pair ins inv))
(define (ins-block i st) (pp `(insert (1 ,i) (document ,st)) `(remove (1 ,i 1) "")))
(define cur #f)
(define nblocks 4)
(define (digest! fr)
  (for (s fr)
    (let ((m (catch #t (lambda () (string->object s)) (lambda args #f))))
      (when (and (pair? m) (== (car m) 'applied)) (set! cur (caddr m)) (set! nblocks (+ nblocks 1)))
      (when (and (pair? m) (memq (car m) '(refused proposed)) (> (length m) 2)) (set! cur (caddr m))))))
(define (B-steps)
  (list
   (wait-sync "a-loaded")
   (act "agent" (shared-set-agent! #t))
   (act "load" (load-buffer FILE))
   (act "t1"
        (let* ((e (shared-entry (the-name))) (c (local-connect (caddr e))))
          (local-send c (object->string (list 'hello (cadddr e) (cadr e) "agent.onceprobe" 4242 #f #f #f)))
          (let* ((w (recv-all c 600)) (wm (and (pair? w) (string->object (car w)))))
            (set! cur (cadr wm)))
          (local-send c (object->string (list 'agent-name "raw")))
          (local-send c (object->string (list 'patch "agent.onceprobe/1" cur (ins-block nblocks '(hlink "x" "ftp://p1.org")))))
          (let ((fr (recv-all c 800)))
            (check "the first edit is asked about" (list-or (map (lambda (x) (string-contains? x "asking")) fr))) (digest! fr))
          (sync-write! "policy" "once")
          (let loop ((i 0))
            (when (< i 150)
              (local-send c (object->string (list 'patch "agent.onceprobe/1" cur (ins-block nblocks '(hlink "x" "ftp://evil.org")))))
              (let ((fr (recv-all c 15)))
                (when (pair? fr) (digest! fr)))
              (loop (+ i 1))))
          (recv-all c 500)
          (local-send c "(leave)") (local-close c)))
   (act "done" (publish-body!) (sync-set! "b-done"))
   (wait-sync "a-done")))
(run-steps (if (== ROLE "A") (A-steps) (B-steps)))
