<TeXmacs|2.1.5>

<style|<tuple|beamer|slides>>

<\body>
  <\screens>
    <\slide>
      <tit|A sample presentation>

      <doc-data|<doc-title|A sample presentation>|<doc-author|<author-data|<author-name|Ada
      Lovelace>>>>
    </slide>
  <|screens>
    <\slide>
      <tit|Lists>

      A presentation is a sequence of screens, each with a title in the bar
      at the top and its number among the screens at the right.

      <\itemize>
        <item>The paper version prints one screen per page.

        <item>The pages are as large as the screens.

        <\itemize>
          <item>Nested items have their own bullets.
        </itemize>
      </itemize>
    </slide>
  <|screens>
    <\slide>
      <tit|Mathematics>

      <\theorem>
        For all <math|n\<geqslant\>1>, <math|<big|sum><rsub|k=1><rsup|n>k<rsup|3>=<around*|(|<big|sum><rsub|k=1><rsup|n>k|)><rsup|2>>.
      </theorem>

      <\equation*>
        <big|int><rsub|0><rsup|1>x<rsup|2>*\<mathd\>x=<frac|1|3>
      </equation*>
    </slide>
  <|screens>
    <tit|The last screen>

    <\enumerate>
      <item>Screens are numbered.

      <item>The last one is not followed by an empty page.
    </enumerate>
  </screens>
</body>

<initial|<\collection>
</collection>>
