# pulldown menus of the main window; in a small window the Help menu must
# be shifted back into the window
wait 5000
window #2
click 409 12
wait 800
snapshot m1
click 700 500
wait 500
resize 640 200
wait 800
click 557 12
wait 800
snapshot m2
# a menu taller than the window scrolls with the wheel
move 600 100
wait 200
wheel 600 100 0 -5
wait 500
snapshot m3
