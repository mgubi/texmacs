# needs pattern-palette.scm: the pattern cells of the "Color" menu (pal),
# one of them hovered (pal-hover), then chosen: the document shows
# "got: (document (with color (pattern ...vintage/... ) Hello patterns))"
wait 6000
window Palette
snapshot pal
move 100 200
wait 400
snapshot pal-hover
click 100 200
wait 3500
window #2
snapshot doc
