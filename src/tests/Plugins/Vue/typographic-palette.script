# needs typographic-palette.scm: a typographic palette of the "Color" menu
# (pal), the list of the palettes opened (sets: Classical, the standard
# grid, then the typographic ones), and "Earth" chosen in it:
# the grid is made again with the colours of the set, the menu stays open
# (earth), and the choice is kept in the preference "typographic palette set"
wait 7000
window Palette
snapshot pal
click 110 10
wait 800
snapshot sets
click 90 82
wait 800
move 120 160
wait 800
snapshot earth
scheme (display* "palette: " (get-preference "typographic palette set") "\n")
wait 300
# the output, which run.sh checks: the palettes (printed when the test
# starts), and the one chosen in the menu
expect got: ("Classical" "Muted" "Classic print" "Earth" "Nordic" "Pastel" "Solarized" "Sea")
expect palette: Earth
