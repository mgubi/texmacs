# The git commit of the sources (#753), as the header git_revision.hpp (see
# src/System/Boot/build_revision.cpp).  Run in script mode at each build:
#   cmake -DSRC_DIR=<top of the tree> -DOUT=<header> -P GitRevision.cmake
# The header is rewritten only if its content changes, so a new commit
# rebuilds build_revision.cpp and nothing else.  No git, or a tree not tracked
# by git (a source tarball): the revision is empty, with no error.
set (_rev "")
find_package (Git QUIET)
if (GIT_FOUND)
  execute_process (
    COMMAND "${GIT_EXECUTABLE}" -C "${SRC_DIR}" ls-files --error-unmatch configure.in
    RESULT_VARIABLE _tracked OUTPUT_QUIET ERROR_QUIET)
  if (_tracked EQUAL 0)
    execute_process (
      COMMAND "${CMAKE_COMMAND}" -E env TZ=UTC "${GIT_EXECUTABLE}" -C "${SRC_DIR}"
        log -1 --abbrev=10 "--format=%h %cd" "--date=format-local:%Y-%m-%dT%H:%M:%SZ"
      RESULT_VARIABLE _res OUTPUT_VARIABLE _out ERROR_QUIET)
    string (STRIP "${_out}" _out)
    if (_res EQUAL 0 AND _out MATCHES "^[0-9a-f]+ [0-9][0-9][0-9][0-9]-[-0-9T:Z]+$")
      set (_rev "${_out}")
    endif ()
  endif ()
endif ()
# git gives nothing in a checkout (no git program, "dubious ownership"): keep the
# header of a former good run, with a warning
if (_rev STREQUAL "" AND EXISTS "${OUT}"
    AND (EXISTS "${SRC_DIR}/.git" OR EXISTS "${SRC_DIR}/../.git"))
  message (WARNING "git gives no revision: ${OUT} kept")
  return ()
endif ()
set (_new "// generated by cmake/GitRevision.cmake: do not edit\n#define TM_GIT_REVISION \"${_rev}\"\n")
set (_old "")
if (EXISTS "${OUT}")
  file (READ "${OUT}" _old)
endif ()
if (NOT _old STREQUAL _new)
  file (WRITE "${OUT}" "${_new}")
endif ()
