;; MODULE      : init-texmacs-boot-file.scm
;; DESCRIPTION : TeXmacs Chez Scheme boot-file / AOT bootstrap
;;               (curated startup heap + lazy-loading of remaining modules)
;; COPYRIGHT   : (C) 2026
