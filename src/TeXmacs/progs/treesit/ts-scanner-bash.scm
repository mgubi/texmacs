;; A port of src/scanner.c of tree-sitter-bash (MIT): heredocs, the words
;; of expansions, regular expressions and extended globs, variable names,
;; file descriptors and the tokens which depend on what follows them. The
;; protocol of the scanners is described in ts-scan.scm.
;;
;; The C code is followed closely, quirks included, since the trees must be
;; those of tree-sitter: the stack of the heredocs never shrinks when a
;; state is restored (an empty state resets the fields of each heredoc, a
;; state with fewer heredocs only overwrites the first ones); a delimiter
;; keeps the null character which ends it, and characters are stored as
;; the chars of C (code points truncated to a signed byte).

(texmacs-module (treesit ts-scanner-bash)
  (:use (treesit ts-base) (treesit ts-parse) (treesit ts-chars)
        (treesit ts-scan)))

(define t-heredoc-start 0)
(define t-simple-heredoc-body 1)
(define t-heredoc-body-beginning 2)
(define t-heredoc-content 3)
(define t-heredoc-end 4)
(define t-file-descriptor 5)
(define t-empty-value 6)
(define t-concat 7)
(define t-variable-name 8)
(define t-test-operator 9)
(define t-regex 10)
(define t-regex-no-slash 11)
(define t-regex-no-space 12)
(define t-expansion-word 13)
(define t-extglob-pattern 14)
(define t-bare-dollar 15)
(define t-brace-start 16)
(define t-immediate-double-hash 17)
(define t-external-expansion-sym-hash 18)
(define t-external-expansion-sym-bang 19)
(define t-external-expansion-sym-equal 20)
(define t-closing-brace 21)
(define t-closing-bracket 22)
(define t-heredoc-arrow 23)
(define t-heredoc-arrow-dash 24)
(define t-newline 25)
(define t-opening-paren 26)
(define t-esac 27)
(define t-error-recovery 28)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; State
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; the payload is #(last-glob-paren-depth ext-was-in-double-quote
;; ext-saw-outside-quote heredocs), heredocs being the list of the heredocs,
;; the last one being the current one (array_back in C); a heredoc is
;; #(is-raw started allows-indent delimiter current-leading-word), the
;; strings as lists of chars of C (integers)

(define (make-heredoc) (vector #f #f #f '() '()))
(define (hd-raw? h) (vector-ref h 0))
(define (hd-started? h) (vector-ref h 1))
(define (hd-indent? h) (vector-ref h 2))
(define (hd-delimiter h) (vector-ref h 3))

(define (heredocs p) (vector-ref p 3))
(define (last-heredoc p) (let ((l (heredocs p))) (list-ref l (- (length l) 1))))
(define (push-heredoc! p h) (vector-set! p 3 (append (heredocs p) (list h))))
(define (pop-heredoc! p)
  (let ((l (heredocs p)))
    (vector-set! p 3 (list-head l (- (length l) 1)))))

(define (reset-heredoc! h)
  (vector-set! h 0 #f)
  (vector-set! h 1 #f)
  (vector-set! h 2 #f)
  (vector-set! h 3 '()))

(define (bash-create) (vector 0 #f #f '()))

(define (bash-serialize p)
  ;; never #f: an empty state would reset the heredocs when restored
  (list (vector-ref p 0) (vector-ref p 1) (vector-ref p 2)
        (map (lambda (h) (list (hd-raw? h) (hd-started? h) (hd-indent? h)
                               (hd-delimiter h)))
             (heredocs p))))

(define (bash-deserialize p state)
  (if (not state)
      (for-each reset-heredoc! (heredocs p))
      (begin
        (vector-set! p 0 (car state))
        (vector-set! p 1 (cadr state))
        (vector-set! p 2 (caddr state))
        (let loop ((l (cadddr state)) (i 0))
          (when (pair? l)
            (when (>= i (length (heredocs p))) (push-heredoc! p (make-heredoc)))
            (let ((h (list-ref (heredocs p) i)) (s (car l)))
              (vector-set! h 0 (car s))
              (vector-set! h 1 (cadr s))
              (vector-set! h 2 (caddr s))
              (vector-set! h 3 (cadddr s)))
            (loop (cdr l) (+ i 1)))))))

(define (c-char c)
  ;; a code point stored in a char of C
  (let ((b (modulo c 256))) (if (>= b 128) (- b 256) b)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Heredocs
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (advance-word lx h)
  ;; a word, unquoted, appended to the delimiter of h with a null character;
  ;; whether it is not empty (#f also when a \ ends the text)
  (call-with-exit
   (lambda (out)
     (let ((empty #t) (q 0) (acc '()))
       (when (or (= (lexer-lookahead lx) 39) (= (lexer-lookahead lx) 34))
         (set! q (lexer-lookahead lx))
         (lexer-advance! lx #f))
       (let loop ()
         (let ((c (lexer-lookahead lx)))
           (when (and (not (= c 0))
                      (not (if (> q 0)
                               (or (= c q) (= c 13) (= c 10))
                               (ts-wspace? c))))
             (when (= c 92)
               (lexer-advance! lx #f)
               (when (= (lexer-lookahead lx) 0)
                 (vector-set! h 3 (append (hd-delimiter h) (reverse acc)))
                 (out #f)))
             (set! empty #f)
             (set! acc (cons (c-char (lexer-lookahead lx)) acc))
             (lexer-advance! lx #f)
             (loop))))
       (vector-set! h 3 (append (hd-delimiter h) (reverse (cons 0 acc))))
       (when (and (> q 0) (= (lexer-lookahead lx) q))
         (lexer-advance! lx #f))
       (not empty)))))

(define (scan-bare-dollar lx)
  (let loop ()
    (let ((c (lexer-lookahead lx)))
      (when (and (ts-wspace? c) (not (= c 10)) (not (lexer-eof? lx)))
        (lexer-advance! lx #t)
        (loop))))
  (and (= (lexer-lookahead lx) 36)
       (begin
         (lexer-advance! lx #f)
         (lexer-set-result! lx t-bare-dollar)
         (lexer-mark-end! lx)
         (or (ts-wspace? (lexer-lookahead lx)) (lexer-eof? lx)
             (= (lexer-lookahead lx) 34)))))

(define (scan-heredoc-start h lx)
  (scan-skip-spaces! lx #t #t)
  (lexer-set-result! lx t-heredoc-start)
  (let ((c (lexer-lookahead lx)))
    (vector-set! h 0 (or (= c 39) (= c 34) (= c 92))))
  (or (advance-word lx h)
      (begin (vector-set! h 3 '()) #f)))

(define (scan-heredoc-end-identifier h lx)
  ;; whether the line starts with the delimiter of h (strcmp in C)
  (let ((d (hd-delimiter h)))
    (and (pair? d)
         (let loop ((l d) (k 0))
           (let ((c (lexer-lookahead lx)))
             (if (and (not (= c 0)) (not (= c 10)) (pair? l) (= (car l) c))
                 (begin (lexer-advance! lx #f) (loop (cdr l) (+ k 1)))
                 ;; the k characters match: equal when the delimiter ends there
                 (and (pair? l) (= (car l) 0))))))))

(define (scan-heredoc-content p lx middle end)
  (let ((h (last-heredoc p)) (did #f) (result #f))
    (define (result! t) (set! result t) (lexer-set-result! lx t))
    (call-with-exit
     (lambda (out)
       (let loop ()
         (let ((c (lexer-lookahead lx)))
           (cond
            ((= c 0)
             (when (and (lexer-eof? lx) did)
               (reset-heredoc! h)
               (result! end)
               (out #t))
             (out #f))
            ((= c 92)
             (set! did #t)
             (lexer-advance! lx #f)
             (lexer-advance! lx #f))
            ((= c 36)
             (cond ((hd-raw? h)
                    (set! did #t)
                    (lexer-advance! lx #f))
                   (did
                    (lexer-mark-end! lx)
                    (result! middle)
                    (vector-set! h 1 #t)
                    (lexer-advance! lx #f)
                    (let ((c (lexer-lookahead lx)))
                      (when (or (ts-walpha? c) (= c 123) (= c 40))
                        (out #t))))
                   ((and (= middle t-heredoc-body-beginning) (= (lexer-column lx) 0))
                    (result! middle)
                    (vector-set! h 1 #t)
                    (out #t))
                   (else (out #f))))
            ((= c 10)
             (lexer-advance! lx (not did))
             (set! did #t)
             (when (hd-indent? h)
               (scan-skip-spaces! lx #f #t))
             (result! (if (hd-started? h) middle end))
             (lexer-mark-end! lx)
             (when (scan-heredoc-end-identifier h lx)
               (when (= result t-heredoc-end) (pop-heredoc! p))
               (out #t)))
            (else
             (when (= (lexer-column lx) 0)
               (scan-skip-spaces! lx (not did) #t)
               (when (not (= end t-simple-heredoc-body))
                 (result! middle)
                 (when (scan-heredoc-end-identifier h lx) (out #t)))
               (when (= end t-simple-heredoc-body)
                 (result! end)
                 (lexer-mark-end! lx)
                 (when (scan-heredoc-end-identifier h lx) (out #t))))
             (set! did #t)
             (lexer-advance! lx #f)))
           (loop)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; The sections after the labels of C (regex:, extglob_pattern:,
;; expansion_word:, brace_start:): each gives its result, or 'next when the
;; C code goes on with the following one
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (scan-regex p lx valid? err?)
  (if (not (and (or (valid? t-regex) (valid? t-regex-no-slash) (valid? t-regex-no-space))
                (not err?)))
      'next
      (begin
        (when (or (valid? t-regex) (valid? t-regex-no-space))
          (scan-skip-spaces! lx #t #t))
        (if (not (or (and (not (= (lexer-lookahead lx) 34)) (not (= (lexer-lookahead lx) 39)))
                     (and (or (= (lexer-lookahead lx) 36) (= (lexer-lookahead lx) 39)) (valid? t-regex-no-slash))
                     (and (= (lexer-lookahead lx) 39) (valid? t-regex-no-space))))
            'next
            (call-with-exit
             (lambda (out)
               (when (and (= (lexer-lookahead lx) 36) (valid? t-regex-no-slash))
                 (lexer-mark-end! lx)
                 (lexer-advance! lx #f)
                 (when (= (lexer-lookahead lx) 40) (out #f)))
               (lexer-mark-end! lx)
               (let ((done #f) (advanced-once #f) (found-non #f) (last-escape #f)
                     (in-quote #f) (parens 0) (brackets 0) (braces 0))
                 (let loop ()
                   (unless done
                     (when (and in-quote (= (lexer-lookahead lx) 39))
                       (set! in-quote #f)
                       (lexer-advance! lx #f)
                       (lexer-mark-end! lx))
                     (let ((c (lexer-lookahead lx)) (skip-rest #f))
                       (cond ((= c 92) (set! last-escape #t))
                             ((= c 0) (out #f))
                             ((= c 40) (set! parens (+ parens 1)) (set! last-escape #f))
                             ((= c 91) (set! brackets (+ brackets 1)) (set! last-escape #f))
                             ((= c 123)
                              (unless last-escape (set! braces (+ braces 1)))
                              (set! last-escape #f))
                             ((= c 41)
                              (when (= parens 0) (set! done #t))
                              (set! parens (- parens 1))
                              (set! last-escape #f))
                             ((= c 93)
                              (when (= brackets 0) (set! done #t))
                              (set! brackets (- brackets 1))
                              (set! last-escape #f))
                             ((= c 125)
                              (when (= braces 0) (set! done #t))
                              (set! braces (- braces 1))
                              (set! last-escape #f))
                             ((= c 39)
                              (set! in-quote (not in-quote))
                              (lexer-advance! lx #f)
                              (set! advanced-once #t)
                              (set! last-escape #f)
                              (set! skip-rest #t))
                             (else (set! last-escape #f)))
                       (when (and (not skip-rest) (not done))
                         (cond
                          ((valid? t-regex)
                           (let ((was-space (and (not in-quote) (ts-wspace? (lexer-lookahead lx)))))
                             (lexer-advance! lx #f)
                             (set! advanced-once #t)
                             (when (or (not was-space) (> parens 0)) (lexer-mark-end! lx))))
                          ((valid? t-regex-no-slash)
                           (cond ((= (lexer-lookahead lx) 47)
                                  (lexer-mark-end! lx)
                                  (lexer-set-result! lx t-regex-no-slash)
                                  (out advanced-once))
                                 ((= (lexer-lookahead lx) 92)
                                  (lexer-advance! lx #f)
                                  (set! advanced-once #t)
                                  (when (and (not (lexer-eof? lx)) (not (= (lexer-lookahead lx) 91))
                                             (not (= (lexer-lookahead lx) 47)))
                                    (lexer-advance! lx #f)
                                    (lexer-mark-end! lx)))
                                 (else
                                  (let ((was-space (and (not in-quote) (ts-wspace? (lexer-lookahead lx)))))
                                    (lexer-advance! lx #f)
                                    (set! advanced-once #t)
                                    (unless was-space (lexer-mark-end! lx))))))
                          ((valid? t-regex-no-space)
                           (cond ((= (lexer-lookahead lx) 92)
                                  (set! found-non #t)
                                  (lexer-advance! lx #f)
                                  (unless (lexer-eof? lx) (lexer-advance! lx #f)))
                                 ((= (lexer-lookahead lx) 36)
                                  (lexer-mark-end! lx)
                                  (lexer-advance! lx #f)
                                  (when (= (lexer-lookahead lx) 40) (out #f))
                                  (when (ts-wspace? (lexer-lookahead lx))
                                    (lexer-set-result! lx t-regex-no-space)
                                    (lexer-mark-end! lx)
                                    (out #t)))
                                 (else
                                  (let ((was-space (and (not in-quote) (ts-wspace? (lexer-lookahead lx)))))
                                    (when (and was-space (= parens 0))
                                      (lexer-mark-end! lx)
                                      (lexer-set-result! lx t-regex-no-space)
                                      (out found-non))
                                    (let ((c (lexer-lookahead lx)))
                                      (unless (or (ts-walnum? c) (= c 36) (= c 45) (= c 95))
                                        (set! found-non #t)))
                                    (lexer-advance! lx #f))))))))
                       (loop)))
                 (lexer-set-result! lx (cond ((valid? t-regex-no-slash) t-regex-no-slash)
                                             ((valid? t-regex-no-space) t-regex-no-space)
                                             (else t-regex)))
                 (not (and (valid? t-regex) (not advanced-once))))))))))

(define (scan-extglob p lx valid? err?)
  (if (not (and (valid? t-extglob-pattern) (not err?)))
      'next
      (call-with-exit
       (lambda (out)
         (scan-skip-spaces! lx #t #t)
         (unless (or (= (lexer-lookahead lx) 63) (= (lexer-lookahead lx) 42) (= (lexer-lookahead lx) 43) (= (lexer-lookahead lx) 64) (= (lexer-lookahead lx) 33) (= (lexer-lookahead lx) 45)
                     (= (lexer-lookahead lx) 41) (= (lexer-lookahead lx) 92) (= (lexer-lookahead lx) 46) (= (lexer-lookahead lx) 91) (ts-walpha? (lexer-lookahead lx)))
           (vector-set! p 0 0)
           (out #f))
         (when (= (lexer-lookahead lx) 92)
           (lexer-advance! lx #f)
           (if (and (or (ts-wspace? (lexer-lookahead lx)) (= (lexer-lookahead lx) 34)) (not (= (lexer-lookahead lx) 13))
                    (not (= (lexer-lookahead lx) 10)))
               (lexer-advance! lx #f)
               (out #f)))
         (when (and (= (lexer-lookahead lx) 41) (= (vector-ref p 0) 0))
           (lexer-mark-end! lx)
           (lexer-advance! lx #f)
           (when (ts-wspace? (lexer-lookahead lx)) (out #f)))
         (lexer-mark-end! lx)
         (let ((was-non-alpha (not (ts-walpha? (lexer-lookahead lx)))))
           (unless (= (lexer-lookahead lx) 91)
             ;; no esac
             (if (= (lexer-lookahead lx) 101)
                 (begin
                   (lexer-mark-end! lx)
                   (lexer-advance! lx #f)
                   (when (= (lexer-lookahead lx) 115)
                     (lexer-advance! lx #f)
                     (when (= (lexer-lookahead lx) 97)
                       (lexer-advance! lx #f)
                       (when (= (lexer-lookahead lx) 99)
                         (lexer-advance! lx #f)
                         (when (ts-wspace? (lexer-lookahead lx)) (out #f))))))
                 (lexer-advance! lx #f)))
           ;; -\w is just a word, find something else special
           (when (= (lexer-lookahead lx) 45)
             (lexer-mark-end! lx)
             (lexer-advance! lx #f)
             (let loop () (when (ts-walnum? (lexer-lookahead lx)) (lexer-advance! lx #f) (loop)))
             (when (or (= (lexer-lookahead lx) 41) (= (lexer-lookahead lx) 92) (= (lexer-lookahead lx) 46)) (out #f))
             (lexer-mark-end! lx))
           ;; case item -) or *)
           (when (and (= (lexer-lookahead lx) 41) (= (vector-ref p 0) 0))
             (lexer-mark-end! lx)
             (lexer-advance! lx #f)
             (when (ts-wspace? (lexer-lookahead lx))
               (lexer-set-result! lx t-extglob-pattern)
               (out was-non-alpha)))
           (when (ts-wspace? (lexer-lookahead lx))
             (lexer-mark-end! lx)
             (lexer-set-result! lx t-extglob-pattern)
             (vector-set! p 0 0)
             (out #t))
           (when (= (lexer-lookahead lx) 36)
             (lexer-mark-end! lx)
             (lexer-advance! lx #f)
             (when (or (= (lexer-lookahead lx) 123) (= (lexer-lookahead lx) 40))
               (lexer-set-result! lx t-extglob-pattern)
               (out #t)))
           (when (= (lexer-lookahead lx) 124)
             (lexer-mark-end! lx)
             (lexer-advance! lx #f)
             (lexer-set-result! lx t-extglob-pattern)
             (out #t))
           (let ((c (lexer-lookahead lx)))
             (unless (or (ts-walnum? c) (memv c '(40 34 91 63 47 92 95 42)))
               (out #f)))
           (let ((done #f) (saw-non was-non-alpha) (parens (vector-ref p 0))
                 (brackets 0) (braces 0))
             (let loop ()
               (unless done
                 (let ((c (lexer-lookahead lx)))
                   (cond ((= c 0) (out #f))
                         ((= c 40) (set! parens (+ parens 1)))
                         ((= c 91) (set! brackets (+ brackets 1)))
                         ((= c 123) (set! braces (+ braces 1)))
                         ((= c 41)
                          (when (= parens 0) (set! done #t))
                          (set! parens (- parens 1)))
                         ((= c 93)
                          (when (= brackets 0) (set! done #t))
                          (set! brackets (- brackets 1)))
                         ((= c 125)
                          (when (= braces 0) (set! done #t))
                          (set! braces (- braces 1)))))
                 (when (= (lexer-lookahead lx) 124)
                   (lexer-mark-end! lx)
                   (lexer-advance! lx #f)
                   (when (and (= parens 0) (= brackets 0) (= braces 0))
                     (lexer-set-result! lx t-extglob-pattern)
                     (out #t)))
                 (unless done
                   (let ((was-space (ts-wspace? (lexer-lookahead lx))))
                     (when (= (lexer-lookahead lx) 36)
                       (lexer-mark-end! lx)
                       (unless (or (ts-walpha? (lexer-lookahead lx)) (= (lexer-lookahead lx) 46) (= (lexer-lookahead lx) 92))
                         (set! saw-non #t))
                       (lexer-advance! lx #f)
                       (when (or (= (lexer-lookahead lx) 40) (= (lexer-lookahead lx) 123))
                         (lexer-set-result! lx t-extglob-pattern)
                         (vector-set! p 0 (c-byte parens))
                         (out saw-non)))
                     (when was-space
                       (lexer-mark-end! lx)
                       (lexer-set-result! lx t-extglob-pattern)
                       (vector-set! p 0 0)
                       (out saw-non))
                     (when (= (lexer-lookahead lx) 34)
                       (lexer-mark-end! lx)
                       (lexer-set-result! lx t-extglob-pattern)
                       (vector-set! p 0 0)
                       (out saw-non))
                     (if (= (lexer-lookahead lx) 92)
                         (begin
                           (unless (or (ts-walpha? (lexer-lookahead lx)) (= (lexer-lookahead lx) 46) (= (lexer-lookahead lx) 92))
                             (set! saw-non #t))
                           (lexer-advance! lx #f)
                           (when (or (ts-wspace? (lexer-lookahead lx)) (= (lexer-lookahead lx) 34)) (lexer-advance! lx #f)))
                         (begin
                           (unless (or (ts-walpha? (lexer-lookahead lx)) (= (lexer-lookahead lx) 46) (= (lexer-lookahead lx) 92))
                             (set! saw-non #t))
                           (lexer-advance! lx #f)))
                     (unless was-space (lexer-mark-end! lx))))
                 (loop)))
             (lexer-set-result! lx t-extglob-pattern)
             (vector-set! p 0 0)
             saw-non))))))

(define (c-byte n)
  ;; an unsigned integer stored in a uint8_t
  (modulo n 256))

(define (scan-expansion-word p lx valid?)
  (if (not (valid? t-expansion-word))
      'next
      (call-with-exit
       (lambda (out)
         (let ((advanced-once #f) (advance-once-space #f))
           (define (expansion-start?)
             (let ((c (lexer-lookahead lx)))
               (or (= c 123) (= c 40) (= c 39) (ts-walnum? c))))
           (let loop ()
             (when (= (lexer-lookahead lx) 34) (out #f))
             (when (= (lexer-lookahead lx) 36)
               (lexer-mark-end! lx)
               (lexer-advance! lx #f)
               (when (expansion-start?)
                 (lexer-set-result! lx t-expansion-word)
                 (out advanced-once))
               (set! advanced-once #t))
             (when (= (lexer-lookahead lx) 125)
               (lexer-mark-end! lx)
               (lexer-set-result! lx t-expansion-word)
               (out (or advanced-once advance-once-space)))
             (when (and (= (lexer-lookahead lx) 40) (not (or advanced-once advance-once-space)))
               (lexer-mark-end! lx)
               (lexer-advance! lx #f)
               (let inner ()
                 (when (and (not (= (lexer-lookahead lx) 41)) (not (lexer-eof? lx)))
                   (if (= (lexer-lookahead lx) 36)
                       (begin
                         (lexer-mark-end! lx)
                         (lexer-advance! lx #f)
                         (when (expansion-start?)
                           (lexer-set-result! lx t-expansion-word)
                           (out advanced-once))
                         (set! advanced-once #t))
                       (let ((ws (ts-wspace? (lexer-lookahead lx))))
                         (set! advanced-once (or advanced-once (not ws)))
                         (set! advance-once-space (or advance-once-space ws))
                         (lexer-advance! lx #f)))
                   (inner)))
               (lexer-mark-end! lx)
               (if (= (lexer-lookahead lx) 41)
                   (begin
                     (set! advanced-once #t)
                     (lexer-advance! lx #f)
                     (lexer-mark-end! lx)
                     (when (= (lexer-lookahead lx) 125) (out #f)))
                   (out #f)))
             (when (= (lexer-lookahead lx) 39) (out #f))
             (when (lexer-eof? lx) (out #f))
             (let ((ws (ts-wspace? (lexer-lookahead lx))))
               (set! advanced-once (or advanced-once (not ws)))
               (set! advance-once-space (or advance-once-space ws))
               (lexer-advance! lx #f))
             (loop)))))))

(define (scan-brace-start p lx valid? err?)
  (define (digits!) (scan-advance-while! lx "0123456789" #f))
  (if (not (and (valid? t-brace-start) (not err?)))
      'next
      (begin
        (scan-skip-spaces! lx #t #t)
        (and (= (lexer-lookahead lx) 123)
             (begin (lexer-advance! lx #f) (lexer-mark-end! lx) (digits!) (= (lexer-lookahead lx) 46))
             (begin (lexer-advance! lx #f) (= (lexer-lookahead lx) 46))
             (begin (lexer-advance! lx #f) (digits!) (= (lexer-lookahead lx) 125))
             (begin (lexer-set-result! lx t-brace-start) #t)))))

(define (from-section k p lx valid? err?)
  ;; the C code from the label k on: 0 regex, 1 extglob_pattern,
  ;; 2 expansion_word, 3 brace_start
  (let ((r (cond ((= k 0) (scan-regex p lx valid? err?))
                 ((= k 1) (scan-extglob p lx valid? err?))
                 ((= k 2) (scan-expansion-word p lx valid?))
                 (else (scan-brace-start p lx valid? err?)))))
    (cond ((not (eq? r 'next)) r)
          ((< k 3) (from-section (+ k 1) p lx valid? err?))
          (else #f))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; The scanner
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (bash-scan p lx valid)
  (let ((err? (vector-ref valid t-error-recovery)))
    (define (goto k) (from-section k p lx (lambda (i) (vector-ref valid i)) err?))
    (call-with-exit
     (lambda (out)
       ;; concatenations
       (when (and (vector-ref valid t-concat) (not err?))
         (unless (or (= (lexer-lookahead lx) 0) (ts-wspace? (lexer-lookahead lx)) (= (lexer-lookahead lx) 62) (= (lexer-lookahead lx) 60) (= (lexer-lookahead lx) 41) (= (lexer-lookahead lx) 40)
                     (= (lexer-lookahead lx) 59) (= (lexer-lookahead lx) 38) (= (lexer-lookahead lx) 124)
                     (and (= (lexer-lookahead lx) 125) (vector-ref valid t-closing-brace))
                     (and (= (lexer-lookahead lx) 93) (vector-ref valid t-closing-bracket)))
           (lexer-set-result! lx t-concat)
           ;; for a`b`, a concat if the second backtick is followed by a space
           (cond ((= (lexer-lookahead lx) 96)
                  (lexer-mark-end! lx)
                  (lexer-advance! lx #f)
                  (let loop ()
                    (when (and (not (= (lexer-lookahead lx) 96)) (not (lexer-eof? lx)))
                      (lexer-advance! lx #f)
                      (loop)))
                  (when (lexer-eof? lx) (out #f))
                  (when (= (lexer-lookahead lx) 96) (lexer-advance! lx #f))
                  (out (or (ts-wspace? (lexer-lookahead lx)) (lexer-eof? lx))))
                 ;; strings with expansions which contain escaped quotes or
                 ;; backslashes
                 ((= (lexer-lookahead lx) 92)
                  (lexer-mark-end! lx)
                  (lexer-advance! lx #f)
                  (when (or (= (lexer-lookahead lx) 34) (= (lexer-lookahead lx) 39) (= (lexer-lookahead lx) 92)) (out #t))
                  (when (lexer-eof? lx) (out #f)))
                 (else (out #t))))
         (when (and (ts-wspace? (lexer-lookahead lx)) (vector-ref valid t-closing-brace) (not (vector-ref valid t-expansion-word)))
           (lexer-set-result! lx t-concat)
           (out #t)))
       ;; ## not followed by }
       (when (and (vector-ref valid t-immediate-double-hash) (not err?) (= (lexer-lookahead lx) 35))
         (lexer-mark-end! lx)
         (lexer-advance! lx #f)
         (when (= (lexer-lookahead lx) 35)
           (lexer-advance! lx #f)
           (unless (= (lexer-lookahead lx) 125)
             (lexer-set-result! lx t-immediate-double-hash)
             (lexer-mark-end! lx)
             (out #t))))
       ;; # = ! of expansions
       (when (and (vector-ref valid t-external-expansion-sym-hash) (not err?)
                  (or (= (lexer-lookahead lx) 35) (= (lexer-lookahead lx) 61) (= (lexer-lookahead lx) 33)))
         (lexer-set-result! lx (cond ((= (lexer-lookahead lx) 35) t-external-expansion-sym-hash)
                        ((= (lexer-lookahead lx) 33) t-external-expansion-sym-bang)
                        (else t-external-expansion-sym-equal)))
         (lexer-advance! lx #f)
         (lexer-mark-end! lx)
         (scan-advance-while! lx "#=!" #f)
         (scan-skip-spaces! lx #t #t)
         (out (= (lexer-lookahead lx) 125)))
       (when (and (vector-ref valid t-empty-value)
                  (or (ts-wspace? (lexer-lookahead lx)) (lexer-eof? lx) (= (lexer-lookahead lx) 59) (= (lexer-lookahead lx) 38)))
         (lexer-set-result! lx t-empty-value)
         (out #t))
       ;; heredocs
       (when (and (or (vector-ref valid t-heredoc-body-beginning) (vector-ref valid t-simple-heredoc-body))
                  (pair? (heredocs p)) (not (hd-started? (last-heredoc p)))
                  (not err?))
         (out (scan-heredoc-content p lx t-heredoc-body-beginning
                                    t-simple-heredoc-body)))
       (when (and (vector-ref valid t-heredoc-end) (pair? (heredocs p)))
         (when (scan-heredoc-end-identifier (last-heredoc p) lx)
           (pop-heredoc! p)
           (lexer-set-result! lx t-heredoc-end)
           (out #t)))
       (when (and (vector-ref valid t-heredoc-content) (pair? (heredocs p))
                  (hd-started? (last-heredoc p)) (not err?))
         (out (scan-heredoc-content p lx t-heredoc-content t-heredoc-end)))
       (when (and (vector-ref valid t-heredoc-start) (not err?) (pair? (heredocs p)))
         (out (scan-heredoc-start (last-heredoc p) lx)))
       ;; test operators
       (when (and (vector-ref valid t-test-operator) (not (vector-ref valid t-expansion-word)))
         (scan-skip-spaces! lx #t #f)
         (when (= (lexer-lookahead lx) 92)
           (when (vector-ref valid t-extglob-pattern) (out (goto 1)))
           (when (vector-ref valid t-regex-no-space) (out (goto 0)))
           (lexer-advance! lx #t)
           (when (lexer-eof? lx) (out #f))
           (cond ((= (lexer-lookahead lx) 13) (lexer-advance! lx #t) (when (= (lexer-lookahead lx) 10) (lexer-advance! lx #t)))
                 ((= (lexer-lookahead lx) 10) (lexer-advance! lx #t))
                 (else (out #f)))
           (scan-skip-spaces! lx #t #t))
         (when (and (= (lexer-lookahead lx) 10) (not (vector-ref valid t-newline)))
           (lexer-advance! lx #t)
           (scan-skip-spaces! lx #t #t))
         (when (= (lexer-lookahead lx) 45)
           (lexer-advance! lx #f)
           (let ((advanced-once (> (scan-advance-while-alpha! lx) 0)))
             (when (and (ts-wspace? (lexer-lookahead lx)) advanced-once)
               (lexer-mark-end! lx)
               (lexer-advance! lx #f)
               (when (and (= (lexer-lookahead lx) 125) (vector-ref valid t-closing-brace))
                 (when (vector-ref valid t-expansion-word)
                   (lexer-mark-end! lx)
                   (lexer-set-result! lx t-expansion-word)
                   (out #t))
                 (out #f))
               (lexer-set-result! lx t-test-operator)
               (out #t))
             (when (and (ts-wspace? (lexer-lookahead lx)) (vector-ref valid t-extglob-pattern))
               (lexer-set-result! lx t-extglob-pattern)
               (out #t))))
         (when (and (vector-ref valid t-bare-dollar) (not err?) (scan-bare-dollar lx))
           (out #t)))
       ;; variable names, file descriptors and <<
       (when (and (or (vector-ref valid t-variable-name) (vector-ref valid t-file-descriptor)
                      (vector-ref valid t-heredoc-arrow))
                  (not (vector-ref valid t-regex-no-slash)) (not err?))
         (let loop ()
           (cond ((and (or (= (lexer-lookahead lx) 32) (= (lexer-lookahead lx) 9) (= (lexer-lookahead lx) 13)
                           (and (= (lexer-lookahead lx) 10) (not (vector-ref valid t-newline))))
                       (not (vector-ref valid t-expansion-word)))
                  (lexer-advance! lx #t)
                  (loop))
                 ((= (lexer-lookahead lx) 92)
                  (lexer-advance! lx #t)
                  (when (lexer-eof? lx)
                    (lexer-mark-end! lx)
                    (lexer-set-result! lx t-variable-name)
                    (out #t))
                  (when (= (lexer-lookahead lx) 13) (lexer-advance! lx #t))
                  (if (= (lexer-lookahead lx) 10)
                      (begin (lexer-advance! lx #t) (loop))
                      (begin
                        (when (and (= (lexer-lookahead lx) 92) (vector-ref valid t-expansion-word)) (out (goto 2)))
                        (out #f))))))
         ;; no * @ ? - $ 0 _
         (when (and (not (vector-ref valid t-expansion-word))
                    (or (= (lexer-lookahead lx) 42) (= (lexer-lookahead lx) 64) (= (lexer-lookahead lx) 63) (= (lexer-lookahead lx) 45) (= (lexer-lookahead lx) 48) (= (lexer-lookahead lx) 95)))
           (lexer-mark-end! lx)
           (lexer-advance! lx #f)
           (when (or (= (lexer-lookahead lx) 61) (= (lexer-lookahead lx) 91) (= (lexer-lookahead lx) 58) (= (lexer-lookahead lx) 45) (= (lexer-lookahead lx) 37) (= (lexer-lookahead lx) 35) (= (lexer-lookahead lx) 47))
             (out #f))
           (when (and (vector-ref valid t-extglob-pattern) (ts-wspace? (lexer-lookahead lx)))
             (lexer-mark-end! lx)
             (lexer-set-result! lx t-extglob-pattern)
             (out #t)))
         (when (and (vector-ref valid t-heredoc-arrow) (= (lexer-lookahead lx) 60))
           (lexer-advance! lx #f)
           (unless (= (lexer-lookahead lx) 60) (out #f))
           (lexer-advance! lx #f)
           (cond ((= (lexer-lookahead lx) 45)
                  (lexer-advance! lx #f)
                  (let ((h (make-heredoc)))
                    (vector-set! h 2 #t)
                    (push-heredoc! p h))
                  (lexer-set-result! lx t-heredoc-arrow-dash))
                 ((or (= (lexer-lookahead lx) 60) (= (lexer-lookahead lx) 61)) (out #f))
                 (else
                  (push-heredoc! p (make-heredoc))
                  (lexer-set-result! lx t-heredoc-arrow)))
           (out #t))
         (let ((is-number #t))
           (cond ((ts-wdigit? (lexer-lookahead lx)) (lexer-advance! lx #f))
                 ((or (ts-walpha? (lexer-lookahead lx)) (= (lexer-lookahead lx) 95)) (set! is-number #f) (lexer-advance! lx #f))
                 (else
                  (when (= (lexer-lookahead lx) 123) (out (goto 3)))
                  (when (vector-ref valid t-expansion-word) (out (goto 2)))
                  (when (vector-ref valid t-extglob-pattern) (out (goto 1)))
                  (out #f)))
           (let loop ()
             (cond ((ts-wdigit? (lexer-lookahead lx)) (lexer-advance! lx #f) (loop))
                   ((or (ts-walpha? (lexer-lookahead lx)) (= (lexer-lookahead lx) 95)) (set! is-number #f) (lexer-advance! lx #f) (loop))))
           (when (and is-number (vector-ref valid t-file-descriptor) (or (= (lexer-lookahead lx) 62) (= (lexer-lookahead lx) 60)))
             (lexer-set-result! lx t-file-descriptor)
             (out #t))
           (when (vector-ref valid t-variable-name)
             (when (= (lexer-lookahead lx) 43)
               (lexer-mark-end! lx)
               (lexer-advance! lx #f)
               (if (or (= (lexer-lookahead lx) 61) (= (lexer-lookahead lx) 58) (vector-ref valid t-closing-brace))
                   (begin (lexer-set-result! lx t-variable-name) (out #t))
                   (out #f)))
             (when (= (lexer-lookahead lx) 47) (out #f))
             (when (or (= (lexer-lookahead lx) 61) (= (lexer-lookahead lx) 91)
                       (and (= (lexer-lookahead lx) 58) (not (vector-ref valid t-closing-brace))
                            (not (vector-ref valid t-opening-paren)))
                       (= (lexer-lookahead lx) 37)
                       (and (= (lexer-lookahead lx) 35) (not is-number))
                       (= (lexer-lookahead lx) 64)
                       (and (= (lexer-lookahead lx) 45) (vector-ref valid t-closing-brace)))
               (lexer-mark-end! lx)
               (lexer-set-result! lx t-variable-name)
               (out #t))
             (when (= (lexer-lookahead lx) 63)
               (lexer-mark-end! lx)
               (lexer-advance! lx #f)
               (lexer-set-result! lx t-variable-name)
               (out (ts-walpha? (lexer-lookahead lx)))))
           (out #f)))
       (when (and (vector-ref valid t-bare-dollar) (not err?) (scan-bare-dollar lx))
         (out #t))
       (goto 0)))))

(define (scan-advance-while-alpha! lx)
  (let loop ((k 0))
    (if (ts-walpha? (lexer-lookahead lx))
        (begin (lexer-advance! lx #f) (loop (+ k 1)))
        k)))

(define-public (ts-bash-scanner)
  (vector bash-create bash-scan bash-deserialize bash-serialize))
