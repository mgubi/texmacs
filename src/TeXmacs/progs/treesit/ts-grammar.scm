;; The steps of prepare_grammar in tree-sitter: a grammar.json is read into
;; rules, the names are resolved to symbols, the tokens are extracted into the
;; lexical grammar, the repetitions become auxiliary rules and the rules are
;; flattened into productions.
;;
;; Rules are lists:
;;
;;   (blank) (eof) (string s) (pattern s flags) (named s) (sym n)
;;   (seq r ...) (choice r ...) (repeat r) (meta params r) (reserved ctx r)
;;
;; where n is a symbol (see ts-base.scm) and params is a vector
;; #(prec assoc dynamic-prec alias field token? main-token?): prec is #f, an
;; integer or a string (a named precedence), assoc #f, left or right, alias #f
;; or (value . named?), field #f or a string.
;;
;; A production step is a vector #(symbol prec assoc alias field reserved), a
;; production a vector #(steps dynamic-prec requires-eof?) with a vector of
;; steps.

(texmacs-module (treesit ts-grammar)
  (:use (treesit ts-base)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Variable types, ordered as in tree-sitter
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-public vt-hidden 0)
(define-public vt-auxiliary 1)
(define-public vt-anonymous 2)
(define-public vt-named 3)

(define-public (vt-visible? k) (>= k vt-anonymous))

(define (variable-type-for-name name)
  (if (and (> (string-length name) 0) (char=? (string-ref name 0) #\_))
      vt-hidden vt-named))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Helpers
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-public (ts-map fun l)
  ;; map, from left to right
  (let loop ((l l) (acc '()))
    (if (null? l) (reverse acc) (loop (cdr l) (cons (fun (car l)) acc)))))

(define-public (ts-map2 fun l1 l2)
  (let loop ((l1 l1) (l2 l2) (acc '()))
    (if (or (null? l1) (null? l2)) (reverse acc)
        (loop (cdr l1) (cdr l2) (cons (fun (car l1) (car l2)) acc)))))

(define-public (ts-map-index fun l)
  (let loop ((l l) (i 0) (acc '()))
    (if (null? l) (reverse acc)
        (loop (cdr l) (+ i 1) (cons (fun i (car l)) acc)))))

(define-public (ts-error . args)
  (apply error "tree-sitter grammar:" args))

;; grammars are hash tables of fields
(define-public (g-ref g key) (ahash-ref g key))
(define-public (g-set! g key val) (ahash-set! g key val))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Construction of rules
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-public (default-params) (vector #f #f 0 #f #f #f #f))
(define-public (p-prec p) (vector-ref p 0))
(define-public (p-assoc p) (vector-ref p 1))
(define-public (p-dynamic p) (vector-ref p 2))
(define-public (p-alias p) (vector-ref p 3))
(define-public (p-field p) (vector-ref p 4))
(define-public (p-token? p) (vector-ref p 5))
(define-public (p-main? p) (vector-ref p 6))

(define (vector-copy* v)
  (let* ((n (vector-length v)) (r (make-vector n #f)))
    (do ((i 0 (+ i 1))) ((= i n) r) (vector-set! r i (vector-ref v i)))))

(define (metadata-with content fun)
  ;; set some parameters of the rule content, in its own metadata when it
  ;; has one which is not a token
  (if (and (eq? (car content) 'meta) (not (p-token? (cadr content))))
      (let ((p (vector-copy* (cadr content))))
        (fun p)
        (list 'meta p (caddr content)))
      (let ((p (default-params)))
        (fun p)
        (list 'meta p content))))

(define-public (make-choice members)
  ;; nested choices are flattened and the duplicates removed
  (let loop ((stack members) (acc '()))
    (cond ((null? stack) (cons 'choice (reverse acc)))
          ((eq? (car (car stack)) 'choice)
           (loop (append (cdr (car stack)) (cdr stack)) acc))
          ((member (car stack) acc) (loop (cdr stack) acc))
          (else (loop (cdr stack) (cons (car stack) acc))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Reading grammar.json
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (parse-prec v) (if (string? v) v v))

(define (parse-rule j in-token?)
  (let ((type (json-get j "type")))
    (define (content) (parse-rule (json-get j "content") in-token?))
    (define (members)
      (ts-map (lambda (m) (parse-rule m in-token?))
              (json-arr-items (json-get j "members"))))
    (cond ((equal? type "ALIAS")
           (let ((c (content)))
             (metadata-with c (lambda (p)
                                (vector-set! p 3 (cons (json-get j "value")
                                                       (eq? (json-get j "named") #t)))))))
          ((equal? type "BLANK") (list 'blank))
          ((equal? type "STRING") (list 'string (json-get j "value")))
          ((equal? type "PATTERN")
           (let* ((flags (or (json-get j "flags") ""))
                  (kept (if (ts-any (lambda (c) (char=? c #\i)) (string->list flags))
                            "i" "")))
             (list 'pattern (json-get j "value") kept)))
          ((equal? type "SYMBOL")
           (if in-token?
               (ts-error "unexpected rule in token()" (json-get j "name"))
               (list 'named (json-get j "name"))))
          ((equal? type "CHOICE") (make-choice (members)))
          ((equal? type "SEQ") (cons 'seq (members)))
          ((equal? type "FIELD")
           (let ((c (content)))
             (metadata-with c (lambda (p) (vector-set! p 4 (json-get j "name"))))))
          ((equal? type "REPEAT")
           (make-choice (list (list 'repeat (content)) (list 'blank))))
          ((equal? type "REPEAT1") (list 'repeat (content)))
          ((equal? type "PREC")
           (let ((c (content)))
             (metadata-with c (lambda (p) (vector-set! p 0 (parse-prec (json-get j "value")))))))
          ((equal? type "PREC_LEFT")
           (let ((c (content)))
             (metadata-with c (lambda (p)
                                (vector-set! p 1 'left)
                                (vector-set! p 0 (parse-prec (json-get j "value")))))))
          ((equal? type "PREC_RIGHT")
           (let ((c (content)))
             (metadata-with c (lambda (p)
                                (vector-set! p 1 'right)
                                (vector-set! p 0 (parse-prec (json-get j "value")))))))
          ((equal? type "PREC_DYNAMIC")
           (let ((c (content)))
             (metadata-with c (lambda (p) (vector-set! p 2 (json-get j "value"))))))
          ((equal? type "RESERVED")
           (list 'reserved (json-get j "context_name") (content)))
          ((equal? type "TOKEN")
           (metadata-with (parse-rule (json-get j "content") #t)
                          (lambda (p) (vector-set! p 5 #t))))
          ((equal? type "IMMEDIATE_TOKEN")
           (metadata-with (parse-rule (json-get j "content") #t)
                          (lambda (p) (vector-set! p 5 #t) (vector-set! p 6 #t))))
          ((equal? type "EOF") (list 'eof))
          (else (ts-error "unknown rule type" type)))))

(define (rule-children r)
  (case (car r)
    ((seq choice) (cdr r))
    ((repeat) (list (cadr r)))
    ((meta reserved) (list (caddr r)))
    (else '())))

(define (collect-referenced-ids r skip-top acc)
  ;; the names referenced by a rule, prepended to acc
  (case (car r)
    ((named) (if skip-top acc (cons (cadr r) acc)))
    ((seq choice)
     (let loop ((l (cdr r)) (acc acc))
       (if (null? l) acc (loop (cdr l) (collect-referenced-ids (car l) #f acc)))))
    ((meta reserved) (collect-referenced-ids (caddr r) skip-top acc))
    ((repeat) (collect-referenced-ids (cadr r) #f acc))
    (else acc)))

(define (rule-is-referenced? r name external?)
  (case (car r)
    ((named) (and (equal? (cadr r) name) (not external?)))
    ((seq choice) (ts-any (lambda (c) (rule-is-referenced? c name #f)) (cdr r)))
    ((meta reserved) (rule-is-referenced? (caddr r) name external?))
    ((repeat) (rule-is-referenced? (cadr r) name #f))
    (else #f)))

(define-public (parse-grammar-json j)
  ;; the input grammar of a grammar.json read by string->json
  (let* ((g (make-ahash-table))
         (extras (ts-map (lambda (e) (parse-rule e #f))
                         (json-arr-items (json-get j "extras" '(arr)))))
         (externals (ts-map (lambda (e) (parse-rule e #f))
                            (json-arr-items (json-get j "externals" '(arr)))))
         (precs (ts-map (lambda (l)
                          (ts-map (lambda (e)
                                    (let ((type (json-get e "type")))
                                      (cond ((equal? type "STRING")
                                             (cons 'name (json-get e "value")))
                                            ((equal? type "SYMBOL")
                                             (cons 'symbol (json-get e "name")))
                                            (else (ts-error "invalid precedence")))))
                                  (json-arr-items l)))
                        (json-arr-items (json-get j "precedences" '(arr)))))
         (vars (ts-map (lambda (kv) (cons (car kv) (parse-rule (cdr kv) #f)))
                       (cdr (json-get j "rules"))))
         (reserved (ts-map (lambda (kv)
                             (cons (car kv)
                                   (ts-map (lambda (e) (parse-rule e #f))
                                           (json-arr-items (cdr kv)))))
                           (cdr (json-get j "reserved" '(obj))))))
    (for-each (lambda (e)
                (when (and (eq? (car e) 'string) (equal? (cadr e) ""))
                  (ts-error "rules in extras must not contain empty strings")))
              extras)
    (g-set! g 'name (json-get j "name"))
    (g-set! g 'variables vars)
    (g-set! g 'extras extras)
    (g-set! g 'externals externals)
    (g-set! g 'precedences precs)
    (g-set! g 'reserved reserved)
    (g-set! g 'supertypes (json-arr-items (json-get j "supertypes" '(arr))))
    (g-set! g 'conflicts (ts-map json-arr-items
                                 (json-arr-items (json-get j "conflicts" '(arr)))))
    (g-set! g 'inline (json-arr-items (json-get j "inline" '(arr))))
    (g-set! g 'word (let ((w (json-get j "word"))) (and (string? w) w)))
    (normalize-grammar! g)
    g))

(define (normalize-grammar! g)
  ;; remove the rules which cannot be reached
  (let* ((vars (g-ref g 'variables))
         (visited (make-ahash-table))
         (stack '()))
    (when (pair? vars) (set! stack (list (car (car vars)))))
    (when (g-ref g 'word) (set! stack (cons (g-ref g 'word) stack)))
    (for-each (lambda (r) (set! stack (collect-referenced-ids r #f stack)))
              (g-ref g 'extras))
    (for-each (lambda (r) (set! stack (collect-referenced-ids r #t stack)))
              (g-ref g 'externals))
    (for-each (lambda (set)
                (for-each (lambda (r) (set! stack (collect-referenced-ids r #f stack)))
                          (cdr set)))
              (g-ref g 'reserved))
    (let loop ()
      (when (pair? stack)
        (let ((name (car stack)))
          (set! stack (cdr stack))
          (unless (ahash-ref visited name)
            (ahash-set! visited name #t)
            (let ((v (assoc name vars)))
              (when v (set! stack (collect-referenced-ids (cdr v) #f stack))))))
        (loop)))
    (let ((dropped (ts-filter (lambda (n) (not (ahash-ref visited n)))
                              (map car vars))))
      (g-set! g 'variables (ts-filter (lambda (v) (ahash-ref visited (car v))) vars))
      (for-each
       (lambda (name)
         (g-set! g 'conflicts (ts-filter (lambda (c) (not (member name c)))
                                         (g-ref g 'conflicts)))
         (g-set! g 'supertypes (ts-filter (lambda (s) (not (equal? s name)))
                                          (g-ref g 'supertypes)))
         (g-set! g 'inline (ts-filter (lambda (s) (not (equal? s name)))
                                      (g-ref g 'inline)))
         (g-set! g 'extras (ts-filter (lambda (r) (not (rule-is-referenced? r name #t)))
                                      (g-ref g 'extras)))
         (g-set! g 'externals (ts-filter (lambda (r) (not (rule-is-referenced? r name #t)))
                                         (g-ref g 'externals)))
         (g-set! g 'precedences
                 (ts-filter (lambda (o) (not (member (cons 'symbol name) o)))
                            (g-ref g 'precedences)))
         (g-set! g 'reserved
                 (ts-map (lambda (set)
                           (cons (car set)
                                 (ts-filter (lambda (r) (not (rule-is-referenced? r name #f)))
                                            (cdr set))))
                         (g-ref g 'reserved))))
       dropped))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Interning symbols
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (intern-rule r table)
  (case (car r)
    ((named)
     (let ((s (ahash-ref table (cadr r))))
       (if s (list 'sym s) (ts-error "undefined symbol" (cadr r)))))
    ((seq choice) (cons (car r) (ts-map (lambda (c) (intern-rule c table)) (cdr r))))
    ((repeat) (list 'repeat (intern-rule (cadr r) table)))
    ((meta reserved) (list (car r) (cadr r) (intern-rule (caddr r) table)))
    (else r)))

(define (intern-symbols! g)
  (let ((table (make-ahash-table))
        (vars (g-ref g 'variables)))
    (ts-map-index (lambda (i v) (ahash-set! table (car v) (non-terminal i))) vars)
    (ts-map-index (lambda (i r)
                    (when (and (eq? (car r) 'named) (not (ahash-ref table (cadr r))))
                      (ahash-set! table (cadr r) (external i))))
                  (g-ref g 'externals))
    (when (= (variable-type-for-name (car (car vars))) vt-hidden)
      (ts-error "a grammar's start rule must be visible"))
    (g-set! g 'external-info
            (ts-map (lambda (r)
                      (if (eq? (car r) 'named)
                          (cons (cadr r) (variable-type-for-name (cadr r)))
                          (cons #f vt-anonymous)))
                    (g-ref g 'externals)))
    (g-set! g 'kinds (list->vector (ts-map (lambda (v) (variable-type-for-name (car v))) vars)))
    (g-set! g 'variables (ts-map (lambda (v) (cons (car v) (intern-rule (cdr v) table))) vars))
    (g-set! g 'externals (ts-map (lambda (r) (intern-rule r table)) (g-ref g 'externals)))
    (g-set! g 'extras (ts-map (lambda (r) (intern-rule r table)) (g-ref g 'extras)))
    (g-set! g 'reserved (ts-map (lambda (set)
                                  (cons (car set)
                                        (ts-map (lambda (r) (intern-rule r table)) (cdr set))))
                                (g-ref g 'reserved)))
    (define (lookup name what)
      (or (ahash-ref table name) (ts-error "undefined symbol in" what name)))
    (let* ((inline (ts-filter (lambda (x) x)
                              (ts-map (lambda (n) (ahash-ref table n)) (g-ref g 'inline))))
           (supertypes (ts-filter (lambda (s) (not (member s inline)))
                                  (ts-map (lambda (n) (lookup n "supertypes"))
                                          (g-ref g 'supertypes)))))
      (g-set! g 'inline inline)
      (g-set! g 'supertypes supertypes)
      (g-set! g 'conflicts (ts-map (lambda (c) (ts-map (lambda (n) (lookup n "conflicts")) c))
                                   (g-ref g 'conflicts)))
      (g-set! g 'word (and (g-ref g 'word) (lookup (g-ref g 'word) "word")))
      (for-each (lambda (s)
                  (when (non-terminal? s)
                    (vector-set! (g-ref g 'kinds) (sym-index s) vt-hidden)))
                supertypes))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Extracting tokens
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; A lexical variable is a vector #(name kind root)
(define-public (lv-name v) (vector-ref v 0))
(define-public (lv-kind v) (vector-ref v 1))
(define-public (lv-root v) (vector-ref v 2))

(define (params-default? p)
  (equal? p (default-params)))

(define (extract-tokens! g)
  (let ((lexical (make-gvec))
        (counts (make-gvec))
        (memo (make-ahash-table)))
    (define (find-token root)
      (ahash-ref memo root))
    (define (extract-token root string-name var-name aux-count first?)
      (let ((found (find-token root)))
        (if found
            (begin (gvec-set! counts found (+ (gvec-ref counts found) 1)) found)
            (let ((name #f) (kind #f))
              (if string-name
                  (begin
                    (when (and (equal? string-name "") (not first?))
                      (ts-error "the rule contains an empty string" var-name))
                    (set! name string-name)
                    (set! kind vt-anonymous))
                  (begin
                    (set-car! aux-count (+ (car aux-count) 1))
                    (set! name (string-append (or var-name "") "_token"
                                              (number->string (car aux-count))))
                    (set! kind vt-auxiliary)))
              (let ((index (gvec-push! lexical (vector name kind root))))
                (gvec-push! counts 1)
                (ahash-set! memo root index)
                index)))))
    (define (extract r var-name first? aux-count)
      (case (car r)
        ((string)
         (list 'sym (terminal (extract-token r (cadr r) var-name aux-count first?))))
        ((pattern)
         (list 'sym (terminal (extract-token r #f var-name aux-count first?))))
        ((meta)
         (let ((p (cadr r)))
           (if (p-token? p)
               (let* ((cleaned (vector-copy* p))
                      (inner (caddr r))
                      (string-name (and (eq? (car inner) 'string) (cadr inner))))
                 (vector-set! cleaned 5 #f)
                 (let ((root (if (params-default? cleaned) inner r)))
                   (list 'sym (terminal (extract-token root string-name var-name
                                                       aux-count first?)))))
               (list 'meta p (extract (caddr r) var-name first? aux-count)))))
        ((seq choice)
         (cons (car r) (ts-map (lambda (c) (extract c var-name first? aux-count)) (cdr r))))
        ((repeat) (list 'repeat (extract (cadr r) var-name first? aux-count)))
        ((reserved) (list 'reserved (cadr r) (extract (caddr r) var-name first? aux-count)))
        (else r)))
    (let* ((vars (ts-map-index (lambda (i v)
                                 (cons (car v) (extract (cdr v) (car v) (= i 0) (list 0))))
                               (g-ref g 'variables)))
           (externals (ts-map2 (lambda (r info)
                                (extract r (car info) #f (list 0)))
                              (g-ref g 'externals) (g-ref g 'external-info)))
           (kinds (g-ref g 'kinds))
           (n (length vars))
           (replacements (make-vector n #f))
           (retained '())
           (new-kinds '()))
      ;; absorb the variables which are only a token used once
      (ts-map-index
       (lambda (i v)
         (let ((root (cdr v)))
           (if (and (> i 0) (eq? (car root) 'sym) (terminal? (cadr root))
                    (= (gvec-ref counts (sym-index (cadr root))) 1)
                    (let ((lv (gvec-ref lexical (sym-index (cadr root)))))
                      (or (= (lv-kind lv) vt-auxiliary)
                          (not (= (vector-ref kinds i) vt-hidden)))))
               (let* ((t (sym-index (cadr root)))
                      (lv (gvec-ref lexical t)))
                 (gvec-set! lexical t (vector (car v) (vector-ref kinds i) (lv-root lv)))
                 (vector-set! replacements i t))
               (begin
                 (set! retained (cons v retained))
                 (set! new-kinds (cons (vector-ref kinds i) new-kinds))))))
       vars)
      (let ((shift (make-vector n 0)))
        (let loop ((i 0) (removed 0))
          (when (< i n)
            (vector-set! shift i removed)
            (loop (+ i 1) (if (vector-ref replacements i) (+ removed 1) removed))))
        (define (replace s)
          (if (not (non-terminal? s)) s
              (let ((r (vector-ref replacements (sym-index s))))
                (if r (terminal r)
                    (non-terminal (- (sym-index s) (vector-ref shift (sym-index s))))))))
        (define (renumber r)
          (case (car r)
            ((sym) (list 'sym (replace (cadr r))))
            ((seq choice) (cons (car r) (ts-map renumber (cdr r))))
            ((repeat) (list 'repeat (renumber (cadr r))))
            ((meta reserved) (list (car r) (cadr r) (renumber (caddr r))))
            (else r)))
        (g-set! g 'variables (ts-map (lambda (v) (cons (car v) (renumber (cdr v))))
                                     (reverse retained)))
        (g-set! g 'kinds (list->vector (reverse new-kinds)))
        (set! externals (ts-map renumber externals))
        (g-set! g 'conflicts
                (ts-map (lambda (c) (ts-dedup (ts-sort (ts-map replace c) <)))
                        (g-ref g 'conflicts)))
        (g-set! g 'supertypes
                (ts-map (lambda (s)
                          (let ((r (replace s)))
                            (when (terminal? r)
                              (ts-error "terminal rule cannot be used as a supertype"))
                            r))
                        (g-ref g 'supertypes)))
        (g-set! g 'inline (ts-map replace (g-ref g 'inline)))
        (let ((separators '()) (extra-symbols '()))
          (for-each
           (lambda (r)
             (cond ((eq? (car r) 'sym)
                    (set! extra-symbols (cons (replace (cadr r)) extra-symbols)))
                   ((find-token r)
                    (set! extra-symbols (cons (terminal (find-token r)) extra-symbols)))
                   (else (set! separators (cons r separators)))))
           (g-ref g 'extras))
          (g-set! g 'separators (reverse separators))
          (g-set! g 'extra-symbols (reverse extra-symbols)))
        (g-set! g 'external-tokens
                (ts-map2 (lambda (r info)
                          (unless (eq? (car r) 'sym)
                            (ts-error "non-symbol rules cannot be used as external tokens"))
                          (let ((s (cadr r)))
                            (when (non-terminal? s)
                              (ts-error "rule used as external token and non-terminal"))
                            (if (external? s)
                                (vector (car info) (cdr info) #f)
                                (vector (lv-name (gvec-ref lexical (sym-index s)))
                                        (cdr info) s))))
                        externals (g-ref g 'external-info)))
        (let ((w (and (g-ref g 'word) (replace (g-ref g 'word)))))
          (when (and w (non-terminal? w))
            (ts-error "non-terminal symbol cannot be used as the word token"))
          (g-set! g 'word w))
        (g-set! g 'reserved-sets
                (ts-map (lambda (set)
                          (cons (car set)
                                (ts-map (lambda (r)
                                          (cond ((eq? (car r) 'sym) (replace (cadr r)))
                                                ((find-token r) (terminal (find-token r)))
                                                (else (ts-error "reserved word must be a token"))))
                                        (cdr set))))
                        (g-ref g 'reserved)))
        (g-set! g 'lexical-variables (gvec->list lexical))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Expanding repetitions
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; widths are pairs (nullable? . eof-nullable?)

(define (rule-width r by-variable)
  (case (car r)
    ((blank) (cons #t #f))
    ((string) (cons (equal? (cadr r) "") #f))
    ((eof) (cons #f #t))
    ((sym)
     (let ((s (cadr r)))
       (cond ((= s sym-end) (cons #f #t))
             ((non-terminal? s)
              (if (< (sym-index s) (gvec-length by-variable))
                  (gvec-ref by-variable (sym-index s))
                  (cons #f #f)))
             ((external? s) (cons #t #f))
             (else (cons #f #f)))))
    ((choice)
     (let loop ((l (cdr r)) (n #f) (e #f))
       (if (null? l) (cons n e)
           (let ((w (rule-width (car l) by-variable)))
             (loop (cdr l) (or n (car w)) (or e (cdr w)))))))
    ((seq)
     (let loop ((l (cdr r)) (n #t) (any-eof #f) (all-zero #t))
       (if (null? l) (cons n (and all-zero any-eof))
           (let ((w (rule-width (car l) by-variable)))
             (loop (cdr l) (and n (car w)) (or any-eof (cdr w))
                   (and all-zero (or (car w) (cdr w))))))))
    ((repeat) (rule-width (cadr r) by-variable))
    ((meta reserved) (rule-width (caddr r) by-variable))
    (else (cons #f #f))))

(define (wrap-in-binary-tree symbol inner)
  (let ((elements (cdr (make-choice (list (list 'seq (list 'sym symbol) (list 'sym symbol))
                                          inner)))))
    (if (null? (cdr elements)) (car elements) (cons 'choice elements))))

(define (expand-repeats! g)
  (let* ((vars (list->vector (g-ref g 'variables)))
         (n (vector-length vars))
         (kinds (vector->list (g-ref g 'kinds)))
         (by-variable (make-gvec))
         (aux '())
         (aux-count 0)
         (memo (make-ahash-table)))
    ;; the widths of the variables, as a least fixpoint
    (do ((i 0 (+ i 1))) ((= i n)) (gvec-push! by-variable (cons #f #f)))
    (let loop ()
      (let ((changed #f))
        (do ((i 0 (+ i 1))) ((= i n))
          (let* ((old (gvec-ref by-variable i))
                 (w (rule-width (cdr (vector-ref vars i)) by-variable))
                 (new (cons (or (car old) (car w)) (or (cdr old) (cdr w)))))
            (unless (equal? new old)
              (set! changed #t)
              (gvec-set! by-variable i new))))
        (when changed (loop))))
    (define (expand r var-name counter)
      (case (car r)
        ((repeat)
         (let* ((content (expand (cadr r) var-name counter))
                (width (rule-width content by-variable)))
           (when (cdr width)
             (ts-error "repetition matching the empty string at end of input" var-name))
           (let ((found (ahash-ref memo content)))
             (if found (list 'sym found)
                 (let* ((k (begin (set-car! counter (+ (car counter) 1)) (car counter)))
                        (name (string-append var-name "_repeat" (number->string k)))
                        (symbol (non-terminal (+ n aux-count))))
                   (gvec-push! by-variable width)
                   (ahash-set! memo content symbol)
                   (set! aux (cons (cons name (wrap-in-binary-tree symbol content)) aux))
                   (set! aux-count (+ aux-count 1))
                   (list 'sym symbol))))))
        ((seq choice) (cons (car r) (ts-map (lambda (c) (expand c var-name counter)) (cdr r))))
        ((meta) (list 'meta (cadr r) (expand (caddr r) var-name counter)))
        (else r)))
    (let ((kinds (list->vector kinds)))
      (do ((i 0 (+ i 1))) ((= i n))
        (let* ((v (vector-ref vars i))
               (name (car v))
               (root (cdr v))
               (counter (list 0)))
          (if (and (= (vector-ref kinds i) vt-hidden) (eq? (car root) 'repeat))
              (begin
                (when (cdr (rule-width (cadr root) by-variable))
                  (ts-error "repetition matching the empty string at end of input" name))
                (let ((content (expand (cadr root) name counter)))
                  (vector-set! vars i (cons name (wrap-in-binary-tree (non-terminal i) content)))
                  (vector-set! kinds i vt-auxiliary)
                  (g-set! g 'inline (ts-filter (lambda (s) (not (= s (non-terminal i))))
                                               (g-ref g 'inline)))))
              (vector-set! vars i (cons name (expand root name counter))))))
      (g-set! g 'variables (append (vector->list vars) (reverse aux)))
      (g-set! g 'kinds (list->vector (append (vector->list kinds)
                                             (ts-map (lambda (x) vt-auxiliary) aux)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Flattening the rules into productions
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-public (step-symbol s) (vector-ref s 0))
(define-public (step-prec s) (vector-ref s 1))
(define-public (step-assoc s) (vector-ref s 2))
(define-public (step-alias s) (vector-ref s 3))
(define-public (step-field s) (vector-ref s 4))
(define-public (step-reserved s) (vector-ref s 5))
(define-public (step-with s i x)
  (let ((r (vector-copy* s))) (vector-set! r i x) r))

(define-public (prod-steps p) (vector-ref p 0))
(define-public (prod-dynamic p) (vector-ref p 1))
(define-public (prod-eof? p) (vector-ref p 2))
(define-public (prod-length p) (vector-length (prod-steps p)))
(define-public (prod-step p i) (vector-ref (prod-steps p) i))

(define (flatten-grammar! g)
  (let* ((reserved-ids (make-ahash-table))
         (productions (make-gvec))
         (var-prods (make-gvec)))
    (ts-map-index (lambda (i set) (ahash-set! reserved-ids (car set) i))
                  (g-ref g 'reserved-sets))
    (for-each
     (lambda (v)
       (let* ((prod-start (gvec-length productions))
              (decisions (make-gvec))
              (arities (make-gvec))
              (depth 0)
              (steps (make-gvec))
              (dyn 0)
              (dead #f)
              (dropped-for-eof #f))
         (define (select len)
           (let ((sel (if (< depth (gvec-length decisions)) (gvec-ref decisions depth) 0)))
             (gvec-push! arities len)
             (set! depth (+ depth 1))
             sel))
         (define (advance!)
           (let loop ((d (- (gvec-length arities) 1)))
             (if (< d 0) #f
                 (let ((sel (if (< d (gvec-length decisions)) (gvec-ref decisions d) 0)))
                   (if (< (+ sel 1) (gvec-ref arities d))
                       (begin
                         (let truncate () (when (> (gvec-length decisions) (+ d 1))
                                            (gvec-pop! decisions) (truncate)))
                         (let pad () (when (< (gvec-length decisions) (+ d 1))
                                       (gvec-push! decisions 0) (pad)))
                         (gvec-set! decisions d (+ sel 1))
                         #t)
                       (loop (- d 1)))))))
         (define (push-step! s ctx)
           (gvec-push! steps (vector s (vector-ref ctx 0) (vector-ref ctx 1)
                                     (vector-ref ctx 2) (vector-ref ctx 3)
                                     (vector-ref ctx 4))))
         (define (apply-rule r ctx at-end)
           ;; ctx is #(prec assoc alias field reserved); returns whether a step
           ;; was pushed
           (case (car r)
             ((sym) (push-step! (cadr r) ctx) #t)
             ((seq)
              (let loop ((l (cdr r)) (pushed #f))
                (if (or (null? l) dead) pushed
                    (let ((p (apply-rule (car l) ctx (and at-end (null? (cdr l))))))
                      (loop (cdr l) (or pushed p))))))
             ((choice)
              (if (null? (cdr r))
                  (begin (set! dead #t) #f)
                  (apply-rule (list-ref (cdr r) (select (length (cdr r)))) ctx at-end)))
             ((eof) (push-step! sym-end ctx) #t)
             ((meta)
              (let* ((p (cadr r))
                     (inner (vector-copy* ctx)))
                (when (p-prec p) (vector-set! inner 0 (p-prec p)))
                (when (p-assoc p) (vector-set! inner 1 (p-assoc p)))
                (when (p-alias p) (vector-set! inner 2 (p-alias p)))
                (when (p-field p) (vector-set! inner 3 (p-field p)))
                (when (> (abs (p-dynamic p)) (abs dyn)) (set! dyn (p-dynamic p)))
                (let ((pushed (apply-rule (caddr r) inner at-end)))
                  (when (and pushed (not at-end))
                    (when (p-prec p)
                      (gvec-set! steps (- (gvec-length steps) 1)
                                 (step-with (gvec-last steps) 1 (vector-ref ctx 0))))
                    (when (p-assoc p)
                      (gvec-set! steps (- (gvec-length steps) 1)
                                 (step-with (gvec-last steps) 2 (vector-ref ctx 1)))))
                  pushed)))
             ((reserved)
              (let ((id (ahash-ref reserved-ids (cadr r))))
                (unless id (ts-error "no such reserved word set" (cadr r)))
                (let ((inner (vector-copy* ctx)))
                  (vector-set! inner 4 id)
                  (apply-rule (caddr r) inner at-end))))
             (else #f)))
         (define (emit-ready! l eof?)
           (let ((sv (list->vector l)))
             (let loop ((i prod-start))
               (cond ((= i (gvec-length productions))
                      (gvec-push! productions (vector sv dyn eof?))
                      #t)
                     ((let ((p (gvec-ref productions i)))
                        (and (= (prod-dynamic p) dyn)
                             (eq? (prod-eof? p) eof?)
                             (equal? (prod-steps p) sv)))
                      #t)
                     (else (loop (+ i 1)))))))
         (define (emit!)
           (let* ((l (gvec->list steps))
                  (pos (ts-list-index (lambda (s) (= (step-symbol s) sym-end)) l)))
             (cond ((not pos) (emit-ready! l #f))
                   ((not (= pos (- (length l) 1))) #f)
                   (else (emit-ready! (ts-take l pos) #t)))))
         (let loop ()
           (apply-rule (cdr v) (vector #f #f #f #f 0) #t)
           (unless dead
             (unless (emit!) (set! dropped-for-eof #t)))
           (when (advance!)
             (set! steps (make-gvec))
             (set! dyn 0)
             (set! dead #f)
             (set! arities (make-gvec))
             (set! depth 0)
             (loop)))
         (when (and dropped-for-eof (= prod-start (gvec-length productions)))
           (ts-error "rule has no reachable productions" (car v)))
         (gvec-push! var-prods (cons prod-start (gvec-length productions)))))
     (g-ref g 'variables))
    (g-set! g 'productions productions)
    (g-set! g 'var-prods (gvec->vector var-prods))
    (check-flattened g)))

(define (check-flattened g)
  (let ((prods (g-ref g 'productions))
        (var-prods (g-ref g 'var-prods))
        (inline (g-ref g 'inline)))
    (define (used? s)
      (let loop ((i 0))
        (and (< i (gvec-length prods))
             (or (ts-any (lambda (st) (= (step-symbol st) s))
                         (vector->list (prod-steps (gvec-ref prods i))))
                 (loop (+ i 1))))))
    (do ((i 0 (+ i 1))) ((= i (vector-length var-prods)))
      (let* ((s (non-terminal i))
             (u (used? s))
             (range (vector-ref var-prods i)))
        (do ((p (car range) (+ p 1))) ((= p (cdr range)))
          (let ((prod (gvec-ref prods p)))
            (when (and u (= (prod-length prod) 0) (not (prod-eof? prod)))
              (ts-error "the rule matches the empty string"
                        (car (list-ref (g-ref g 'variables) i))))
            (when (and (member s inline)
                       (ts-any (lambda (st) (= (step-symbol st) s))
                               (vector->list (prod-steps prod))))
              (ts-error "rule cannot be inlined because it references itself"
                        (car (list-ref (g-ref g 'variables) i))))))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Default aliases
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (extract-default-aliases! g)
  ;; a symbol which always appears with aliases gets its most frequent alias
  ;; as default alias; returns a hash table symbol -> alias
  (let ((status (make-ahash-table))   ; symbol -> #(aliases unaliased?)
        (inline (g-ref g 'inline))
        (prods (g-ref g 'productions))
        (result (make-ahash-table)))
    (define (get s)
      (or (ahash-ref status s)
          (let ((st (vector '() #f))) (ahash-set! status s st) st)))
    (gvec-for-each
     (lambda (p)
       (vector-for-each*
        (lambda (step)
          (let ((s (step-symbol step)))
            (unless (member s inline)
              (let ((st (get s)) (a (step-alias step)))
                (if a
                    (let ((h (assoc a (vector-ref st 0))))
                      (if h (set-cdr! h (+ (cdr h) 1))
                          (vector-set! st 0 (append (vector-ref st 0) (list (cons a 1))))))
                    (vector-set! st 1 #t))))))
        (prod-steps p)))
     prods)
    (for-each (lambda (s) (vector-set! (get s) 1 #t)) (g-ref g 'extra-symbols))
    (for-each
     (lambda (kv)
       (let ((st (cdr kv)))
         (if (vector-ref st 1)
             (vector-set! st 0 '())
             (when (pair? (vector-ref st 0))
               (let loop ((l (cdr (vector-ref st 0))) (best (car (vector-ref st 0))))
                 (if (null? l)
                     (begin (vector-set! st 0 (list best))
                            (ahash-set! result (car kv) (car best)))
                     (loop (cdr l) (if (> (cdar l) (cdr best)) (car l) best))))))))
     (ahash-table->list status))
    (let ((var-prods (g-ref g 'var-prods)))
      (do ((v 0 (+ v 1))) ((= v (vector-length var-prods)))
        (let* ((range (vector-ref var-prods v))
               (ps (let loop ((i (car range)) (acc '()))
                     (if (= i (cdr range)) (reverse acc)
                         (loop (+ i 1) (cons (gvec-ref prods i) acc)))))
               (to-clear '()))
          (ts-map-index
           (lambda (i p)
             (do ((j 0 (+ j 1))) ((= j (prod-length p)))
               (let* ((step (prod-step p j))
                      (st (ahash-ref status (step-symbol step)))
                      (default (and st (pair? (vector-ref st 0)) (car (car (vector-ref st 0))))))
                 (when (and (step-alias step) (equal? (step-alias step) default))
                   (unless (let loop ((k 0) (l ps))
                             (and (pair? l)
                                  (or (let ((o (car l)))
                                        (and (not (= k i))
                                             (> (prod-length o) j)
                                             (equal? (step-alias (prod-step o j)) (step-alias step))
                                             (not (equal? (ahash-ref result (step-symbol (prod-step o j)))
                                                          (step-alias step)))))
                                      (loop (+ k 1) (cdr l)))))
                     (set! to-clear (cons (cons (+ (car range) i) j) to-clear)))))))
           ps)
          (for-each (lambda (pos)
                      (let* ((p (gvec-ref prods (car pos)))
                             (steps (vector-copy* (prod-steps p))))
                        (vector-set! steps (cdr pos) (step-with (vector-ref steps (cdr pos)) 3 #f))
                        (gvec-set! prods (car pos) (vector steps (prod-dynamic p) (prod-eof? p)))))
                    to-clear))))
    (g-set! g 'default-aliases result)))

(define (vector-for-each* fun v)
  (do ((i 0 (+ i 1))) ((= i (vector-length v))) (fun (vector-ref v i))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Inlined rules
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (process-inlines! g)
  ;; a table (prod-id . step) -> list of production ids, where the inlined
  ;; symbols at that step are replaced by their productions
  (let ((inline (g-ref g 'inline))
        (prods (g-ref g 'productions))
        (var-prods (g-ref g 'var-prods))
        (map* (make-ahash-table))
        (memo (make-ahash-table)))
    (for-each (lambda (s)
                (cond ((external? s) (ts-error "external token cannot be inlined"))
                      ((terminal? s) (ts-error "token cannot be inlined"))
                      ((= s (non-terminal 0)) (ts-error "the first rule cannot be inlined"))))
              inline)
    (define (inline-at prod-id si)
      (or (ahash-ref map* (cons prod-id si))
          (let* ((src (gvec-ref prods prod-id))
                 (scratch (list (vector (vector->list (prod-steps src))
                                        (prod-dynamic src) (prod-eof? src)))))
            (define (expand sp)
              ;; the productions replacing sp, or #f if its step si is not inlined
              (let ((steps (vector-ref sp 0)))
                (and (< si (length steps))
                     (member (step-symbol (list-ref steps si)) inline)
                     (let* ((removed (list-ref steps si))
                            (range (vector-ref var-prods (sym-index (step-symbol removed)))))
                       (let loop ((i (car range)) (acc '()))
                         (if (= i (cdr range)) (reverse acc)
                             (let ((p (gvec-ref prods i)))
                               (if (and (prod-eof? p) (< (+ si 1) (length steps)))
                                   (loop (+ i 1) acc)
                                   (let* ((ins (vector->list (prod-steps p)))
                                          (ins (if (step-alias removed)
                                                   (ts-map (lambda (s) (step-with s 3 (step-alias removed))) ins)
                                                   ins))
                                          (ins (if (step-field removed)
                                                   (ts-map (lambda (s) (step-with s 4 (step-field removed))) ins)
                                                   ins))
                                          (ins (if (null? ins) ins
                                                   (let* ((r (reverse ins))
                                                          (last (car r))
                                                          (last (if (step-prec last) last
                                                                    (step-with last 1 (step-prec removed))))
                                                          (last (if (step-assoc last) last
                                                                    (step-with last 2 (step-assoc removed)))))
                                                     (reverse (cons last (cdr r))))))
                                          (new-steps (append (ts-take steps si) ins
                                                             (list-tail steps (+ si 1))))
                                          (dyn (if (> (abs (prod-dynamic p)) (abs (vector-ref sp 1)))
                                                   (prod-dynamic p) (vector-ref sp 1))))
                                     (loop (+ i 1)
                                           (cons (vector new-steps dyn
                                                         (or (vector-ref sp 2) (prod-eof? p)))
                                                 acc)))))))))))
            (let loop ((todo scratch) (done '()))
              (if (pair? todo)
                  (let ((e (expand (car todo))))
                    (if e (loop (append e (cdr todo)) done)
                        (loop (cdr todo) (cons (car todo) done))))
                  (let ((ids (ts-map (lambda (sp)
                                       (let* ((p (vector (list->vector (vector-ref sp 0))
                                                         (vector-ref sp 1) (vector-ref sp 2)))
                                              (old (ahash-ref memo p)))
                                         (or old
                                             (let ((id (gvec-push! prods p)))
                                               (ahash-set! memo p id)
                                               id))))
                                     (reverse done))))
                    (ahash-set! map* (cons prod-id si) ids)
                    ids))))))
    (when (pair? inline)
      (let ((first-inlined (gvec-length prods))
            (dead (make-ahash-table)))
        (do ((prod-id 0 (+ prod-id 1))) ((= prod-id first-inlined))
          (let ((survived #f))
            (let loop ((work (list (cons prod-id 0))))
              (when (pair? work)
                (let* ((w (car work))
                       (p (gvec-ref prods (car w))))
                  (cond ((>= (cdr w) (prod-length p))
                         (set! survived #t)
                         (loop (cdr work)))
                        ((member (step-symbol (prod-step p (cdr w))) inline)
                         (loop (append (ts-map (lambda (id) (cons id (cdr w)))
                                               (inline-at (car w) (cdr w)))
                                       (cdr work))))
                        (else (loop (cons (cons (car w) (+ (cdr w) 1)) (cdr work))))))))
            (unless survived (ahash-set! dead prod-id #t))))
        (do ((i 0 (+ i 1))) ((= i (vector-length var-prods)))
          (let ((range (vector-ref var-prods i)))
            (when (and (< (car range) (cdr range))
                       (let loop ((p (car range)))
                         (or (= p (cdr range))
                             (and (ahash-ref dead p) (loop (+ p 1))))))
              (when (= i 0)
                (ts-error "rule has no reachable productions after inlining")))))))
    (g-set! g 'inlines map*)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; The syntax grammar
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-public (prepare-syntax-grammar! g)
  ;; the steps before the expansion of the tokens (ts-nfa.scm)
  (intern-symbols! g)
  (extract-tokens! g)
  (expand-repeats! g)
  (flatten-grammar! g)
  (extract-default-aliases! g)
  (process-inlines! g)
  (g-set! g 'productions (gvec->vector (g-ref g 'productions)))
  (g-set! g 'variable-names (list->vector (map car (g-ref g 'variables))))
  (let ((sets (ts-map (lambda (set) (list->ts (cdr set))) (g-ref g 'reserved-sets))))
    (g-set! g 'reserved-word-sets (list->vector (if (null? sets) (list '()) sets))))
  g)

(define-public (g-production g id) (vector-ref (g-ref g 'productions) id))
(define-public (g-variable-count g) (vector-length (g-ref g 'variable-names)))
(define-public (g-variable-name g i) (vector-ref (g-ref g 'variable-names) i))
(define-public (g-variable-kind g i) (vector-ref (g-ref g 'kinds) i))
(define-public (g-var-prods g i) (vector-ref (g-ref g 'var-prods) i))
(define-public (g-inlined g prod-id step)
  (ahash-ref (g-ref g 'inlines) (cons prod-id step)))
