;; The tokens of the lexical grammar are compiled into one NFA (expand_tokens
;; and nfa.rs of tree-sitter). The patterns are parsed as the regex_syntax
;; crate does, into
;;
;;   (empty) (lit c ...) (class cs) (rep min max sub) (cap sub)
;;   (concat sub ...) (alt sub ...)
;;
;; with its simplifications (adjacent literals are merged, alternatives of
;; single characters become classes, common prefixes are factored out...),
;; since they decide the shape of the NFA.
;;
;; The states of the NFA are vectors
;;
;;   #(advance chars next precedence separator?)
;;   #(split a b)
;;   #(accept variable precedence)

(texmacs-module (treesit ts-nfa)
  (:use (treesit ts-base) (treesit ts-grammar) (treesit ts-unicode)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Smart constructors of regex_syntax's Hir
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (hir-lit codes) (if (null? codes) '(empty) (cons 'lit codes)))

(define (hir-class cs)
  (cond ((null? cs) (list 'class '()))
        ((and (null? (cdr cs)) (= (cdar cs) (+ (caar cs) 1))) (list 'lit (caar cs)))
        (else (list 'class cs))))

(define (hir-concat subs)
  (let loop ((subs subs) (lit #f) (acc '()))
    (define (flush acc) (if lit (cons (hir-lit (reverse lit)) acc) acc))
    (cond ((null? subs)
           (let ((new (reverse (flush acc))))
             (cond ((null? new) '(empty))
                   ((null? (cdr new)) (car new))
                   (else (cons 'concat new)))))
          ((eq? (caar subs) 'lit)
           (loop (cdr subs) (append (reverse (cdar subs)) (or lit '())) acc))
          ((eq? (caar subs) 'concat)
           (loop (append (cdar subs) (cdr subs)) lit acc))
          ((eq? (caar subs) 'empty) (loop (cdr subs) lit acc))
          (else (loop (cdr subs) #f (cons (car subs) (flush acc)))))))

(define (single-char? h) (and (eq? (car h) 'lit) (null? (cddr h))))

(define (hir-alt subs)
  (let ((new (let loop ((subs subs) (acc '()))
               (cond ((null? subs) (reverse acc))
                     ((eq? (caar subs) 'alt) (loop (cdr subs) (append (reverse (cdar subs)) acc)))
                     (else (loop (cdr subs) (cons (car subs) acc)))))))
    (cond ((null? new) (list 'class '()))
          ((null? (cdr new)) (car new))
          ((ts-every single-char? new)
           (hir-class (let loop ((l new) (cs '()))
                        (if (null? l) cs
                            (loop (cdr l) (cs-add-range cs (cadar l) (+ (cadar l) 1)))))))
          ((ts-every (lambda (h) (eq? (car h) 'class)) new)
           (hir-class (let loop ((l new) (cs '()))
                        (if (null? l) cs (loop (cdr l) (cs-add cs (cadar l)))))))
          (else (or (lift-common-prefix new) (cons 'alt new))))))

(define (lift-common-prefix hirs)
  (and (ts-every (lambda (h) (eq? (car h) 'concat)) hirs)
       (let ((len (let loop ((rest (cdr hirs)) (len (length (cdar hirs))))
                    (if (or (null? rest) (= len 0)) len
                        (loop (cdr rest)
                              (let count ((a (cdar hirs)) (b (cdar rest)) (k 0))
                                (if (and (< k len) (pair? a) (pair? b) (equal? (car a) (car b)))
                                    (count (cdr a) (cdr b) (+ k 1))
                                    k)))))))
         (and (> len 0)
              (hir-concat (append (ts-take (cdar hirs) len)
                                  (list (hir-alt (ts-map (lambda (h) (hir-concat (list-tail (cdr h) len)))
                                                         hirs)))))))))

(define (hir-max-zero? h)
  ;; can the expression only match the empty string?
  (case (car h)
    ((empty) #t)
    ((lit class) #f)
    ((rep) (or (eqv? (caddr h) 0) (hir-max-zero? (cadddr h))))
    ((cap) (hir-max-zero? (cadr h)))
    ((concat) (ts-every hir-max-zero? (cdr h)))
    ((alt) (ts-every hir-max-zero? (cdr h)))
    (else #f)))

(define (hir-rep min max sub)
  (let* ((zero (hir-max-zero? sub))
         (min (if zero (min min 1) min))
         (max (if zero (if max (min max 1) 1) max)))
    (cond ((and (= min 0) (eqv? max 0)) '(empty))
          ((and (= min 1) (eqv? max 1)) sub)
          (else (list 'rep min max sub)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Case folding
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (cs-fold cs)
  ;; add the other case of the letters (ASCII and Latin-1)
  (let loop ((l cs) (r cs))
    (if (null? l) r
        (let inner ((c (caar l)) (r r))
          (if (>= c (min (cdar l) 256)) (loop (cdr l) r)
              (inner (+ c 1)
                     (let ((o (cond ((and (>= c 65) (<= c 90)) (+ c 32))
                                    ((and (>= c 97) (<= c 122)) (- c 32))
                                    ((and (>= c 192) (<= c 222) (not (= c 215))) (+ c 32))
                                    ((and (>= c 224) (<= c 254) (not (= c 247))) (- c 32))
                                    (else #f))))
                       (if o (cs-add-range r o (+ o 1)) r))))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Parsing patterns
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (string-replace-all s from to)
  (let ((n (string-length s)) (m (string-length from)))
    (let loop ((i 0) (start 0) (acc '()))
      (cond ((> (+ i m) n)
             (apply string-append (reverse (cons (substring s start n) acc))))
            ((string=? (substring s i (+ i m)) from)
             (loop (+ i m) (+ i m) (cons to (cons (substring s start i) acc))))
            (else (loop (+ i 1) start acc))))))

(define (perl-class c)
  ;; the classes \d \s \w of the ASCII
  (case c
    ((#\d) (list (cons 48 58)))
    ((#\s) (list (cons 9 14) (cons 32 33)))
    ((#\w) (list (cons 48 58) (cons 65 91) (cons 95 96) (cons 97 123)))
    (else #f)))

(define (posix-class name)
  (cond ((equal? name "alnum") (list (cons 48 58) (cons 65 91) (cons 97 123)))
        ((equal? name "alpha") (list (cons 65 91) (cons 97 123)))
        ((equal? name "ascii") (list (cons 0 128)))
        ((equal? name "blank") (list (cons 9 10) (cons 32 33)))
        ((equal? name "cntrl") (list (cons 0 32) (cons 127 128)))
        ((equal? name "digit") (list (cons 48 58)))
        ((equal? name "graph") (list (cons 33 127)))
        ((equal? name "lower") (list (cons 97 123)))
        ((equal? name "print") (list (cons 32 127)))
        ((equal? name "punct") (list (cons 33 48) (cons 58 65) (cons 91 97) (cons 123 127)))
        ((equal? name "space") (list (cons 9 14) (cons 32 33)))
        ((equal? name "upper") (list (cons 65 91)))
        ((equal? name "word") (list (cons 48 58) (cons 65 91) (cons 95 96) (cons 97 123)))
        ((equal? name "xdigit") (list (cons 48 58) (cons 65 71) (cons 97 103)))
        (else (ts-error "unknown POSIX class" name))))

(define unicode-property-hook #f)

(define-public (set-unicode-property-hook! fun)
  ;; fun maps a property name such as "L" or "XID_Start" to a character set
  (set! unicode-property-hook fun))

(define unicode-table #f)

(define (unicode-property name)
  ;; the character set of a property such as L, Letter or XID_Start
  (unless unicode-table
    (set! unicode-table (make-ahash-table))
    (for-each (lambda (p)
                (let ((cs (let loop ((l (cdr p)) (acc '()))
                            (if (null? l) (reverse acc)
                                (loop (cddr l) (cons (cons (car l) (cadr l)) acc))))))
                  (for-each (lambda (n) (ahash-set! unicode-table n cs)) (car p))))
              ts-unicode-properties))
  (let ((key (let* ((eq (ts-list-index (lambda (c) (char=? c #\=)) (string->list name))))
               (if eq (substring name (+ eq 1) (string-length name)) name))))
    (or (and unicode-property-hook (unicode-property-hook key))
        (ahash-ref unicode-table key)
        (ts-error "unsupported Unicode property" name))))

(define-public (parse-pattern str case-insensitive?)
  ;; the Hir of a pattern
  (let* ((codes (list->vector (utf8->codes str)))
         (n (vector-length codes))
         (i 0)
         (fold? case-insensitive?))
    (define (peek) (if (< i n) (vector-ref codes i) -1))
    (define (peek-char) (let ((c (peek))) (if (< c 0) #\nul (integer->char (min c 127)))))
    (define (at? c) (= (peek) (char->integer c)))
    (define (next!) (let ((c (peek))) (set! i (+ i 1)) c))
    (define (fail msg) (ts-error msg str))
    (define (hex-value c)
      (cond ((and (>= c 48) (<= c 57)) (- c 48))
            ((and (>= c 97) (<= c 102)) (- c 87))
            ((and (>= c 65) (<= c 70)) (- c 55))
            (else #f)))
    (define (read-hex count)
      ;; count digits, or digits in braces when count is #f
      (if (at? #\{)
          (begin (next!)
                 (let loop ((v 0))
                   (if (at? #\}) (begin (next!) v)
                       (loop (+ (* v 16) (or (hex-value (next!)) (fail "bad hex escape")))))))
          (let loop ((k 0) (v 0))
            (if (= k count) v
                (loop (+ k 1) (+ (* v 16) (or (hex-value (next!)) (fail "bad hex escape"))))))))
    (define (read-name)
      ;; {Name} or a single letter, for \p
      (if (at? #\{)
          (begin (next!)
                 (let loop ((acc '()))
                   (if (at? #\}) (begin (next!) (codes->utf8 (reverse acc)))
                       (loop (cons (next!) acc)))))
          (codes->utf8 (list (next!)))))
    (define (escape)
      ;; after a backslash: a code point, or a character set as (cs . set)
      (let ((c (next!)))
        (case (integer->char (min c 127))
          ((#\n) 10) ((#\t) 9) ((#\r) 13) ((#\f) 12) ((#\v) 11) ((#\a) 7)
          ((#\0) 0)
          ((#\x) (read-hex 2))
          ((#\u) (read-hex 4))
          ((#\U) (read-hex 8))
          ((#\d #\s #\w) (cons 'cs (perl-class (integer->char c))))
          ((#\D #\S #\W) (cons 'cs (cs-negate (perl-class (char-downcase (integer->char c))))))
          ((#\p) (cons 'cs (unicode-property (read-name))))
          ((#\P) (cons 'cs (cs-negate (unicode-property (read-name)))))
          ((#\b #\B #\A #\z) (fail "assertions are not supported"))
          (else c))))
    (define (leaf-set x)
      (if (pair? x) (cdr x) (cs-char x)))
    (define (fold-set cs) (if fold? (cs-fold cs) cs))
    (define (parse-class)
      ;; after [
      (let ((negated (and (at? #\^) (begin (next!) #t))))
        (let loop ((cs '()) (first #t))
          (cond ((>= i n) (fail "unclosed class"))
                ((and (at? #\]) (not first))
                 (next!)
                 (if negated (cs-negate cs) cs))
                ((and (at? #\[) (< (+ i 1) n) (= (vector-ref codes (+ i 1)) 58))
                 ;; [:name:]
                 (set! i (+ i 2))
                 (let* ((neg (and (at? #\^) (begin (next!) #t)))
                        (name (let rd ((acc '()))
                                (if (at? #\:) (begin (next!) (next!) (codes->utf8 (reverse acc)))
                                    (rd (cons (next!) acc)))))
                        (set (fold-set (posix-class name))))
                   (loop (cs-add cs (if neg (cs-negate set) set)) #f)))
                ((at? #\[)
                 (next!)
                 (loop (cs-add cs (parse-class)) #f))
                (else
                 (let ((start (if (at? #\\) (begin (next!) (escape)) (next!))))
                   (if (and (not (pair? start)) (at? #\-)
                            (< (+ i 1) n) (not (= (vector-ref codes (+ i 1)) 93)))
                       (begin
                         (next!)
                         (let ((end (if (at? #\\) (begin (next!) (escape)) (next!))))
                           (when (pair? end) (fail "bad range in class"))
                           (loop (cs-add cs (fold-set (list (cons start (+ end 1))))) #f)))
                       (loop (cs-add cs (fold-set (leaf-set start))) #f))))))))
    (define (parse-alt)
      (let loop ((branches '()))
        (let ((b (parse-concat)))
          (if (at? #\|)
              (begin (next!) (loop (cons b branches)))
              (hir-alt (reverse (cons b branches)))))))
    (define (parse-concat)
      (let loop ((items '()))
        (if (or (>= i n) (at? #\|) (at? #\)))
            (hir-concat (reverse items))
            (let ((atom (parse-atom)))
              (if (eq? atom 'flags) (loop items)
                  (loop (cons (parse-repetition atom) items)))))))
    (define (parse-repetition atom)
      (define (lazy!) (when (at? #\?) (next!)))
      (cond ((at? #\*) (next!) (lazy!) (parse-repetition (hir-rep 0 #f atom)))
            ((at? #\+) (next!) (lazy!) (parse-repetition (hir-rep 1 #f atom)))
            ((at? #\?) (next!) (lazy!) (parse-repetition (hir-rep 0 1 atom)))
            ((and (at? #\{) (< (+ i 1) n)
                  (let ((c (vector-ref codes (+ i 1)))) (and (>= c 48) (<= c 57))))
             (next!)
             (let* ((read-int (lambda ()
                                (let rd ((v 0))
                                  (let ((c (peek)))
                                    (if (and (>= c 48) (<= c 57))
                                        (begin (next!) (rd (+ (* v 10) (- c 48))))
                                        v)))))
                    (lo (read-int))
                    (hi (if (at? #\,)
                            (begin (next!) (if (at? #\}) #f (read-int)))
                            lo)))
               (unless (at? #\}) (fail "bad repetition"))
               (next!)
               (lazy!)
               (parse-repetition (hir-rep lo hi atom))))
            (else atom)))
    (define (parse-flags)
      ;; after (? : the flags, then : or )
      (let loop ((neg #f))
        (let ((c (next!)))
          (case (integer->char (min c 127))
            ((#\-) (loop #t))
            ((#\i) (set! fold? (not neg)) (loop neg))
            ((#\u #\s #\m #\x #\U) (loop neg))
            ((#\:) 'group)
            ((#\)) 'flags)
            (else (fail "unsupported group"))))))
    (define (parse-atom)
      (let ((c (next!)))
        (case (integer->char (min c 127))
          ((#\()
           (cond ((at? #\?)
                  (next!)
                  (cond ((or (at? #\P) (at? #\<))
                         (let skip () (unless (at? #\>) (next!) (skip)))
                         (next!)
                         (let ((sub (parse-alt)))
                           (next!)
                           (list 'cap sub)))
                        (else
                         (let* ((outer fold?)
                                (kind (parse-flags)))
                           (if (eq? kind 'flags) 'flags
                               (let ((sub (parse-alt)))
                                 (next!)
                                 (set! fold? outer)
                                 sub))))))
                 (else
                  (let* ((outer fold?)
                         (sub (parse-alt)))
                    (unless (at? #\)) (fail "unclosed group"))
                    (next!)
                    (set! fold? outer)
                    (list 'cap sub)))))
          ((#\[) (hir-class (parse-class)))
          ((#\.) (hir-class (list (cons 0 10) (cons 11 cs-end))))
          ((#\^ #\$) (fail "assertions are not supported"))
          ((#\\)
           (let ((e (escape)))
             (if (pair? e) (hir-class (fold-set (cdr e)))
                 (if fold? (hir-class (cs-fold (cs-char e))) (list 'lit e)))))
          (else
           (if fold? (hir-class (cs-fold (cs-char c))) (list 'lit c))))))
    (let ((h (parse-alt)))
      (when (< i n) (fail "unexpected )"))
      h)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Building the NFA
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-public (nfa-advance? s) (eq? (vector-ref s 0) 'advance))
(define-public (nfa-split? s) (eq? (vector-ref s 0) 'split))
(define-public (nfa-accept? s) (eq? (vector-ref s 0) 'accept))

(define (implicit-precedence r)
  (let loop ((r r) (boost 0))
    (case (car r)
      ((string) (+ 2 boost))
      ((meta) (loop (caddr r) (if (p-main? (cadr r)) (+ boost 1) boost)))
      (else boost))))

(define (completion-precedence r)
  (if (and (eq? (car r) 'meta) (integer? (p-prec (cadr r)))) (p-prec (cadr r)) 0))

(define (matches-empty? r)
  (case (car r)
    ((string) (equal? (cadr r) ""))
    ((meta reserved) (matches-empty? (caddr r)))
    ((repeat) (matches-empty? (cadr r)))
    ((choice) (ts-any matches-empty? (cdr r)))
    ((seq) (ts-every matches-empty? (cdr r)))
    (else #f)))

(define-public (expand-tokens! g)
  ;; the lexical grammar: an NFA and, for each token, a vector
  ;; #(name kind implicit-precedence start-state)
  (let ((states (make-gvec))
        (is-sep #t)
        (prec-stack (list 0)))
    (define (last-id) (- (gvec-length states) 1))
    (define (push-advance! chars next)
      (gvec-push! states (vector 'advance chars next (car prec-stack) is-sep)))
    (define (push-split! next)
      (gvec-push! states (vector 'split next (last-id))))
    (define (push-alternatives! ids)
      (let* ((ids (ts-dedup (ts-sort ids <)))
             (ids (ts-filter (lambda (x) (not (= x (last-id)))) ids)))
        (for-each push-split! ids)))
    (define (expand-rule r next)
      (case (car r)
        ((pattern)
         (let* ((s (cadr r))
                (s (string-replace-all s "\\w" "[0-9A-Za-z_]"))
                (s (string-replace-all s "\\s" "[\\t-\\r ]"))
                (s (string-replace-all s "\\d" "[0-9]"))
                (s (string-replace-all s "\\W" "[^0-9A-Za-z_]"))
                (s (string-replace-all s "\\S" "[^\\t-\\r ]"))
                (s (string-replace-all s "\\D" "[^0-9]")))
           (expand-regex (parse-pattern s (equal? (caddr r) "i")) next)))
        ((string)
         (let loop ((l (reverse (utf8->codes (cadr r)))) (next next))
           (if (null? l) (not (equal? (cadr r) ""))
               (begin (push-advance! (cs-char (car l)) next)
                      (loop (cdr l) (last-id))))))
        ((choice)
         (let loop ((l (cdr r)) (ids '()) (did #f))
           (if (null? l)
               (begin (push-alternatives! ids) did)
               (if (expand-rule (car l) next)
                   (loop (cdr l) (cons (last-id) ids) #t)
                   (loop (cdr l) (cons next ids) did)))))
        ((seq)
         (let loop ((l (reverse (cdr r))) (next next) (result #f))
           (if (null? l) result
               (let ((did (expand-rule (car l) next)))
                 (loop (cdr l) (last-id) (or result did))))))
        ((repeat)
         (gvec-push! states (vector 'accept 0 0))
         (let ((split-id (last-id)))
           (if (expand-rule (cadr r) split-id)
               (begin (gvec-set! states split-id (vector 'split (last-id) next)) #t)
               (begin (gvec-pop! states) #f))))
        ((meta)
         (let ((p (p-prec (cadr r))))
           (if (integer? p)
               (begin
                 (set! prec-stack (cons p prec-stack))
                 (let ((result (expand-rule (caddr r) next)))
                   (set! prec-stack (cdr prec-stack))
                   result))
               (expand-rule (caddr r) next))))
        ((blank) #f)
        ((eof) (ts-error "eof() cannot be used inside a token"))
        (else (ts-error "unexpected rule in a token" r))))
    (define (expand-regex h next)
      (case (car h)
        ((empty) #f)
        ((lit)
         (let loop ((l (reverse (cdr h))) (next next))
           (if (null? l) #t
               (begin (push-advance! (cs-char (car l)) next)
                      (loop (cdr l) (last-id))))))
        ((class) (push-advance! (cadr h) next) #t)
        ((rep)
         (let ((min (cadr h)) (max (caddr h)) (sub (cadddr h)))
           (cond ((and (= min 0) (eqv? max 1)) (expand-zero-or-one sub next))
                 ((and (= min 1) (not max)) (expand-one-or-more sub next))
                 ((and (= min 0) (not max)) (expand-zero-or-more sub next))
                 ((eqv? min max) (expand-count sub min next))
                 ((not max)
                  (if (expand-zero-or-more sub next)
                      (expand-count sub min next)
                      #f))
                 (else
                  (let loop ((k min)
                             (result (expand-count sub min next))
                             (next next))
                    (if (= k max) result
                        (let* ((next (if result (last-id) next))
                               (did (expand-zero-or-one sub next)))
                          (loop (+ k 1) (or result did) next))))))))
        ((cap) (expand-regex (cadr h) next))
        ((concat)
         (let loop ((l (reverse (cdr h))) (next next) (result #f))
           (if (null? l) result
               (if (expand-regex (car l) next)
                   (loop (cdr l) (last-id) #t)
                   (loop (cdr l) next result)))))
        ((alt)
         (let loop ((l (cdr h)) (ids '()))
           (if (null? l)
               (begin (push-alternatives! ids) #t)
               (if (expand-regex (car l) next)
                   (loop (cdr l) (cons (last-id) ids))
                   (loop (cdr l) (cons next ids))))))
        (else (ts-error "unexpected regex" h))))
    (define (expand-one-or-more sub next)
      (gvec-push! states (vector 'accept 0 0))
      (let ((split-id (last-id)))
        (if (expand-regex sub split-id)
            (begin (gvec-set! states split-id (vector 'split (last-id) next)) #t)
            (begin (gvec-pop! states) #f))))
    (define (expand-zero-or-one sub next)
      (and (expand-regex sub next)
           (begin (push-split! next) #t)))
    (define (expand-zero-or-more sub next)
      (and (expand-one-or-more sub next)
           (begin (push-split! next) #t)))
    (define (expand-count sub count next)
      (let loop ((k 0) (next next) (result #f))
        (if (= k count) result
            (if (expand-regex sub next)
                (loop (+ k 1) (last-id) #t)
                (loop (+ k 1) next result)))))
    (let* ((separators (g-ref g 'separators))
           (separator (if (null? separators) '(blank)
                          (list 'repeat (make-choice (cons '(blank) separators)))))
           (variables
            (ts-map-index
             (lambda (i lv)
               (let ((root (lv-root lv)))
                 (when (matches-empty? root)
                   (ts-error "the rule matches the empty string" (lv-name lv)))
                 (set! is-sep #f)
                 (gvec-push! states (vector 'accept i (completion-precedence root)))
                 (expand-rule root (last-id))
                 (unless (and (eq? (car root) 'meta) (p-main? (cadr root)))
                   (set! is-sep #t)
                   (expand-rule separator (last-id)))
                 (vector (lv-name lv) (lv-kind lv) (implicit-precedence root) (last-id))))
             (g-ref g 'lexical-variables))))
      (g-set! g 'nfa (gvec->vector states))
      (g-set! g 'lexical (list->vector variables))
      g)))

(define-public (lex-name v) (vector-ref v 0))
(define-public (lex-kind v) (vector-ref v 1))
(define-public (lex-implicit-precedence v) (vector-ref v 2))
(define-public (lex-start-state v) (vector-ref v 3))

(define-public (variable-index-for-nfa-state lexical state)
  ;; the first token whose start state is not before state
  (let loop ((lo 0) (hi (vector-length lexical)))
    (if (>= lo hi) lo
        (let ((mid (quotient (+ lo hi) 2)))
          (if (< (lex-start-state (vector-ref lexical mid)) state)
              (loop (+ mid 1) hi)
              (loop lo mid))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; NFA cursors
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-public (nfa-closure nfa ids)
  ;; the sorted states reached from ids through the splits, without the splits
  (let ((seen (make-ahash-table)))
    (let loop ((todo ids) (acc '()))
      (cond ((null? todo) (ts-sort acc <))
            ((ahash-ref seen (car todo)) (loop (cdr todo) acc))
            (else
             (ahash-set! seen (car todo) #t)
             (let ((s (vector-ref nfa (car todo))))
               (if (nfa-split? s)
                   (loop (cons (vector-ref s 1) (cons (vector-ref s 2) (cdr todo))) acc)
                   (loop (cdr todo) (cons (car todo) acc)))))))))

(define-public (nfa-completions nfa ids)
  ;; the accepted tokens, as pairs (variable . precedence)
  (let loop ((l ids) (acc '()))
    (if (null? l) (reverse acc)
        (let ((s (vector-ref nfa (car l))))
          (loop (cdr l)
                (if (nfa-accept? s) (cons (cons (vector-ref s 1) (vector-ref s 2)) acc) acc))))))

(define-public (nfa-raw-transitions nfa ids)
  ;; list of #(chars separator? precedence next)
  (let loop ((l ids) (acc '()))
    (if (null? l) (reverse acc)
        (let ((s (vector-ref nfa (car l))))
          (loop (cdr l)
                (if (nfa-advance? s)
                    (cons (vector (vector-ref s 1) (vector-ref s 4) (vector-ref s 3)
                                  (vector-ref s 2))
                          acc)
                    acc))))))

(define-public (nfa-any-separator? nfa ids)
  (ts-any (lambda (t) (vector-ref t 1)) (nfa-raw-transitions nfa ids)))

;; a transition is a vector #(chars separator? precedence states)
(define-public (tr-chars t) (vector-ref t 0))
(define-public (tr-sep? t) (vector-ref t 1))
(define-public (tr-prec t) (vector-ref t 2))
(define-public (tr-states t) (vector-ref t 3))

(define-public (nfa-transitions nfa ids)
  ;; the transitions grouped by disjoint character sets, sorted
  (let ((result (make-gvec)))
    (for-each
     (lambda (raw)
       (let ((chars (vector-ref raw 0))
             (sep (vector-ref raw 1))
             (prec (vector-ref raw 2))
             (state (vector-ref raw 3)))
         (let loop ((i 0))
           (when (and (< i (gvec-length result)) (pair? chars))
             (let* ((t (gvec-ref result i))
                    (inter (cs-intersect (tr-chars t) chars)))
               (when (pair? inter)
                 (let ((rest (cs-difference (tr-chars t) inter))
                       (new (vector inter (and (tr-sep? t) sep) (max (tr-prec t) prec)
                                    (ts-insert state (tr-states t)))))
                   (set! chars (cs-difference chars inter))
                   (if (null? rest)
                       (gvec-set! result i new)
                       (begin
                         (gvec-set! result i (vector rest (tr-sep? t) (tr-prec t) (tr-states t)))
                         (gvec-push! result new))))))
             (loop (+ i 1))))
         (when (pair? chars)
           (gvec-push! result (vector chars sep prec (list state))))))
     (nfa-raw-transitions nfa ids))
    ;; merge the transitions which lead to the same states
    (let loop ((l (gvec->list result)) (acc '()))
      (if (pair? l)
          (let* ((t (car l))
                 (same (ts-list-index (lambda (u) (and (equal? (tr-states u) (tr-states t))
                                                       (eq? (tr-sep? u) (tr-sep? t))
                                                       (= (tr-prec u) (tr-prec t))))
                                      acc)))
            (if same
                (let ((u (list-ref acc same)))
                  (loop (cdr l)
                        (let replace ((a acc) (k 0))
                          (if (= k same)
                              (cons (vector (cs-add (tr-chars u) (tr-chars t)) (tr-sep? u)
                                            (tr-prec u) (tr-states u))
                                    (cdr a))
                              (cons (car a) (replace (cdr a) (+ k 1)))))))
                (loop (cdr l) (append acc (list t)))))
          (ts-sort acc (lambda (a b) (< (cs-compare (tr-chars a) (tr-chars b)) 0)))))))
