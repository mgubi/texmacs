;; The second half of build_tables in tree-sitter: the conflicts between the
;; tokens (token_conflicts.rs), the keywords, the error recovery state, the
;; merging of compatible parse states (minimize_parse_table.rs) and the lex
;; tables, which are DFAs (build_lex_table.rs).
;;
;; A lex state is a vector #(accept eof-action advance-actions) where accept
;; is #f or a symbol, eof-action #f or (state . in-main-token?) and the
;; advance actions a list of (chars state . in-main-token?).

(texmacs-module (treesit ts-build)
  (:use (treesit ts-base) (treesit ts-grammar) (treesit ts-nfa) (treesit ts-tables)
        (treesit ts-native)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Tokens which may follow each other
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (following-tokens g b)
  (let* ((n (vector-length (g-ref g 'lexical)))
         (result (make-vector n '()))
         (all (ts-map terminal (ts-iota n))))
    (vector-for-each**
     (lambda (p)
       (do ((i 1 (+ i 1))) ((>= i (prod-length p)))
         (let ((left (last-set b (step-symbol (prod-step p (- i 1)))))
               (right (ts-terminals (first-set b (step-symbol (prod-step p i)))))
               (reserved (vector-ref (g-ref g 'reserved-word-sets)
                                     (reserved-first b (step-symbol (prod-step p i))))))
           (for-each (lambda (t)
                       (when (terminal? t)
                         (let ((k (sym-index t)))
                           (vector-set! result k (ts-union (vector-ref result k) right))
                           (vector-set! result k (ts-union (vector-ref result k)
                                                           (ts-terminals reserved))))))
                     left))))
     (g-ref g 'productions))
    (for-each (lambda (extra)
                (when (terminal? extra)
                  (do ((k 0 (+ k 1))) ((= k n))
                    (vector-set! result k (ts-insert extra (vector-ref result k))))
                  (vector-set! result (sym-index extra) all)))
              (g-ref g 'extra-symbols))
    result))

(define (vector-for-each** fun v)
  (do ((i 0 (+ i 1))) ((= i (vector-length v))) (fun (vector-ref v i))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Token conflicts
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define matches-prefix 1)
(define does-match-continuation 2)
(define does-match-valid-continuation 4)
(define does-match-separators 8)
(define matches-same-string 16)
(define matches-different-string 32)

(define (status-has? x bits) (not (= (logand x bits) 0)))

(define-public (prefer-token? lexical left right)
  ;; left and right are pairs (precedence . token)
  (cond ((< (car left) (car right)) #f)
        ((> (car left) (car right)) #t)
        (else
         (let ((l (lex-implicit-precedence (vector-ref lexical (cdr left))))
               (r (lex-implicit-precedence (vector-ref lexical (cdr right)))))
           (cond ((< l r) #f)
                 ((> l r) #t)
                 (else (< (cdr left) (cdr right))))))))

(define-public (prefer-transition? lexical t completed-id completed-prec has-sep)
  (cond ((< (tr-prec t) completed-prec) #f)
        ((= (tr-prec t) completed-prec)
         (not (or (tr-sep? t)
                  (and has-sep
                       (not (ts-any (lambda (s) (= (variable-index-for-nfa-state lexical s)
                                                   completed-id))
                                    (tr-states t)))))))
        (else #t)))

(define (make-token-conflict-map g following)
  (let* ((nfa (g-ref g 'nfa))
         (lexical (g-ref g 'lexical))
         (n (vector-length lexical))
         (var-of (let ((v (make-vector (vector-length nfa) 0)))
                   (do ((s 0 (+ s 1))) ((= s (vector-length nfa)) v)
                     (vector-set! v s (variable-index-for-nfa-state lexical s)))))
         (starting (ts-map (lambda (lv)
                             (let loop ((l (nfa-raw-transitions
                                            nfa (nfa-closure nfa (list (lex-start-state lv)))))
                                        (cs '()))
                               (if (null? l) cs (loop (cdr l) (cs-add cs (vector-ref (car l) 0))))))
                           (vector->list lexical)))
         (starting (list->vector starting))
         (following-chars
          (list->vector
           (ts-map (lambda (set)
                     (let loop ((l set) (cs '()))
                       (cond ((null? l) cs)
                             ((terminal? (car l))
                              (loop (cdr l) (cs-add cs (vector-ref starting (sym-index (car l))))))
                             (else (loop (cdr l) cs)))))
                   (vector->list following))))
         (matrix (make-vector (* n n) 0)))
    (define (status-pair i j)
      (let ((visited (make-ahash-table))
            (r0 0) (r1 0))
        (define (mark! who bit)
          (if (= who i) (set! r0 (logior r0 bit)) (set! r1 (logior r1 bit))))
        (let loop ((queue (list (list (lex-start-state (vector-ref lexical i))
                                      (lex-start-state (vector-ref lexical j))))))
          (when (pair? queue)
            (let* ((state-set (car queue))
                   (queue (cdr queue))
                   (first-live (vector-ref var-of (car state-set))))
              (if (ts-every (lambda (s) (= (vector-ref var-of s) first-live)) state-set)
                  (begin
                    (mark! (if (= first-live i) i j) matches-different-string)
                    (loop queue))
                  (let* ((ids (nfa-closure nfa state-set))
                         (within-sep 'unknown)
                         (completion #f))
                    (for-each
                     (lambda (c)
                       (let ((id (car c)) (prec (cdr c)))
                         (when (eq? within-sep 'unknown)
                           (set! within-sep (nfa-any-separator? nfa ids)))
                         (when within-sep (mark! (if (= id i) i j) does-match-separators))
                         (if completion
                             (unless (= id (car completion))
                               (let ((preferred
                                      (if (prefer-token? lexical (cons (cdr completion) (car completion))
                                                         (cons prec id))
                                          (car completion)
                                          (begin (set! completion (cons id prec)) id))))
                                 (mark! (if (= preferred i) i j) matches-same-string)))
                             (set! completion (cons id prec)))))
                     (nfa-completions nfa ids))
                    (for-each
                     (lambda (t)
                       (when completion
                         (let* ((completed-id (car completion))
                                (result (let scan ((l (tr-states t)) (prev #f) (advanced #f))
                                          (cond ((null? l) (cons advanced #f))
                                                (else
                                                 (let ((v (vector-ref var-of (car l))))
                                                   (cond ((eqv? v prev) (scan (cdr l) prev advanced))
                                                         ((= v completed-id) (cons advanced #t))
                                                         (else (scan (cdr l) v v))))))))
                                (advanced (car result)))
                           (when (and advanced (not (cdr result)))
                             (if (prefer-transition? lexical t completed-id (cdr completion)
                                                     (eq? within-sep #t))
                                 (if (= advanced i)
                                     (begin
                                       (mark! i does-match-continuation)
                                       (when (cs-does-intersect? (tr-chars t)
                                                                 (vector-ref following-chars j))
                                         (mark! i does-match-valid-continuation)))
                                     (begin
                                       (mark! j does-match-continuation)
                                       (when (cs-does-intersect? (tr-chars t)
                                                                 (vector-ref following-chars i))
                                         (mark! j does-match-valid-continuation))))
                                 (mark! (if (= completed-id i) i j) matches-prefix)))))
                       (unless (ahash-ref visited (tr-states t))
                         (ahash-set! visited (tr-states t) #t)
                         (set! queue (cons (tr-states t) queue))))
                     (nfa-transitions nfa ids))
                    (loop queue))))))
        (cons r0 r1)))
    (do ((i 0 (+ i 1))) ((= i n))
      (do ((j 0 (+ j 1))) ((= j i))
        (let ((s (status-pair i j)))
          (vector-set! matrix (+ (* n i) j) (car s))
          (vector-set! matrix (+ (* n j) i) (cdr s)))))
    (vector n matrix)))

(define (tc-status tc i j) (vector-ref (vector-ref tc 1) (+ (* (vector-ref tc 0) i) j)))

(define-public (does-conflict? tc i j)
  (status-has? (tc-status tc i j)
               (logior does-match-valid-continuation does-match-separators matches-same-string)))
(define (does-match-prefix? tc i j) (status-has? (tc-status tc i j) matches-prefix))
(define (does-match-shorter-or-longer? tc i j)
  (and (status-has? (tc-status tc i j)
                    (logior does-match-valid-continuation does-match-separators))
       (not (status-has? (tc-status tc j i) does-match-separators))))
(define-public (does-overlap? tc i j)
  (status-has? (tc-status tc i j)
               (logior does-match-separators matches-prefix matches-same-string
                       does-match-continuation)))
(define (does-match-same-string? tc i j) (status-has? (tc-status tc i j) matches-same-string))
(define (does-match-different-string? tc i j)
  (status-has? (tc-status tc i j) matches-different-string))
(define (has-same-conflict-status? tc a b other)
  (= (tc-status tc a other) (tc-status tc b other)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Tokens which are valid in the same states
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (make-coincident-index g states)
  ;; #(n contains without-word): vectors of booleans indexed by a * n + b
  (let* ((n (vector-length (g-ref g 'lexical)))
         (contains (make-vector (* n n) #f))
         (without-word (make-vector (* n n) #f))
         (word (g-ref g 'word)))
    (gvec-for-each
     (lambda (state)
       (let* ((ts (ts-map sym-index (ts-filter terminal? (om-keys (state-terminals state)))))
              (has-word (and word (om-has? (state-terminals state) word))))
         (let loop ((l ts))
           (when (pair? l)
             (let ((a (car l)))
               (for-each (lambda (b)
                           (vector-set! contains (+ (* a n) b) #t)
                           (vector-set! contains (+ (* b n) a) #t)
                           (unless has-word
                             (vector-set! without-word (+ (* a n) b) #t)
                             (vector-set! without-word (+ (* b n) a) #t)))
                         l))
             (loop (cdr l))))))
     states)
    (vector n contains without-word)))

(define (coincident? ci a b)
  (vector-ref (vector-ref ci 1) (+ (* (vector-ref ci 0) a) b)))
(define (all-coincident-states-have-word? ci a b)
  (not (vector-ref (vector-ref ci 2) (+ (* (vector-ref ci 0) a) b))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Keywords
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (alphabetic-range? start end)
  (let loop ((c start))
    (or (>= c end)
        (and (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122)) (= c 95)
                 (and (>= c 192) (< end 196608) (not (= c 215)) (not (= c 247))))
             (loop (if (>= c 192) end (+ c 1)))))))

(define (identify-keywords g tc ci)
  (let* ((word (g-ref g 'word))
         (nfa (g-ref g 'nfa))
         (lexical (g-ref g 'lexical))
         (n (vector-length lexical)))
    (if (not (and word (terminal? word))) '()
        (let* ((w (sym-index word))
               (candidates
                (ts-filter
                 (lambda (i)
                   (and (ts-every (lambda (raw)
                                    (or (vector-ref raw 1)
                                        (ts-every (lambda (r) (alphabetic-range? (car r) (cdr r)))
                                                  (vector-ref raw 0))))
                                  (nfa-raw-transitions
                                   nfa (nfa-closure nfa (list (lex-start-state (vector-ref lexical i))))))
                        (does-match-same-string? tc i w)
                        (not (does-match-different-string? tc i w))))
                 (ts-iota n)))
               (keywords (ts-filter (lambda (i)
                                      (not (ts-any (lambda (o) (and (not (= o i))
                                                                    (does-match-same-string? tc o i)))
                                                   candidates)))
                                    candidates)))
          (ts-map terminal
                  (ts-filter
                   (lambda (i)
                     (ts-every (lambda (o)
                                 (or (member o candidates)
                                     (all-coincident-states-have-word? ci i o)
                                     (has-same-conflict-status? tc i w o)))
                               (ts-iota n)))
                   keywords))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; The error state and the symbols
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (populate-error-state! g states tc ci keywords)
  (let* ((state (gvec-ref states 0))
         (n (vector-length (g-ref g 'lexical)))
         (word (g-ref g 'word))
         (conflict-free
          (ts-filter (lambda (i)
                       (not (ts-any (lambda (j)
                                      (and (not (= j i))
                                           (not (coincident? ci i j))
                                           (does-match-shorter-or-longer? tc i j)))
                                    (ts-iota n))))
                     (ts-iota n))))
    (define (recover!) (vector (list (list 'recover)) #f))
    (do ((i 0 (+ i 1))) ((= i n))
      (let ((s (terminal i)))
        (unless (and (not (member i conflict-free))
                     (not (member s keywords))
                     (not (eqv? word s))
                     (ts-any (lambda (t) (and (not (coincident? ci i t))
                                              (does-conflict? tc i t)))
                             conflict-free))
          (unless (om-has? (state-terminals state) s)
            (om-set! (state-terminals state) s (recover!))))))
    (ts-map-index (lambda (i ext)
                    (unless (vector-ref ext 2)
                      (unless (om-has? (state-terminals state) (external i))
                        (om-set! (state-terminals state) (external i) (recover!)))))
                  (g-ref g 'external-tokens))
    (om-set! (state-terminals state) sym-end (recover!))))

(define (used-symbols g states)
  (let ((used (make-ahash-table)))
    (gvec-for-each (lambda (state)
                     (for-each (lambda (s) (ahash-set! used s #t)) (om-keys (state-terminals state)))
                     (for-each (lambda (s) (ahash-set! used s #t)) (om-keys (state-nonterminals state))))
                   states)
    (let* ((word (g-ref g 'word))
           (terms (ts-filter (lambda (s) (ahash-ref used s))
                             (ts-map terminal (ts-iota (vector-length (g-ref g 'lexical))))))
           (terms (if (and word (member word terms))
                      (cons word (ts-filter (lambda (s) (not (= s word))) terms))
                      terms)))
      (append (list sym-end) terms
              (ts-filter (lambda (s) (ahash-ref used s))
                         (ts-map external (ts-iota (length (g-ref g 'external-tokens)))))
              (ts-filter (lambda (s) (ahash-ref used s))
                         (ts-map non-terminal (ts-iota (g-variable-count g))))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Merging compatible states
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (split-state-id-groups! states groups group-of start should-split?
                                dirty preds)
  ;; groups is a gvec of lists of state ids, group-of a vector. With dirty
  ;; (else #f)
  ;; (a gvec of booleans by group) and preds (the states whose successors
  ;; include each state), only the dirty groups are examined: those created
  ;; since their last examination or with a member whose successor changed
  ;; group since then; the others would not split.
  (let ((result #f)
        (is-split (make-vector (vector-length group-of) #f)))
    (do ((gid start (+ gid 1))) ((>= gid (gvec-length groups)))
     (when (or (not dirty) (gvec-ref dirty gid))
      (when dirty (gvec-set! dirty gid #f))
      (let* ((ids (gvec-ref groups gid))
             (split '()))
        (let loop ((l ids))
          (when (pair? l)
            (unless (vector-ref is-split (car l))
              (let ((left (gvec-ref states (car l))))
                (for-each (lambda (r)
                            (unless (vector-ref is-split r)
                              (when (should-split? left (gvec-ref states r) group-of)
                                (set! split (cons r split))
                                (vector-set! is-split r #t))))
                          (cdr l))))
            (loop (cdr l))))
        (when (pair? split)
          (set! result #t)
          (set! split (reverse split))
          (gvec-set! groups gid (ts-filter (lambda (i) (not (vector-ref is-split i))) ids))
          (let ((new (gvec-length groups)))
            (for-each (lambda (i) (vector-set! group-of i new) (vector-set! is-split i #f)) split)
            (gvec-push! groups split)
            (when dirty
              (gvec-push! dirty #t)
              (for-each (lambda (i)
                          (for-each (lambda (p) (gvec-set! dirty (vector-ref group-of p) #t))
                                    (vector-ref preds i)))
                        split)))))))
    result))

(define (split-conflicting-groups! states groups group-of conflict? key-of key-hash)
  ;; split-state-id-groups! with conflict? and neither dirty nor preds, for a
  ;; conflict? which gives the same answers for two states with equal keys
  ;; (key-of with the current group-of) and none for them: such states have
  ;; the same fate, so only the first of each key is compared. A state is
  ;; split by the first state before it which stays and conflicts with it,
  ;; and the split states come in the order in which split-state-id-groups!
  ;; finds them. (named lets: under S7 a do counter stored in a table is
  ;; altered by the next iterations)
  (let gloop ((gid 0))
    (when (< gid (gvec-length groups))
      (let* ((ids (list->vector (gvec-ref groups gid)))
             (m (vector-length ids))
             (splitter (make-vector m #f))   ; the position which splits each one
             (keys (make-vector m #f))
             (classes (make-ahash-table))    ; hash -> positions of the firsts
             (staying (make-gvec)))          ; positions of the firsts which stay
        (let xloop ((x 0))
          (when (< x m)
            (let* ((s (gvec-ref states (vector-ref ids x)))
                   (key (key-of s group-of))
                   (h (key-hash key))
                   (firsts (or (ahash-ref classes h) '()))
                   (first (let floop ((l firsts))
                            (cond ((null? l) #f)
                                  ((equal? (vector-ref keys (car l)) key) (car l))
                                  (else (floop (cdr l)))))))
              (vector-set! keys x key)
              (if first
                  (vector-set! splitter x (vector-ref splitter first))
                  (begin
                    (ahash-set! classes h (cons x firsts))
                    (let sloop ((k 0))
                      (cond ((= k (gvec-length staying)) (gvec-push! staying x))
                            ((conflict? (gvec-ref states (vector-ref ids (gvec-ref staying k)))
                                        s group-of)
                             (vector-set! splitter x (gvec-ref staying k)))
                            (else (sloop (+ k 1)))))))
              (xloop (+ x 1)))))
        (let ((by-splitter (make-vector m '())))
          (let rloop ((x (- m 1)) (rest '()))
            (if (>= x 0)
                (let ((sp (vector-ref splitter x)))
                  (if sp
                      (begin
                        (vector-set! by-splitter sp (cons (vector-ref ids x)
                                                          (vector-ref by-splitter sp)))
                        (rloop (- x 1) rest))
                      (rloop (- x 1) (cons (vector-ref ids x) rest))))
                (let ((split (let cloop ((k (- (gvec-length staying) 1)) (acc '()))
                               (if (< k 0) acc
                                   (cloop (- k 1) (append (vector-ref by-splitter
                                                                      (gvec-ref staying k))
                                                          acc))))))
                  (when (pair? split)
                    (gvec-set! groups gid rest)
                    (let ((new (gvec-length groups)))
                      (for-each (lambda (i) (vector-set! group-of i new)) split)
                      (gvec-push! groups split)))))))
        (gloop (+ gid 1))))))

(define (last-shift-target actions)
  (let ((a (and (pair? actions) (ts-last actions))))
    (and a (eq? (car a) 'shift) (cadr a))))

(define (merge-compatible-states! g states tc keywords)
  (let* ((n (gvec-length states))
         (core-count (+ 1 (let loop ((i 0) (m 0))
                            (if (= i n) m (loop (+ i 1) (max m (state-core (gvec-ref states i))))))))
         (groups (make-gvec))
         (group-of (make-vector n 0))
         (word (g-ref g 'word))
         (internal-external (ts-filter (lambda (x) x)
                                       (ts-map (lambda (e) (vector-ref e 2))
                                               (g-ref g 'external-tokens)))))
    (do ((i 0 (+ i 1))) ((= i core-count)) (gvec-push! groups '()))
    (do ((i 0 (+ i 1))) ((= i n))
      (let ((c (state-core (gvec-ref states i))))
        (gvec-set! groups c (append (gvec-ref groups c) (list i)))
        (vector-set! group-of i c)))
    (define n-terminals (vector-length (g-ref g 'lexical)))
    (define state-terminal-sets
      ;; for each state, a vector of booleans indexed by the terminals
      (let ((v (make-vector n #f)))
        (do ((i 0 (+ i 1))) ((= i n) v)
          (let ((set (make-vector n-terminals #f)))
            (for-each (lambda (s) (when (terminal? s) (vector-set! set (sym-index s) #t)))
                      (om-keys (state-terminals (gvec-ref states i))))
            (vector-set! v i set)))))
    (define conflict-rows
      ;; for each token, the tokens it conflicts with
      (let ((v (make-vector n-terminals '())))
        (do ((i 0 (+ i 1))) ((= i n-terminals) v)
          (vector-set! v i (ts-filter (lambda (j) (does-conflict? tc i j)) (ts-iota n-terminals))))))
    (define keyword-set
      (let ((v (make-vector n-terminals #f)))
        (for-each (lambda (k) (vector-set! v (sym-index k) #t)) keywords)
        v))
    (define (token-conflicts? right new-token)
      (cond ((= new-token sym-eont) #t)
            ((external? new-token) #t)
            ((ts-contains? (state-reserved right) new-token) #f)
            ((and (terminal? new-token) (member new-token internal-external)) #t)
            (else
             (let* ((is-word (eqv? word new-token))
                    (is-keyword (and word (terminal? new-token)
                                     (vector-ref keyword-set (sym-index new-token))))
                    (set (vector-ref state-terminal-sets (state-id right))))
               (ts-any (lambda (j)
                         (and (vector-ref set j)
                              (not (and is-keyword (eqv? (terminal j) word)))
                              (not (and is-word (vector-ref keyword-set j)))))
                       (vector-ref conflict-rows (sym-index new-token)))))))
    (define (entries-conflict? e1 e2 group-of)
      (let ((a1 (entry-actions e1)) (a2 (entry-actions e2)))
        (and (not (equal? a1 a2))
             (or (not (= (length a1) (length a2)))
                 (ts-any (lambda (x) x)
                         (ts-map2 (lambda (x y)
                                    (if (and (eq? (car x) 'shift) (eq? (car y) 'shift))
                                        (not (and (= (vector-ref group-of (cadr x))
                                                     (vector-ref group-of (cadr y)))
                                                  (eq? (caddr x) (caddr y))))
                                        (not (equal? x y))))
                                  a1 a2))))))
    (define terminal-keys
      (let ((v (make-vector n '())))
        (do ((i 0 (+ i 1))) ((= i n) v)
          (vector-set! v i (om-keys (state-terminals (gvec-ref states i)))))))
    (define (sorted-pairs l)
      (list->vector (ts-sort l (lambda (a b) (< (car a) (car b))))))
    (define shift-targets
      ;; for each state, the vector of (token . target) of the tokens whose
      ;; last action is a shift, sorted by token
      (let ((v (make-vector n #f)))
        (do ((i 0 (+ i 1))) ((= i n) v)
          (let ((t (state-terminals (gvec-ref states i))))
            (vector-set! v i (sorted-pairs
                              (ts-filter (lambda (x) (cdr x))
                                         (ts-map (lambda (k)
                                                   (cons k (last-shift-target (entry-actions (om-ref t k)))))
                                                 (vector-ref terminal-keys i)))))))))
    (define gotos
      ;; for each state, the vector of (non-terminal . action), sorted
      (let ((v (make-vector n #f)))
        (do ((i 0 (+ i 1))) ((= i n) v)
          (let ((t (state-nonterminals (gvec-ref states i))))
            (vector-set! v i (sorted-pairs (ts-map (lambda (k) (cons k (om-ref t k))) (om-keys t))))))))
    (define token-conflict-memo (make-ahash-table))
    (define (token-conflicts-memo? right new-token)
      (let* ((key (+ (* (state-id right) 4194304) new-token))
             (old (ahash-ref token-conflict-memo key)))
        (if old (eq? old 'yes)
            (let ((r (token-conflicts? right new-token)))
              (ahash-set! token-conflict-memo key (if r 'yes 'no))
              r))))
    (define state-entries
      ;; for each state, the vector of (token . entry), sorted by token
      (let ((v (make-vector n #f)))
        (do ((i 0 (+ i 1))) ((= i n) v)
          (let ((t (state-terminals (gvec-ref states i))))
            (vector-set! v i (sorted-pairs
                              (ts-map (lambda (k) (cons k (om-ref t k)))
                                      (vector-ref terminal-keys i))))))))
    (define (states-conflict? s1 s2 group-of)
      (let* ((v1 (vector-ref state-entries (state-id s1)))
             (v2 (vector-ref state-entries (state-id s2)))
             (n1 (vector-length v1)) (n2 (vector-length v2)))
        (let loop ((i 0) (j 0))
          (cond ((and (= i n1) (= j n2)) #f)
                ((= j n2)
                 (or (token-conflicts-memo? s2 (car (vector-ref v1 i))) (loop (+ i 1) j)))
                ((= i n1)
                 (or (token-conflicts-memo? s1 (car (vector-ref v2 j))) (loop i (+ j 1))))
                (else
                 (let ((a (vector-ref v1 i)) (b (vector-ref v2 j)))
                   (cond ((< (car a) (car b))
                          (or (token-conflicts-memo? s2 (car a)) (loop (+ i 1) j)))
                         ((> (car a) (car b))
                          (or (token-conflicts-memo? s1 (car b)) (loop i (+ j 1))))
                         ((and (not (eq? (cdr a) (cdr b)))
                               (entries-conflict? (cdr a) (cdr b) group-of))
                          #t)
                         (else (loop (+ i 1) (+ j 1))))))))))
    (define (common-differ? v1 v2 differ?)
      ;; whether some key of both sorted vectors has values which differ
      (let ((n1 (vector-length v1)) (n2 (vector-length v2)))
        (let loop ((i 0) (j 0))
          (and (< i n1) (< j n2)
               (let ((a (vector-ref v1 i)) (b (vector-ref v2 j)))
                 (cond ((< (car a) (car b)) (loop (+ i 1) j))
                       ((> (car a) (car b)) (loop i (+ j 1)))
                       ((differ? (cdr a) (cdr b)) #t)
                       (else (loop (+ i 1) (+ j 1)))))))))
    (define (successors-differ? s1 s2 group-of)
      (or (common-differ? (vector-ref shift-targets (state-id s1))
                          (vector-ref shift-targets (state-id s2))
                          (lambda (x y) (not (= (vector-ref group-of x) (vector-ref group-of y)))))
          (common-differ? (vector-ref gotos (state-id s1))
                          (vector-ref gotos (state-id s2))
                          (lambda (a b)
                            (cond ((and (eq? (car a) 'shift-extra) (eq? (car b) 'shift-extra)) #f)
                                  ((and (eq? (car a) 'goto) (eq? (car b) 'goto))
                                   (not (= (vector-ref group-of (cadr a))
                                           (vector-ref group-of (cadr b)))))
                                  (else #t))))))
    (define preds
      ;; for each state, the states which shift or go to it
      (let ((v (make-vector n '())))
        (do ((i 0 (+ i 1))) ((= i n) v)
          (let ((sh (vector-ref shift-targets i)))
            (do ((j 0 (+ j 1))) ((= j (vector-length sh)))
              (let ((t (cdr (vector-ref sh j))))
                (vector-set! v t (cons i (vector-ref v t))))))
          (let ((go (vector-ref gotos i)))
            (do ((j 0 (+ j 1))) ((= j (vector-length go)))
              (let ((x (vector-ref go j)))
                (when (eq? (cadr x) 'goto)
                  (let ((t (caddr x)))
                    (vector-set! v t (cons i (vector-ref v t)))))))))))
    (define (entries-key s group-of)
      ;; what states-conflict? sees of s: the reserved words and the
      ;; entries, the shift targets replaced by their groups
      (cons (state-reserved s)
            (ts-map (lambda (p)
                      (cons (car p)
                            (ts-map (lambda (a)
                                      (if (eq? (car a) 'shift)
                                          (cons 'shift (cons (vector-ref group-of (cadr a))
                                                             (cddr a)))
                                          a))
                                    (entry-actions (cdr p)))))
                    (vector->list (vector-ref state-entries (state-id s))))))
    (define (key-hash key)
      ;; from the tokens and the numbers after the kinds of the actions
      (let loop ((l (cdr key)) (h (length (car key))))
        (if (null? l) h
            (loop (cdr l)
                  (let aloop ((as (cdar l)) (h (modulo (+ (* h 31) (caar l)) 1000000007)))
                    (if (null? as) h
                        (let ((a (car as)))
                          (aloop (cdr as)
                                 (if (and (pair? (cdr a)) (integer? (cadr a)))
                                     (modulo (+ (* h 31) (cadr a)) 1000000007)
                                     (modulo (+ h 1) 1000000007))))))))))
    (split-conflicting-groups! states groups group-of states-conflict? entries-key key-hash)
    (let ((dirty (make-gvec)))
      (do ((i 0 (+ i 1))) ((= i (gvec-length groups))) (gvec-push! dirty #t))
      (let loop ()
        (when (split-state-id-groups! states groups group-of 0 successors-differ?
                                      dirty preds)
          (loop))))
    ;; the groups of the error state and of the start state come first
    (let* ((gl (gvec->list groups))
           (swap! (lambda (k state)
                    (let ((pos (ts-list-index (lambda (l) (member state l)) (gvec->list groups))))
                      (let ((tmp (gvec-ref groups k)))
                        (gvec-set! groups k (gvec-ref groups pos))
                        (gvec-set! groups pos tmp))))))
      (swap! 0 0)
      (swap! 1 1))
    (do ((k 0 (+ k 1))) ((= k (gvec-length groups)))
      (for-each (lambda (i) (vector-set! group-of i k)) (gvec-ref groups k)))
    (let ((new (make-gvec)))
      (gvec-for-each
       (lambda (ids)
         (let ((s (gvec-ref states (car ids))))
           (for-each
            (lambda (other-id)
              (let ((o (gvec-ref states other-id)))
                (when (state-eof-gated? o) (vector-set! s 7 #t))
                (om-for-each (lambda (k v) (om-set! (state-terminals s) k v)) (state-terminals o))
                (om-for-each (lambda (k v) (om-set! (state-nonterminals s) k v)) (state-nonterminals o))
                (vector-set! s 3 (ts-union (state-reserved s) (state-reserved o)))
                (vector-set! s 3 (ts-filter (lambda (r) (not (om-has? (state-terminals s) r)))
                                            (state-reserved s)))))
            (cdr ids))
           (gvec-push! new s)))
       groups)
      (remap-states! new (lambda (id) (vector-ref group-of id)))
      new)))

(define (remap-states! states fun)
  ;; renumber the targets of the shifts and gotos, in new entries since
  ;; merged states may share them
  (gvec-for-each
   (lambda (s)
     (om-for-each
      (lambda (k e)
        (om-set! (state-terminals s) k
                 (vector (ts-map (lambda (a)
                                   (if (eq? (car a) 'shift)
                                       (list 'shift (fun (cadr a)) (caddr a))
                                       a))
                                 (entry-actions e))
                         (entry-reusable? e))))
      (state-terminals s))
     (om-for-each
      (lambda (k a)
        (when (eq? (car a) 'goto)
          (om-set! (state-nonterminals s) k (list 'goto (fun (cadr a))))))
      (state-nonterminals s)))
   states))

(define (copy-entries! states)
  ;; give each state its own entry vectors
  (gvec-for-each
   (lambda (s)
     (om-for-each (lambda (k e) (om-set! (state-terminals s) k (vector (entry-actions e)
                                                                       (entry-reusable? e))))
                  (state-terminals s)))
   states))

(define (remove-unit-reductions! g states)
  (let ((aliased (make-ahash-table))
        (unit (make-ahash-table))
        (default-aliases (g-ref g 'default-aliases)))
    (vector-for-each**
     (lambda (p)
       (do ((i 0 (+ i 1))) ((= i (prod-length p)))
         (when (step-alias (prod-step p i))
           (ahash-set! aliased (step-symbol (prod-step p i)) #t))))
     (g-ref g 'productions))
    (do ((i 0 (+ i 1))) ((= i (gvec-length states)))
      (let ((s (gvec-ref states i)))
        (unless (state-eof-gated? s)
          (let ((symbol #f) (only #t))
            (for-each
             (lambda (k)
               (when only
                 (for-each
                  (lambda (a)
                    (when only
                      (cond ((eq? (car a) 'shift-extra) #t)
                            ((and (eq? (car a) 'reduce)
                                  (= (caddr a) 1) (= (list-ref a 4) 0)
                                  (let ((sym (cadr a)))
                                    (and (not (ahash-ref default-aliases sym))
                                         (not (member sym (g-ref g 'supertypes)))
                                         (not (member sym (g-ref g 'extra-symbols)))
                                         (not (ahash-ref aliased sym))
                                         (not (= (g-variable-kind g (sym-index sym)) vt-named))
                                         (or (not symbol) (= symbol sym)))))
                             (set! symbol (cadr a)))
                            (else (set! only #f)))))
                  (entry-actions (om-ref (state-terminals s) k)))))
             (om-keys (state-terminals s)))
            (when (and symbol only) (ahash-set! unit i symbol))))))
    (when (> (ahash-size unit) 0)
      (copy-entries! states)
      (do ((i 0 (+ i 1))) ((= i (gvec-length states)))
        (let ((s (gvec-ref states i)))
          (let loop ()
            (let ((done #t))
              (om-for-each
               (lambda (k a)
                 (when (eq? (car a) 'goto)
                   (let ((sym (ahash-ref unit (cadr a))))
                     (when sym
                       (set! done #f)
                       (let ((g2 (om-ref (state-nonterminals s) sym)))
                         (when (and g2 (eq? (car g2) 'goto))
                           (om-set! (state-nonterminals s) k g2)))))))
               (state-nonterminals s))
              (om-for-each
               (lambda (k e)
                 (vector-set! e 0
                              (ts-map (lambda (a)
                                        (if (eq? (car a) 'shift)
                                            (let* ((sym (ahash-ref unit (cadr a)))
                                                   (g2 (and sym (om-ref (state-nonterminals s) sym))))
                                              (if (and g2 (eq? (car g2) 'goto)
                                                       (not (= (cadr g2) (cadr a))))
                                                  (begin (set! done #f)
                                                         (list 'shift (cadr g2) (caddr a)))
                                                  a))
                                            a))
                                      (entry-actions e))))
               (state-terminals s))
              (unless done (loop)))))))))

(define (referenced-states s)
  (append (apply append
                 (ts-map (lambda (k)
                           (ts-map cadr (ts-filter (lambda (a) (eq? (car a) 'shift))
                                                   (entry-actions (om-ref (state-terminals s) k)))))
                         (om-keys (state-terminals s))))
          (ts-map cadr (ts-filter (lambda (a) (eq? (car a) 'goto))
                                  (ts-map (lambda (k) (om-ref (state-nonterminals s) k))
                                          (om-keys (state-nonterminals s)))))))

(define (remove-unused-states states)
  (let* ((n (gvec-length states))
         (used (make-vector n #f))
         (replacement (make-vector n 0)))
    (vector-set! used 0 #t)
    (vector-set! used 1 #t)
    (gvec-for-each (lambda (s) (for-each (lambda (r) (vector-set! used r #t)) (referenced-states s)))
                   states)
    (let loop ((i 0) (removed 0))
      (when (< i n)
        (vector-set! replacement i (- i removed))
        (loop (+ i 1) (if (vector-ref used i) removed (+ removed 1)))))
    (let ((new (make-gvec)))
      (do ((i 0 (+ i 1))) ((= i n))
        (when (vector-ref used i) (gvec-push! new (gvec-ref states i))))
      (remap-states! new (lambda (id) (vector-ref replacement id)))
      new)))

(define (reorder-states-by-descending-size states)
  (let* ((n (gvec-length states))
         (order (ts-sort (ts-iota n)
                         (lambda (a b)
                           (define (key i)
                             (if (<= i 1) (- i 1000000)
                                 (let ((s (gvec-ref states i)))
                                   (- (+ (om-length (state-terminals s))
                                         (om-length (state-nonterminals s)))))))
                           (< (key a) (key b)))))
         (new-of (make-vector n 0))
         (new (make-gvec)))
    (ts-map-index (lambda (k old) (vector-set! new-of old k)) order)
    (for-each (lambda (old) (gvec-push! new (gvec-ref states old))) order)
    (remap-states! new (lambda (id) (vector-ref new-of id)))
    new))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Lex tables
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (make-lex-builder g)
  (vector g (make-gvec) (make-ahash-table) '()))

(define (lex-builder-table lb) (vector-ref lb 1))

(define (lex-add-state! lb nfa-states eof-valid)
  ;; the id of the lex state, and whether it is new
  (let* ((g (vector-ref lb 0))
         (ids (nfa-closure (g-ref g 'nfa) nfa-states))
         (key (cons eof-valid ids))
         (old (ahash-ref (vector-ref lb 2) key)))
    (if old (cons old #f)
        (let ((id (gvec-push! (vector-ref lb 1) (vector #f #f '()))))
          (ahash-set! (vector-ref lb 2) key id)
          (vector-set! lb 3 (append (vector-ref lb 3) (list (list id ids eof-valid))))
          (cons id #t)))))

(define (lex-populate-state! lb id ids eof-valid)
  (let* ((g (vector-ref lb 0))
         (nfa (g-ref g 'nfa))
         (lexical (g-ref g 'lexical))
         (state (gvec-ref (vector-ref lb 1) id))
         (completion #f))
    (for-each (lambda (c)
                (unless (and completion
                             (prefer-token? lexical (cons (cdr completion) (car completion))
                                            (cons (cdr c) (car c))))
                  (set! completion c)))
              (nfa-completions nfa ids))
    (let ((transitions (nfa-transitions nfa ids))
          (has-sep (nfa-any-separator? nfa ids)))
      (when eof-valid
        (let ((next (car (lex-add-state! lb '() #f))))
          (vector-set! state 1 (cons next #t))))
      (for-each
       (lambda (t)
         (unless (and completion
                      (not (prefer-transition? lexical t (car completion) (cdr completion) has-sep)))
           (let ((next (car (lex-add-state! lb (tr-states t) (and eof-valid (tr-sep? t))))))
             (vector-set! state 2 (append (vector-ref state 2)
                                          (list (cons (tr-chars t) (cons next (not (tr-sep? t))))))))))
       transitions)
      (cond (completion (vector-set! state 0 (terminal (car completion))))
            ((null? ids) (vector-set! state 0 sym-end))))))

(define (lex-add-state-for-tokens! lb tokens)
  (let* ((g (vector-ref lb 0))
         (lexical (g-ref g 'lexical))
         (eof-valid #f)
         (nfa-states (let loop ((l tokens) (acc '()))
                       (cond ((null? l) (reverse acc))
                             ((terminal? (car l))
                              (loop (cdr l) (cons (lex-start-state (vector-ref lexical (sym-index (car l))))
                                                  acc)))
                             (else (set! eof-valid #t) (loop (cdr l) acc)))))
         (r (lex-add-state! lb nfa-states eof-valid)))
    (let loop ()
      (when (pair? (vector-ref lb 3))
        (let ((e (car (vector-ref lb 3))))
          (vector-set! lb 3 (cdr (vector-ref lb 3)))
          (lex-populate-state! lb (car e) (cadr e) (caddr e))
          (loop))))
    (car r)))

(define (check-token-conflicts? tc ci i set)
  (ts-any (lambda (s)
            (and (terminal? s)
                 (let ((j (sym-index s)))
                   (or (does-conflict? tc i j) (does-match-prefix? tc i j)
                       (and (or (does-overlap? tc i j) (does-overlap? tc j i))
                            (not (coincident? ci i j)))))))
          set))

(define (merge-token-set tokens other tc ci)
  ;; the union, or #f if the token sets cannot share a lex state
  (and (not (ts-any (lambda (t) (and (not (ts-contains? other t))
                                     (check-token-conflicts? tc ci (sym-index t) other)))
                    (ts-terminals tokens)))
       (not (ts-any (lambda (t) (and (not (ts-contains? tokens t))
                                     (check-token-conflicts? tc ci (sym-index t) tokens)))
                    (ts-terminals other)))
       (ts-union tokens other)))

(define (lex-state<? a b)
  ;; the order of LexState: accept, eof action, advance actions
  (define (opt-cmp x y cmp)
    (cond ((and (not x) (not y)) 0) ((not x) -1) ((not y) 1) (else (cmp x y))))
  (define (adv-cmp x y)
    (let ((c (cs-compare (car x) (car y))))
      (if (not (= c 0)) c
          (let ((c (ts-cmp (cadr x) (cadr y))))
            (if (not (= c 0)) c
                (ts-cmp (if (cddr x) 1 0) (if (cddr y) 1 0)))))))
  (let ((c (opt-cmp (vector-ref a 0) (vector-ref b 0) ts-cmp)))
    (if (not (= c 0)) (< c 0)
        (let ((c (opt-cmp (vector-ref a 1) (vector-ref b 1)
                          (lambda (x y)
                            (let ((c (ts-cmp (car x) (car y))))
                              (if (not (= c 0)) c (ts-cmp (if (cdr x) 1 0) (if (cdr y) 1 0))))))))
          (if (not (= c 0)) (< c 0)
              (< (ts-compare-lists (vector-ref a 2) (vector-ref b 2) adv-cmp) 0))))))

(define (minimize-lex-table table parse-states)
  (let* ((n (gvec-length table))
         (by-signature (make-ahash-table))
         (sig-order '()))
    (do ((i 0 (+ i 1))) ((= i n))
      (let* ((s (gvec-ref table i))
             (sig (list (= i 0) (vector-ref s 0) (and (vector-ref s 1) #t)
                        (ts-map (lambda (a) (cons (car a) (cddr a))) (vector-ref s 2)))))
        (unless (ahash-ref by-signature sig) (set! sig-order (cons sig sig-order)))
        (ahash-set! by-signature sig (append (or (ahash-ref by-signature sig) '()) (list i)))))
    (let* ((groups (list->gvec (ts-sort (ts-map (lambda (sig) (ahash-ref by-signature sig))
                                                (reverse sig-order))
                                        (lambda (a b) (< (ts-compare-lists a b ts-cmp) 0)))))
           (group-of (make-vector n 0)))
      (let ((pos (ts-list-index (lambda (l) (member 0 l)) (gvec->list groups))))
        (let ((tmp (gvec-ref groups 0)))
          (gvec-set! groups 0 (gvec-ref groups pos))
          (gvec-set! groups pos tmp)))
      (do ((k 0 (+ k 1))) ((= k (gvec-length groups)))
        (for-each (lambda (i) (vector-set! group-of i k)) (gvec-ref groups k)))
      (let loop ()
        (when (split-state-id-groups!
               table groups group-of 1
               (lambda (l r group-of)
                 (ts-any (lambda (x) x)
                         (ts-map2 (lambda (a b) (not (= (vector-ref group-of (cadr a))
                                                        (vector-ref group-of (cadr b)))))
                                  (vector-ref l 2) (vector-ref r 2))))
               #f #f)
          (loop)))
      (let ((new (make-gvec)))
        (gvec-for-each
         (lambda (ids)
           (let ((s (gvec-ref table (car ids))))
             (gvec-push! new (vector (vector-ref s 0)
                                     (and (vector-ref s 1)
                                          (cons (vector-ref group-of (car (vector-ref s 1)))
                                                (cdr (vector-ref s 1))))
                                     (ts-map (lambda (a) (cons (car a)
                                                               (cons (vector-ref group-of (cadr a))
                                                                     (cddr a))))
                                             (vector-ref s 2))))))
         groups)
        (gvec-for-each (lambda (ps) (vector-set! ps 4 (vector-ref group-of (state-lex ps))))
                       parse-states)
        new))))

(define (sort-lex-states table parse-states)
  (let* ((n (gvec-length table))
         (order (cons 0 (ts-sort (cdr (ts-iota n))
                                 (lambda (a b) (lex-state<? (gvec-ref table a) (gvec-ref table b))))))
         (new-of (make-vector n 0))
         (new (make-gvec)))
    (ts-map-index (lambda (k old) (vector-set! new-of old k)) order)
    (for-each (lambda (old)
                (let ((s (gvec-ref table old)))
                  (gvec-push! new (vector (vector-ref s 0)
                                          (and (vector-ref s 1)
                                               (cons (vector-ref new-of (car (vector-ref s 1)))
                                                     (cdr (vector-ref s 1))))
                                          (ts-map (lambda (a) (cons (car a)
                                                                    (cons (vector-ref new-of (cadr a))
                                                                          (cddr a))))
                                                  (vector-ref s 2))))))
              order)
    (gvec-for-each (lambda (ps) (vector-set! ps 4 (vector-ref new-of (state-lex ps))))
                   parse-states)
    new))

(define (build-lex-tables g states keywords tc ci)
  (let* ((word (g-ref g 'word))
         (keyword-table (if word
                            (let ((lb (make-lex-builder g)))
                              (lex-add-state-for-tokens! lb keywords)
                              (lex-builder-table lb))
                            (make-gvec)))
         (by-token-set '()))
    (do ((i 0 (+ i 1))) ((= i (gvec-length states)))
      (let* ((s (gvec-ref states i))
             (tokens (list->ts
                      (ts-filter (lambda (x) x)
                                 (ts-map (lambda (t)
                                           (cond ((terminal? t) (if (member t keywords) word t))
                                                 ((= t sym-end) t)
                                                 (else #f)))
                                         (append (om-keys (state-terminals s)) (state-reserved s)))))))
        (let loop ((l by-token-set))
          (cond ((null? l)
                 (set! by-token-set (append by-token-set (list (cons tokens (list i))))))
                ((merge-token-set (car (car l)) tokens tc ci)
                 => (lambda (merged)
                      (set-car! (car l) merged)
                      (set-cdr! (car l) (append (cdr (car l)) (list i)))))
                (else (loop (cdr l)))))))
    (let ((lb (make-lex-builder g)))
      (for-each (lambda (e)
                  (let ((id (lex-add-state-for-tokens! lb (car e))))
                    (for-each (lambda (i) (vector-set! (gvec-ref states i) 4 id)) (cdr e))))
                by-token-set)
      (let* ((main (minimize-lex-table (lex-builder-table lb) states))
             (main (sort-lex-states main states)))
        (cons main keyword-table)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; External lex states and fragile tokens
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (populate-external-lex-states! g states)
  (let ((by-internal (make-ahash-table))
        (lex-states (make-gvec)))
    (ts-map-index (lambda (i e) (when (vector-ref e 2) (ahash-set! by-internal (vector-ref e 2) i)))
                  (g-ref g 'external-tokens))
    (gvec-push! lex-states '())
    (gvec-for-each
     (lambda (s)
       (let ((tokens (list->ts
                      (ts-filter (lambda (x) x)
                                 (ts-map (lambda (t)
                                           (cond ((external? t) t)
                                                 ((and (terminal? t) (ahash-ref by-internal t))
                                                  (external (ahash-ref by-internal t)))
                                                 (else #f)))
                                         (om-keys (state-terminals s)))))))
         (vector-set! s 5 (or (gvec-index lex-states tokens) (gvec-push! lex-states tokens)))))
     states)
    (gvec->vector lex-states)))

(define (mark-fragile-tokens! states tc)
  (copy-entries! states)
  (gvec-for-each
   (lambda (s)
     (let ((valid (ts-map sym-index (ts-filter terminal? (om-keys (state-terminals s))))))
       (om-for-each
        (lambda (t e)
          (when (and (terminal? t)
                     (ts-any (lambda (i) (does-overlap? tc i (sym-index t))) valid))
            (vector-set! e 1 #f)))
        (state-terminals s))))
   states))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; All the tables
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-public (build-tables! g)
  ;; the parse table of build-parse-table, completed
  (ts-profile "grammar")
  (if (ts-native-tables?)
      (apply build-tables-end! g (ts-native-build g identify-keywords))
      (build-tables-scheme! g)))

(define-public (build-tables-for-export g)
  ;; (id . t): the tables made in C++ and kept there for
  ;; tree-sitter-tables-export, t with the symbols and the production infos
  (ts-profile "grammar")
  (ts-native-build g identify-keywords #t))

(define (build-tables-end! g t tc ci keywords lex)
  ;; the last details, after the merging of the states and the lex tables
  (let* ((states (ahash-ref t 'states)))
    (ahash-set! t 'external-lex-states (populate-external-lex-states! g states))
    (ts-profile "external lex states")
    (mark-fragile-tokens! states tc)
    (ts-profile "fragile tokens")
    (ahash-set! t 'lex-table (car lex))
    (ahash-set! t 'keyword-lex-table (cdr lex))
    (ahash-set! t 'keywords keywords)
    (ahash-set! t 'token-conflicts tc)
    t))

(define (build-tables-scheme! g)
  (let* ((t (build-parse-table g))
         (b (begin (ts-profile "lr") (ahash-ref t 'builder)))
         (states (ahash-ref t 'states))
         (tc (make-token-conflict-map g (following-tokens g b)))
         (ci (begin (ts-profile "token conflicts") (make-coincident-index g states)))
         (keywords (begin (ts-profile "coincident") (identify-keywords g tc ci))))
    (populate-error-state! g states tc ci keywords)
    (ahash-set! t 'symbols (used-symbols g states))
    (ts-profile "keywords, error state")
    (let* ((states (merge-compatible-states! g states tc keywords))
           (states (begin (ts-profile "merge") (remove-unit-reductions! g states) states))
           (states (remove-unused-states states))
           (states (reorder-states-by-descending-size states))
           (lex (begin (ts-profile "unit, unused, reorder")
                       (build-lex-tables g states keywords tc ci))))
      (ts-profile "lex")
      (ahash-set! t 'external-lex-states (populate-external-lex-states! g states))
      (mark-fragile-tokens! states tc)
      (ahash-set! t 'states states)
      (ahash-set! t 'lex-table (car lex))
      (ahash-set! t 'keyword-lex-table (cdr lex))
      (ahash-set! t 'keywords keywords)
      (ahash-set! t 'token-conflicts tc)
      t)))
