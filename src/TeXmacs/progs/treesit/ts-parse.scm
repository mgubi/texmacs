;; A port of the runtime of tree-sitter (lib/src: parser.c, stack.c,
;; subtree.c and the lexer) running the tables of ts-language.scm.
;;
;; The text is a vector of code points; offsets and sizes count code points
;; (where tree-sitter counts bytes) and rows count newlines.
;;
;; A subtree is a vector, see the accessors below; leaves have no children.
;; The parse stack is a graph of stack nodes #(state offset rows links
;; error-cost node-count dynamic-precedence), a link being #(node subtree
;; pending?), with one head per version.

(texmacs-module (treesit ts-parse)
  (:use (treesit ts-base) (treesit ts-language)))

(define error-state 0)
(define error-cost-per-recovery 500)
(define error-cost-per-missing-tree 110)
(define error-cost-per-skipped-tree 100)
(define error-cost-per-skipped-line 30)
(define error-cost-per-skipped-char 1)
(define max-version-count 6)
(define max-version-count-overflow 4)
(define max-summary-depth 16)
(define max-cost-difference (* 18 100))
(define max-link-count 8)
(define max-iterator-count 64)
(define state-none 65535)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Subtrees
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define f-visible 1)
(define f-named 2)
(define f-extra 4)
(define f-fragile-left 8)
(define f-fragile-right 16)
(define f-has-changes 32)
(define f-external 64)
(define f-missing 128)
(define f-keyword 256)
(define f-column 512)
(define f-scanner-change 1024)

(define-public (st-symbol t) (vector-ref t 0))
(define-public (st-padding t) (vector-ref t 1))
(define-public (st-padding-rows t) (vector-ref t 2))
(define-public (st-size t) (vector-ref t 3))
(define-public (st-size-rows t) (vector-ref t 4))
(define-public (st-lookahead-bytes t) (vector-ref t 5))
(define-public (st-parse-state t) (vector-ref t 6))
(define-public (st-children t) (vector-ref t 7))
(define-public (st-production-id t) (vector-ref t 8))
(define (st-error-cost* t) (vector-ref t 9))
(define-public (st-flags t) (vector-ref t 17))
(define-public (st-external-state t) (vector-ref t 18))

(define-public (st-child-count t) (let ((c (vector-ref t 7))) (if c (vector-length c) 0)))
(define-public (st-child t i) (vector-ref (vector-ref t 7) i))
(define (flag? t f) (not (= (logand (vector-ref t 17) f) 0)))
(define (set-flag! t f on)
  (vector-set! t 17 (if on (logior (vector-ref t 17) f)
                        (logand (vector-ref t 17) (- -1 f)))))

(define-public (st-visible? t) (flag? t f-visible))
(define-public (st-named? t) (flag? t f-named))
(define-public (st-extra? t) (flag? t f-extra))
(define-public (st-missing? t) (flag? t f-missing))
(define-public (st-keyword? t) (flag? t f-keyword))
(define-public (st-has-changes? t) (flag? t f-has-changes))
(define (st-has-external-tokens? t) (flag? t f-external))
(define (st-fragile-left? t) (flag? t f-fragile-left))
(define (st-fragile-right? t) (flag? t f-fragile-right))
(define (st-fragile? t) (or (st-fragile-left? t) (st-fragile-right? t)))
(define (st-depends-on-column? t) (flag? t f-column))
(define (st-scanner-change? t) (flag? t f-scanner-change))
(define-public (st-error? t) (= (st-symbol t) ts-sym-error))
(define (st-eof? t) (= (st-symbol t) 0))
(define-public (st-total-bytes t) (+ (st-padding t) (st-size t)))
(define (st-total-rows t) (+ (st-padding-rows t) (st-size-rows t)))

(define-public (st-error-cost t)
  (if (st-missing? t) (+ error-cost-per-missing-tree error-cost-per-recovery)
      (st-error-cost* t)))
(define-public (st-dynamic-precedence t) (if (st-children t) (vector-ref t 10) 0))
(define (st-repeat-depth t) (if (st-children t) (vector-ref t 11) 0))
(define (st-visible-child-count t) (vector-ref t 12))
(define (st-named-child-count t) (vector-ref t 13))
(define (st-visible-descendant-count t) (if (st-children t) (vector-ref t 14) 0))
(define-public (st-leaf-symbol t) (if (st-children t) (vector-ref t 15) (st-symbol t)))
(define (st-leaf-parse-state t) (if (st-children t) (vector-ref t 16) (st-parse-state t)))

(define (st-copy t)
  (let ((r (make-vector 20 #f)))
    (do ((i 0 (+ i 1))) ((= i 20) r) (vector-set! r i (vector-ref t i)))))

(define (metadata-flags l symbol)
  (logior (if (lang-visible? l symbol) f-visible 0) (if (lang-named? l symbol) f-named 0)))

(define (new-leaf l symbol padding padding-rows size size-rows lookahead state
                  external? column? keyword?)
  (vector symbol padding padding-rows size size-rows lookahead state #f 0 0 0 0 0 0 0 0 0
          (logior (metadata-flags l symbol)
                  (if (= symbol 0) f-extra 0)
                  (if external? f-external 0)
                  (if column? f-column 0)
                  (if keyword? f-keyword 0))
          #f #f))

(define (new-error-leaf l char padding padding-rows size size-rows lookahead state)
  (let ((t (new-leaf l ts-sym-error padding padding-rows size size-rows lookahead state #f #f #f)))
    (set-flag! t f-fragile-left #t)
    (set-flag! t f-fragile-right #t)
    (vector-set! t 18 char)
    t))

(define (new-missing-leaf l symbol state padding padding-rows lookahead)
  (let ((t (new-leaf l symbol padding padding-rows 0 0 lookahead state #f #f #f)))
    (set-flag! t f-missing #t)
    t))

(define (error-extent-cost size size-rows)
  (+ error-cost-per-recovery (* error-cost-per-skipped-char size)
     (* error-cost-per-skipped-line size-rows)))

(define (summarize-children! l t)
  (let* ((children (st-children t))
         (n (vector-length children))
         (symbol (st-symbol t))
         (alias-seq (if (>= symbol 0) (lang-alias-sequence l (st-production-id t)) (vector)))
         (error-symbol? (or (= symbol ts-sym-error) (= symbol ts-sym-error-repeat)))
         (structural 0)
         (lookahead-end 0)
         (padding 0) (padding-rows 0) (size 0) (size-rows 0)
         (error-cost 0) (dyn 0) (vdc 0) (vcc 0) (ncc 0))
    (set-flag! t f-external #f)
    (set-flag! t f-column #f)
    (set-flag! t f-scanner-change #f)
    (do ((i 0 (+ i 1))) ((= i n))
      (let* ((child (vector-ref children i))
             (gcc (st-child-count child)))
        (when (and (or (= i 0) (= size-rows 0)) (st-depends-on-column? child))
          (set-flag! t f-column #t))
        (when (st-scanner-change? child) (set-flag! t f-scanner-change #t))
        (if (= i 0)
            (begin (set! padding (st-padding child)) (set! padding-rows (st-padding-rows child))
                   (set! size (st-size child)) (set! size-rows (st-size-rows child)))
            (begin (set! size (+ size (st-total-bytes child)))
                   (set! size-rows (+ size-rows (st-total-rows child)))))
        (let ((e (+ padding size (st-lookahead-bytes child))))
          (when (> e lookahead-end) (set! lookahead-end e)))
        (if (= (st-symbol child) ts-sym-error-repeat)
            (set! error-cost (+ error-cost (- (st-error-cost child)
                                              (error-extent-cost (st-size child) (st-size-rows child)))))
            (begin
              (set! error-cost (+ error-cost (st-error-cost child)))
              (when error-symbol?
                (unless (or (st-extra? child) (and (st-error? child) (= gcc 0)))
                  (cond ((st-visible? child)
                         (set! error-cost (+ error-cost error-cost-per-skipped-tree)))
                        ((> gcc 0)
                         (set! error-cost (+ error-cost (* error-cost-per-skipped-tree
                                                           (st-visible-child-count child))))))))))
        (set! dyn (+ dyn (st-dynamic-precedence child)))
        (set! vdc (+ vdc (st-visible-descendant-count child)))
        (let ((alias (and (not (st-extra? child)) (not (= (st-symbol child) 0))
                          (< structural (vector-length alias-seq))
                          (vector-ref alias-seq structural))))
          (cond ((and alias (not (= alias 0)))
                 (set! vdc (+ vdc 1)) (set! vcc (+ vcc 1))
                 (when (lang-named? l alias) (set! ncc (+ ncc 1))))
                ((st-visible? child)
                 (set! vdc (+ vdc 1)) (set! vcc (+ vcc 1))
                 (when (st-named? child) (set! ncc (+ ncc 1))))
                ((> gcc 0)
                 (set! vcc (+ vcc (st-visible-child-count child)))
                 (set! ncc (+ ncc (st-named-child-count child))))))
        (when (st-has-external-tokens? child) (set-flag! t f-external #t))
        (when (st-error? child)
          (set-flag! t f-fragile-left #t)
          (set-flag! t f-fragile-right #t)
          (vector-set! t 6 state-none))
        (unless (st-extra? child) (set! structural (+ structural 1)))))
    (vector-set! t 1 padding) (vector-set! t 2 padding-rows)
    (vector-set! t 3 size) (vector-set! t 4 size-rows)
    (vector-set! t 5 (- lookahead-end size padding))
    (when error-symbol?
      (set! error-cost (+ error-cost (error-extent-cost size size-rows))))
    (vector-set! t 9 error-cost)
    (vector-set! t 10 dyn)
    (vector-set! t 11 0)
    (vector-set! t 12 vcc)
    (vector-set! t 13 ncc)
    (vector-set! t 14 vdc)
    (when (> n 0)
      (let ((first (vector-ref children 0))
            (last (vector-ref children (- n 1))))
        (vector-set! t 15 (st-leaf-symbol first))
        (vector-set! t 16 (st-leaf-parse-state first))
        (when (st-fragile-left? first) (set-flag! t f-fragile-left #t))
        (when (st-fragile-right? last) (set-flag! t f-fragile-right #t))
        (when (and (>= n 2) (not (st-visible? t)) (not (st-named? t))
                   (= (st-symbol first) symbol))
          (vector-set! t 11 (+ 1 (max (st-repeat-depth first) (st-repeat-depth last)))))))
    t))

(define (new-node l symbol children production-id)
  ;; children is a list
  (let* ((fragile (or (= symbol ts-sym-error) (= symbol ts-sym-error-repeat)))
         (t (vector symbol 0 0 0 0 0 0 (list->vector children) production-id 0 0 0 0 0 0 0 0
                    (logior (metadata-flags l symbol)
                            (if fragile (logior f-fragile-left f-fragile-right) 0))
                    #f #f)))
    (summarize-children! l t)))

(define (new-error-node l children extra?)
  (let ((t (new-node l ts-sym-error children 0)))
    (set-flag! t f-extra extra?)
    t))

(define (st-compare a b)
  ;; the symbols of the errors are the largest ones, as in tree-sitter
  (let ((sa (let ((s (st-symbol a))) (if (< s 0) (+ 65536 s) s)))
        (sb (let ((s (st-symbol b))) (if (< s 0) (+ 65536 s) s))))
    (cond ((< sa sb) -1) ((< sb sa) 1)
          ((< (st-child-count a) (st-child-count b)) -1)
          ((< (st-child-count b) (st-child-count a)) 1)
          (else
           (let loop ((i 0))
             (if (= i (st-child-count a)) 0
                 (let ((c (st-compare (st-child a i) (st-child b i))))
                   (if (= c 0) (loop (+ i 1)) c))))))))

(define (st-last-external-token t)
  (let loop ((t t))
    (cond ((not (st-has-external-tokens? t)) #f)
          ((not (st-children t)) t)
          (else
           (let scan ((i (- (st-child-count t) 1)))
             (cond ((< i 0) #f)
                   ((st-has-external-tokens? (st-child t i)) (loop (st-child t i)))
                   (else (scan (- i 1)))))))))

(define (external-state t) (and t (st-external-state t)))

(define (external-state-eq? a b)
  (equal? (external-state a) (external-state b)))

(define (remove-trailing-extras children)
  ;; (non-extras . trailing-extras) of a list of subtrees
  (let loop ((r (reverse children)) (extras '()))
    (if (and (pair? r) (st-extra? (car r)))
        (loop (cdr r) (cons (car r) extras))
        (cons (reverse r) extras))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; The parse stack
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define (sn-state n) (vector-ref n 0))
(define (sn-offset n) (vector-ref n 1))
(define (sn-rows n) (vector-ref n 2))
(define (sn-links n) (vector-ref n 3))
(define (sn-error-cost n) (vector-ref n 4))
(define (sn-node-count n) (vector-ref n 5))
(define (sn-dynamic n) (vector-ref n 6))

(define (link-node k) (vector-ref k 0))
(define (link-subtree k) (vector-ref k 1))
(define (link-pending? k) (vector-ref k 2))

(define (subtree-node-count t)
  (+ (st-visible-descendant-count t)
     (if (st-visible? t) 1 0)
     (if (= (st-symbol t) ts-sym-error-repeat) 1 0)))

(define (new-stack-node previous subtree pending state)
  (if previous
      (vector state
              (+ (sn-offset previous) (if subtree (st-total-bytes subtree) 0))
              (+ (sn-rows previous) (if subtree (st-total-rows subtree) 0))
              (list (vector previous subtree pending))
              (+ (sn-error-cost previous) (if subtree (st-error-cost subtree) 0))
              (+ (sn-node-count previous) (if subtree (subtree-node-count subtree) 0))
              (+ (sn-dynamic previous) (if subtree (st-dynamic-precedence subtree) 0)))
      (vector state 0 0 '() 0 0 0)))

(define (subtree-equivalent? a b)
  (cond ((eq? a b) #t)
        ((or (not a) (not b)) #f)
        ((not (= (st-symbol a) (st-symbol b))) #f)
        ((and (> (st-error-cost a) 0) (> (st-error-cost b) 0)) #t)
        (else (and (= (st-padding a) (st-padding b))
                   (= (st-size a) (st-size b))
                   (= (st-child-count a) (st-child-count b))
                   (eq? (st-extra? a) (st-extra? b))
                   (external-state-eq? a b)))))

(define (add-link! self link)
  (unless (eq? (link-node link) self)
    (let loop ((links (sn-links self)))
      (if (pair? links)
          (let ((existing (car links)))
            (if (subtree-equivalent? (link-subtree existing) (link-subtree link))
                (cond ((eq? (link-node existing) (link-node link))
                       (when (> (if (link-subtree link) (st-dynamic-precedence (link-subtree link)) 0)
                                (if (link-subtree existing) (st-dynamic-precedence (link-subtree existing)) 0))
                         (vector-set! existing 1 (link-subtree link))
                         (vector-set! self 6 (+ (sn-dynamic (link-node link))
                                                (st-dynamic-precedence (link-subtree link))))))
                      ((and (= (sn-state (link-node existing)) (sn-state (link-node link)))
                            (= (sn-offset (link-node existing)) (sn-offset (link-node link)))
                            (= (sn-error-cost (link-node existing)) (sn-error-cost (link-node link))))
                       (for-each (lambda (k) (add-link! (link-node existing) k))
                                 (sn-links (link-node link)))
                       (let ((dyn (+ (sn-dynamic (link-node link))
                                     (if (link-subtree link) (st-dynamic-precedence (link-subtree link)) 0))))
                         (when (> dyn (sn-dynamic self)) (vector-set! self 6 dyn))))
                      (else (loop (cdr links))))
                (loop (cdr links))))
          (when (< (length (sn-links self)) max-link-count)
            (vector-set! self 3 (append (sn-links self) (list link)))
            (let ((node-count (+ (sn-node-count (link-node link))
                                 (if (link-subtree link) (subtree-node-count (link-subtree link)) 0)))
                  (dyn (+ (sn-dynamic (link-node link))
                          (if (link-subtree link) (st-dynamic-precedence (link-subtree link)) 0))))
              (when (> node-count (sn-node-count self)) (vector-set! self 5 node-count))
              (when (> dyn (sn-dynamic self)) (vector-set! self 6 dyn))))))))

;; heads: #(node summary node-count-at-last-error last-external-token
;;          lookahead-when-paused status)
(define (make-head node count ext) (vector node #f count ext #f 'active))
(define (head-node h) (vector-ref h 0))
(define (head-summary h) (vector-ref h 1))
(define (head-count-at-error h) (vector-ref h 2))
(define (head-external h) (vector-ref h 3))
(define (head-paused-lookahead h) (vector-ref h 4))
(define (head-status h) (vector-ref h 5))

(define (make-stack)
  (vector (make-gvec) (new-stack-node #f #f #f 1)))

(define (stack-heads s) (vector-ref s 0))
(define (stack-head s v) (gvec-ref (vector-ref s 0) v))
(define (stack-version-count s) (gvec-length (vector-ref s 0)))

(define (stack-clear! s)
  (vector-set! s 0 (make-gvec))
  (gvec-push! (vector-ref s 0) (make-head (vector-ref s 1) 0 #f)))

(define (stack-state s v) (sn-state (head-node (stack-head s v))))
(define (stack-offset s v) (sn-offset (head-node (stack-head s v))))
(define (stack-rows s v) (sn-rows (head-node (stack-head s v))))
(define (stack-last-external s v) (head-external (stack-head s v)))
(define (stack-set-last-external! s v t) (vector-set! (stack-head s v) 3 t))
(define (stack-dynamic s v) (sn-dynamic (head-node (stack-head s v))))
(define (stack-summary s v) (head-summary (stack-head s v)))

(define (stack-error-cost s v)
  (let* ((h (stack-head s v)) (n (head-node h)))
    (+ (sn-error-cost n)
       (if (or (eq? (head-status h) 'paused)
               (and (= (sn-state n) error-state)
                    (pair? (sn-links n)) (not (link-subtree (car (sn-links n))))))
           error-cost-per-recovery 0))))

(define (stack-node-count-since-error s v)
  (let* ((h (stack-head s v)) (n (head-node h)))
    (when (< (sn-node-count n) (head-count-at-error h))
      (vector-set! h 2 (sn-node-count n)))
    (- (sn-node-count n) (head-count-at-error h))))

(define (stack-push! s v subtree pending state)
  (let* ((h (stack-head s v))
         (n (new-stack-node (head-node h) subtree pending state)))
    (unless subtree (vector-set! h 2 (sn-node-count n)))
    (vector-set! h 0 n)))

(define (stack-active? s v) (eq? (head-status (stack-head s v)) 'active))
(define (stack-paused? s v) (eq? (head-status (stack-head s v)) 'paused))
(define (stack-halted? s v) (eq? (head-status (stack-head s v)) 'halted))
(define (stack-halt! s v) (vector-set! (stack-head s v) 5 'halted))

(define (stack-pause! s v lookahead)
  (let ((h (stack-head s v)))
    (vector-set! h 5 'paused)
    (vector-set! h 4 lookahead)
    (vector-set! h 2 (sn-node-count (head-node h)))))

(define (stack-resume! s v)
  (let* ((h (stack-head s v)) (t (head-paused-lookahead h)))
    (vector-set! h 5 'active)
    (vector-set! h 4 #f)
    t))

(define (gvec-erase! g i)
  (let ((n (gvec-length g)))
    (do ((k i (+ k 1))) ((>= k (- n 1)))
      (gvec-set! g k (gvec-ref g (+ k 1))))
    (gvec-pop! g)))

(define (gvec-insert! g i x)
  (gvec-push! g x)
  (do ((k (- (gvec-length g) 1) (- k 1))) ((<= k i))
    (gvec-set! g k (gvec-ref g (- k 1))))
  (gvec-set! g i x))

(define (stack-remove-version! s v) (gvec-erase! (stack-heads s) v))

(define (stack-renumber-version! s v1 v2)
  (unless (= v1 v2)
    (let ((source (stack-head s v1)) (target (stack-head s v2)))
      (when (and (head-summary target) (not (head-summary source)))
        (vector-set! source 1 (head-summary target)))
      (gvec-set! (stack-heads s) v2 source)
      (gvec-erase! (stack-heads s) v1))))

(define (stack-swap-versions! s v1 v2)
  (let ((h (stack-head s v1)))
    (gvec-set! (stack-heads s) v1 (stack-head s v2))
    (gvec-set! (stack-heads s) v2 h)))

(define (stack-copy-version! s v)
  (let* ((h (stack-head s v))
         (c (vector (head-node h) #f (head-count-at-error h) (head-external h)
                    (head-paused-lookahead h) (head-status h))))
    (gvec-push! (stack-heads s) c)))

(define (stack-add-version! s original node)
  (let ((h (stack-head s original)))
    (gvec-push! (stack-heads s) (make-head node (head-count-at-error h) (head-external h)))))

(define (stack-can-merge? s v1 v2)
  (let ((h1 (stack-head s v1)) (h2 (stack-head s v2)))
    (and (eq? (head-status h1) 'active) (eq? (head-status h2) 'active)
         (= (sn-state (head-node h1)) (sn-state (head-node h2)))
         (= (sn-offset (head-node h1)) (sn-offset (head-node h2)))
         (= (sn-error-cost (head-node h1)) (sn-error-cost (head-node h2)))
         (external-state-eq? (head-external h1) (head-external h2)))))

(define (stack-merge! s v1 v2)
  (and (stack-can-merge? s v1 v2)
       (let ((h1 (stack-head s v1)) (h2 (stack-head s v2)))
         (for-each (lambda (k) (add-link! (head-node h1) k)) (sn-links (head-node h2)))
         (when (= (sn-state (head-node h1)) error-state)
           (vector-set! h1 2 (sn-node-count (head-node h1))))
         (stack-remove-version! s v2)
         #t)))

(define (stack-halted-count s)
  (let loop ((i 0) (n 0))
    (if (= i (stack-version-count s)) n
        (loop (+ i 1) (if (stack-halted? s i) (+ n 1) n)))))

(define (stack-iter! s version callback goal)
  ;; the slices #(subtrees version) of the paths which the callback pops;
  ;; callback gets the iterator #(node subtrees count pending?) and returns
  ;; none, pop, stop or pop-stop
  (let ((slices (make-gvec))
        (iterators (make-gvec)))
    (define (add-slice! node subtrees)
      (let loop ((i (- (gvec-length slices) 1)))
        (if (< i 0)
            (begin
              (stack-add-version! s version node)
              (gvec-push! slices (vector subtrees (- (stack-version-count s) 1))))
            (let ((v (vector-ref (gvec-ref slices i) 1)))
              (if (eq? (head-node (stack-head s v)) node)
                  (gvec-insert! slices (+ i 1) (vector subtrees v))
                  (loop (- i 1)))))))
    (gvec-push! iterators (vector (head-node (stack-head s version)) '() 0 #t))
    (let outer ()
      (when (> (gvec-length iterators) 0)
        (let loop ((i 0) (size (gvec-length iterators)))
          (when (< i size)
            (let* ((it (gvec-ref iterators i))
                   (node (vector-ref it 0))
                   (action (callback it))
                   (pop? (memq action '(pop pop-stop)))
                   (stop? (or (memq action '(stop pop-stop)) (null? (sn-links node)))))
              (when pop? (add-slice! node (vector-ref it 1)))
              (if stop?
                  (begin (gvec-erase! iterators i) (loop i (- size 1)))
                  (let ((links (sn-links node)))
                    ;; the other links get copies of the iterator, the first
                    ;; link continues this one
                    (for-each
                     (lambda (link)
                       (when (< (gvec-length iterators) max-iterator-count)
                         (let ((next (vector (vector-ref it 0) (vector-ref it 1)
                                             (vector-ref it 2) (vector-ref it 3))))
                           (gvec-push! iterators next)
                           (advance-iterator! next link goal))))
                     (cdr links))
                    (advance-iterator! it (car links) goal)
                    (loop (+ i 1) size))))))
        (outer)))
    slices))

(define (advance-iterator! it link goal)
  (vector-set! it 0 (link-node link))
  (let ((t (link-subtree link)))
    (if t
        (begin
          (when goal (vector-set! it 1 (cons t (vector-ref it 1))))
          (unless (st-extra? t)
            (vector-set! it 2 (+ (vector-ref it 2) 1))
            (unless (link-pending? link) (vector-set! it 3 #f))))
        (begin
          (vector-set! it 2 (+ (vector-ref it 2) 1))
          (vector-set! it 3 #f)))))

(define (slice-subtrees x) (vector-ref x 0))
(define (slice-version x) (vector-ref x 1))

(define (stack-pop-count! s v count)
  (stack-iter! s v (lambda (it) (if (= (vector-ref it 2) count) 'pop-stop 'none)) #t))

(define (stack-pop-pending! s v)
  (let ((pop (stack-iter! s v (lambda (it)
                                (if (>= (vector-ref it 2) 1)
                                    (if (vector-ref it 3) 'pop-stop 'stop)
                                    'none))
                          #t)))
    (when (> (gvec-length pop) 0)
      (stack-renumber-version! s (slice-version (gvec-ref pop 0)) v)
      (vector-set! (gvec-ref pop 0) 1 v))
    pop))

(define (stack-pop-error! s v)
  ;; the error at the top of the stack, as a list, or '()
  (let ((node (head-node (stack-head s v))))
    (if (ts-any (lambda (k) (and (link-subtree k) (st-error? (link-subtree k)))) (sn-links node))
        (let* ((found #f)
               (pop (stack-iter! s v (lambda (it)
                                       (if (pair? (vector-ref it 1))
                                           (if (and (not found) (st-error? (car (vector-ref it 1))))
                                               (begin (set! found #t) 'pop-stop)
                                               'stop)
                                           'none))
                                 #t)))
          (if (> (gvec-length pop) 0)
              (begin (stack-renumber-version! s (slice-version (gvec-ref pop 0)) v)
                     (slice-subtrees (gvec-ref pop 0)))
              '()))
        '())))

(define (stack-pop-all! s v)
  (stack-iter! s v (lambda (it) (if (null? (sn-links (vector-ref it 0))) 'pop 'none)) #t))

(define (stack-record-summary! s v max-depth)
  (let ((summary (make-gvec)))
    (stack-iter! s v
                 (lambda (it)
                   (let* ((node (vector-ref it 0))
                          (state (sn-state node))
                          (depth (vector-ref it 2)))
                     (if (> depth max-depth) 'stop
                         (begin
                           (unless (let loop ((i (- (gvec-length summary) 1)))
                                     (and (>= i 0)
                                          (let ((e (gvec-ref summary i)))
                                            (and (>= (vector-ref e 1) depth)
                                                 (or (and (= (vector-ref e 1) depth)
                                                          (= (vector-ref e 2) state))
                                                     (loop (- i 1)))))))
                             (gvec-push! summary (vector (sn-offset node) depth state (sn-rows node))))
                           'none))))
                 #f)
    (vector-set! (stack-head s v) 1 summary)))

(define (stack-has-advanced-since-error? s v)
  (let* ((h (stack-head s v)) (node (head-node h)))
    (or (= (sn-error-cost node) 0)
        (let loop ((node node))
          (and (pair? (sn-links node))
               (let ((t (link-subtree (car (sn-links node)))))
                 (and t
                      (cond ((> (st-total-bytes t) 0) #t)
                            ((and (> (sn-node-count node) (head-count-at-error h))
                                  (= (st-error-cost t) 0))
                             (loop (link-node (car (sn-links node)))))
                            (else #f)))))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; The lexer
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; The lexer works on #(text length position rows token-start token-start-rows
;; token-end token-end-rows result-symbol): text is a vector of code points.

(define (make-lexer text) (vector text (vector-length text) 0 0 0 0 -1 0 0))
(define (lexer-text lx) (vector-ref lx 0))
(define (lexer-length lx) (vector-ref lx 1))
(define-public (lexer-position lx) (vector-ref lx 2))
(define (lexer-rows lx) (vector-ref lx 3))
(define-public (lexer-eof? lx) (>= (vector-ref lx 2) (vector-ref lx 1)))
(define-public (lexer-lookahead lx)
  (if (lexer-eof? lx) 0 (vector-ref (vector-ref lx 0) (vector-ref lx 2))))

(define (lexer-reset! lx position rows)
  (vector-set! lx 2 position)
  (vector-set! lx 3 rows))

(define (lexer-start! lx)
  (vector-set! lx 4 (vector-ref lx 2))
  (vector-set! lx 5 (vector-ref lx 3))
  (vector-set! lx 6 -1)
  (vector-set! lx 8 0))

(define-public (lexer-advance! lx skip?)
  (unless (lexer-eof? lx)
    (when (= (lexer-lookahead lx) 10) (vector-set! lx 3 (+ (vector-ref lx 3) 1)))
    (vector-set! lx 2 (+ (vector-ref lx 2) 1)))
  (when skip?
    (vector-set! lx 4 (vector-ref lx 2))
    (vector-set! lx 5 (vector-ref lx 3))))

(define-public (lexer-mark-end! lx)
  (vector-set! lx 6 (vector-ref lx 2))
  (vector-set! lx 7 (vector-ref lx 3)))

(define-public (lexer-set-result! lx symbol) (vector-set! lx 8 symbol))

(define (lexer-finish! lx lookahead-end)
  ;; the new end of the lookahead
  (when (< (vector-ref lx 6) 0) (lexer-mark-end! lx))
  (max lookahead-end (+ (vector-ref lx 2) 1)))

(define-public (lexer-column lx)
  ;; the column of the current position
  (let ((text (lexer-text lx)))
    (let loop ((i (- (lexer-position lx) 1)) (col 0))
      (if (or (< i 0) (= (vector-ref text i) 10)) col (loop (- i 1) (+ col 1))))))

(define (lex-transition state c)
  ;; the advance action #(chars next in-main-token?) for the character c
  (let loop ((l (vector-ref state 2)))
    (cond ((null? l) #f)
          ((cs-contains? (vector-ref (car l) 0) c) (car l))
          (else (loop (cdr l))))))

(define (run-lex-table table start lx)
  ;; runs the DFA from the lex state start; whether a token was accepted
  (let loop ((id start) (result #f))
    (let* ((state (vector-ref table id))
           (accept (vector-ref state 0))
           (result (if accept
                       (begin (lexer-set-result! lx accept) (lexer-mark-end! lx) #t)
                       result)))
      (if (lexer-eof? lx)
          (let ((eof (vector-ref state 1)))
            (if eof (begin (lexer-advance! lx #f) (loop eof result)) result))
          (let ((a (lex-transition state (lexer-lookahead lx))))
            (if a
                (begin (lexer-advance! lx (not (vector-ref a 2)))
                       (loop (vector-ref a 1) result))
                result))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; The parser
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; a tree is a vector #(root language text)
(define-public (tree-root t) (vector-ref t 0))
(define-public (tree-language t) (vector-ref t 1))
(define-public (tree-text t) (vector-ref t 2))

(define-public (ts-parse-codes l text . opt)
  ;; the tree of a vector of code points; the optional argument is a tree
  ;; of a previous version of the text, edited with ts-tree-edit
  (let* ((old-tree (and (pair? opt) (car opt)))
         (stack (make-stack))
         (lx (make-lexer text))
         (finished #f)
         (accept-count 0)
         (cached-token #f) (cached-position -1) (cached-external #f)
         (reusable (make-reusable-node))
         (scanner (lang-external-scanner l))
         (scanner-payload (and scanner ((vector-ref scanner 0)))))
    (stack-clear! stack)
    (when old-tree (reusable-node-reset! reusable (tree-root old-tree)))
    (define (version-status v)
      (let ((cost (stack-error-cost stack v))
            (paused (stack-paused? stack v)))
        (vector (if paused (+ cost error-cost-per-skipped-tree) cost)
                (stack-node-count-since-error stack v)
                (stack-dynamic stack v)
                (or paused (= (stack-state stack v) error-state)))))
    (define (compare-versions a b)
      (let ((ca (vector-ref a 0)) (cb (vector-ref b 0))
            (ia (vector-ref a 3)) (ib (vector-ref b 3)))
        (cond ((and (not ia) ib) (if (< ca cb) 'take-left 'prefer-left))
              ((and ia (not ib)) (if (< cb ca) 'take-right 'prefer-right))
              ((< ca cb) (if (> (* (- cb ca) (+ 1 (vector-ref a 1))) max-cost-difference)
                             'take-left 'prefer-left))
              ((< cb ca) (if (> (* (- ca cb) (+ 1 (vector-ref b 1))) max-cost-difference)
                             'take-right 'prefer-right))
              ((> (vector-ref a 2) (vector-ref b 2)) 'prefer-left)
              ((> (vector-ref b 2) (vector-ref a 2)) 'prefer-right)
              (else 'none))))
    (define (better-version-exists? v in-error? cost)
      (or (and finished (<= (st-error-cost finished) cost))
          (let ((position (stack-offset stack v))
                (status (vector cost (stack-node-count-since-error stack v)
                                (stack-dynamic stack v) in-error?)))
            (let loop ((i 0))
              (and (< i (stack-version-count stack))
                   (or (and (not (= i v)) (stack-active? stack i)
                            (>= (stack-offset stack i) position)
                            (case (compare-versions status (version-status i))
                              ((take-right) #t)
                              ((prefer-right) (stack-can-merge? stack i v))
                              (else #f)))
                       (loop (+ i 1))))))))
    ;; lexing
    (define (lex v parse-state)
      (let ((mode (lang-lex-mode l parse-state)))
        (if (= (vector-ref mode 0) -1) #f
            (let* ((start (stack-offset stack v))
                   (start-rows (stack-rows stack v))
                   (external-token (stack-last-external stack v))
                   (error-mode (= parse-state error-state))
                   (found-external #f)
                   (skipped-error #f)
                   (first-error-char 0)
                   (error-start 0) (error-start-rows 0)
                   (error-end 0) (error-end-rows 0)
                   (lookahead-end 0)
                   (external-state-value #f)
                   (external-changed #f))
              (lexer-reset! lx start start-rows)
              (let loop ((mode mode))
                (let ((current (lexer-position lx))
                      (current-rows (lexer-rows lx))
                      (found #f))
                  (when (and scanner (> (vector-ref mode 1) 0))
                    (lexer-start! lx)
                    ((vector-ref scanner 2) scanner-payload (external-state external-token))
                    (set! found ((vector-ref scanner 1) scanner-payload lx
                                 (vector-ref (lang-external-states l) (vector-ref mode 1))))
                    (set! lookahead-end (lexer-finish! lx lookahead-end))
                    (when found
                      (set! external-state-value ((vector-ref scanner 3) scanner-payload))
                      (set! external-changed (not (equal? external-state-value
                                                          (external-state external-token))))
                      (when (and (<= (vector-ref lx 6) current) (not external-changed))
                        (let* ((symbol (vector-ref (lang-external-symbols l) (vector-ref lx 8)))
                               (next (lang-next-state l parse-state symbol)))
                          (when (or error-mode (not (stack-has-advanced-since-error? stack v))
                                    (= next parse-state))
                            (set! found #f)))))
                    (if found
                        (set! found-external #t)
                        (lexer-reset! lx current current-rows)))
                  (if found-external #t
                      (begin
                        (lexer-start! lx)
                        (let ((ok (run-lex-table (lang-lex-table l) (vector-ref mode 0) lx)))
                          (set! lookahead-end (lexer-finish! lx lookahead-end))
                          (cond (ok #t)
                                ((not error-mode)
                                 (set! error-mode #t)
                                 (lexer-reset! lx start start-rows)
                                 (loop (lang-lex-mode l error-state)))
                                (else
                                 (unless skipped-error
                                   (set! skipped-error #t)
                                   (set! error-start (vector-ref lx 4))
                                   (set! error-start-rows (vector-ref lx 5))
                                   (set! error-end error-start)
                                   (set! error-end-rows error-start-rows)
                                   (set! first-error-char (lexer-lookahead lx)))
                                 (if (and (= (lexer-position lx) error-end) (lexer-eof? lx))
                                     (begin (lexer-set-result! lx ts-sym-error) #t)
                                     (begin
                                       (when (= (lexer-position lx) error-end)
                                         (lexer-advance! lx #f))
                                       (set! error-end (lexer-position lx))
                                       (set! error-end-rows (lexer-rows lx))
                                       (loop mode))))))))))
              (if skipped-error
                  (new-error-leaf l first-error-char
                                  (- error-start start) (- error-start-rows start-rows)
                                  (- error-end error-start) (- error-end-rows error-start-rows)
                                  (- lookahead-end error-end) parse-state)
                  (let* ((symbol (vector-ref lx 8))
                         (token-start (vector-ref lx 4)) (token-start-rows (vector-ref lx 5))
                         (token-end (vector-ref lx 6)) (token-end-rows (vector-ref lx 7))
                         (keyword #f))
                    (cond (found-external
                           (set! symbol (vector-ref (lang-external-symbols l) symbol)))
                          ((and (= symbol (lang-keyword-capture l)) (not (= symbol 0)))
                           (lexer-reset! lx token-start token-start-rows)
                           (lexer-start! lx)
                           (set! keyword (run-lex-table (lang-keyword-table l) 0 lx))
                           (when (and keyword (= (vector-ref lx 6) token-end)
                                      (or (lang-has-actions? l parse-state (vector-ref lx 8))
                                          (lang-reserved-word? l parse-state (vector-ref lx 8))))
                             (set! symbol (vector-ref lx 8)))))
                    (let ((t (new-leaf l symbol (- token-start start) (- token-start-rows start-rows)
                                       (- token-end token-start) (- token-end-rows token-start-rows)
                                       (- lookahead-end token-end) parse-state
                                       found-external #f keyword)))
                      (when found-external
                        (vector-set! t 18 external-state-value)
                        (set-flag! t f-scanner-change external-changed))
                      t)))))))
    (define (can-reuse-first-leaf? state t entry)
      (let* ((leaf-symbol (st-leaf-symbol t))
             (leaf-state (st-leaf-parse-state t))
             (current-mode (lang-lex-mode l state))
             (leaf-mode (if (< leaf-state (lang-state-count l)) (lang-lex-mode l leaf-state) #f)))
        (cond ((= (vector-ref current-mode 0) -1) #f)
              ((and (> (vector-length (vector-ref entry 0)) 0)
                    (equal? leaf-mode current-mode)
                    (or (not (= leaf-symbol (lang-keyword-capture l)))
                        (and (not (st-keyword? t)) (= (st-parse-state t) state))))
               #t)
              ((and (= (st-size t) 0) (not (= leaf-symbol 0))) #f)
              (else (and (= (vector-ref current-mode 1) 0) (vector-ref entry 1))))))
    (define (get-cached-token state position last-external)
      (and cached-token (= cached-position position)
           (external-state-eq? cached-external last-external)
           (let ((entry (lang-entry l state (st-symbol cached-token))))
             (and (can-reuse-first-leaf? state cached-token entry)
                  (cons cached-token entry)))))
    ;; reusing the nodes of the old tree
    (define (reuse-node v state position last-external)
      ;; (tree state . entry) or #f
      (let loop ((state state))
        (let ((t (reusable-node-tree reusable)))
          (if (not t) #f
              (let* ((offset (reusable-node-offset reusable))
                     (end (if (st-eof? t) 1000000000 (+ offset (st-total-bytes t)))))
                (cond ((> offset position) #f)
                      ((< offset position)
                       (when (or (<= end position) (not (reusable-node-descend! reusable)))
                         (reusable-node-advance! reusable))
                       (loop state))
                      ((not (external-state-eq? (reusable-node-last-external reusable) last-external))
                       (reusable-node-advance! reusable)
                       (loop state))
                      ((or (st-has-changes? t) (st-error? t) (st-missing? t) (st-fragile? t))
                       (if (reusable-node-descend! reusable)
                           (loop state)
                           (begin
                             (reusable-node-advance! reusable)
                             (breakdown-top-of-stack! v)
                             (loop (stack-state stack v)))))
                      (else
                       (let ((entry (lang-entry l state (st-leaf-symbol t))))
                         (if (can-reuse-first-leaf? state t entry)
                             (cons t (cons state entry))
                             (begin (reusable-node-advance-past-leaf! reusable) #f))))))))))
    (define (breakdown-top-of-stack! v)
      (let loop ((did #f))
        (let ((pop (stack-pop-pending! stack v)))
          (if (= (gvec-length pop) 0) did
              (let ((pending #f))
                (gvec-for-each
                 (lambda (slice)
                   (let* ((sv (slice-version slice))
                          (state (stack-state stack sv))
                          (subtrees (slice-subtrees slice))
                          (parent (car subtrees)))
                     (do ((j 0 (+ j 1))) ((= j (st-child-count parent)))
                       (let ((child (st-child parent j)))
                         (set! pending (> (st-child-count child) 0))
                         (cond ((st-error? child) (set! state error-state))
                               ((not (st-extra? child))
                                (set! state (lang-next-state l state (st-symbol child)))))
                         (stack-push! stack sv child pending state)))
                     (for-each (lambda (t) (stack-push! stack sv t #f state)) (cdr subtrees))))
                 pop)
                (if pending (loop #t) #t))))))
    (define (breakdown-lookahead lookahead state)
      ;; the subtree of the old tree which starts at the lookahead with the
      ;; right parse state
      (let loop ((t (reusable-node-tree reusable)) (did #f))
        (if (and t (> (st-child-count t) 0) (not (= (st-parse-state t) state)))
            (begin (reusable-node-descend! reusable)
                   (loop (reusable-node-tree reusable) #t))
            (if did t lookahead))))
    ;; actions
    (define (select-tree? left right)
      ;; should right replace left?
      (cond ((not left) #t)
            ((not right) #f)
            ((< (st-error-cost right) (st-error-cost left)) #t)
            ((< (st-error-cost left) (st-error-cost right)) #f)
            ((> (st-dynamic-precedence right) (st-dynamic-precedence left)) #t)
            ((> (st-dynamic-precedence left) (st-dynamic-precedence right)) #f)
            ((> (st-error-cost left) 0) #t)
            (else (= (st-compare left right) 1))))
    (define (shift! v state lookahead extra?)
      (let* ((leaf? (= (st-child-count lookahead) 0))
             (t (if (and leaf? (not (eq? extra? (st-extra? lookahead))))
                    (let ((c (st-copy lookahead))) (set-flag! c f-extra extra?) c)
                    lookahead)))
        (stack-push! stack v t (not leaf?) state)
        (when (st-has-external-tokens? t)
          (stack-set-last-external! stack v (st-last-external-token t)))))
    (define (reduce! v symbol count dynamic production-id fragile? end-of-extra?)
      (let* ((initial-count (stack-version-count stack))
             (pop (stack-pop-count! stack v count))
             (n (gvec-length pop))
             (removed 0)
             (halted (stack-halted-count stack)))
        (let loop ((i 0))
          (when (< i n)
            (let* ((slice (gvec-ref pop i))
                   (sv (- (slice-version slice) removed)))
              (if (> sv (+ max-version-count max-version-count-overflow halted))
                  (begin
                    (stack-remove-version! stack sv)
                    (set! removed (+ removed 1))
                    (let skip ((i i))
                      (if (and (< (+ i 1) n)
                               (= (slice-version (gvec-ref pop (+ i 1))) (slice-version slice)))
                          (skip (+ i 1))
                          (loop (+ i 1)))))
                  (let* ((split (remove-trailing-extras (slice-subtrees slice)))
                         (parent (new-node l symbol (car split) production-id))
                         (extras (cdr split)))
                    (let merge-paths ((i i))
                      (if (and (< (+ i 1) n)
                               (= (slice-version (gvec-ref pop (+ i 1))) (slice-version slice)))
                          (let* ((next (gvec-ref pop (+ i 1)))
                                 (split2 (remove-trailing-extras (slice-subtrees next))))
                            (when (select-tree? parent (new-node l symbol (car split2) 0))
                              (set! parent (new-node l symbol (car split2) production-id))
                              (set! extras (cdr split2)))
                            (merge-paths (+ i 1)))
                          (let* ((state (stack-state stack sv))
                                 (next-state (lang-next-state l state symbol)))
                            (when (and end-of-extra? (= next-state state))
                              (set-flag! parent f-extra #t))
                            (if (or fragile? (> n 1) (> initial-count 1))
                                (begin (set-flag! parent f-fragile-left #t)
                                       (set-flag! parent f-fragile-right #t)
                                       (vector-set! parent 6 state-none))
                                (vector-set! parent 6 state))
                            (vector-set! parent 10 (+ (vector-ref parent 10) dynamic))
                            (stack-push! stack sv parent #f next-state)
                            (for-each (lambda (t) (stack-push! stack sv t #f next-state)) extras)
                            (let merge ((j 0))
                              (when (< j sv)
                                (if (and (not (= j v)) (stack-merge! stack j sv))
                                    (set! removed (+ removed 1))
                                    (merge (+ j 1)))))
                            (loop (+ i 1))))))))))
        (if (> (stack-version-count stack) initial-count) initial-count #f)))
    (define (accept! v lookahead)
      (stack-push! stack v lookahead #f 1)
      (let ((pop (stack-pop-all! stack v)))
        (gvec-for-each
         (lambda (slice)
           (let* ((trees (slice-subtrees slice))
                  (root (let loop ((r (reverse trees)) (after '()))
                          (cond ((null? r) #f)
                                ((not (st-extra? (car r)))
                                 (let ((t (car r)))
                                   (new-node l (st-symbol t)
                                             (append (reverse (cdr r))
                                                     (if (st-children t) (vector->list (st-children t)) '())
                                                     after)
                                             (st-production-id t))))
                                (else (loop (cdr r) (cons (car r) after)))))))
             (set! accept-count (+ accept-count 1))
             (when (select-tree? finished root) (set! finished root))))
         pop)
        (stack-remove-version! stack (slice-version (gvec-ref pop 0)))
        (stack-halt! stack v)))
    (define (do-all-potential-reductions! starting-version lookahead-symbol)
      (let ((initial-count (stack-version-count stack))
            (can-shift #f))
        (let loop ((version starting-version) (i 0))
          (let ((count (stack-version-count stack)))
            (when (< version count)
              (if (let merged ((j initial-count))
                    (and (< j version)
                         (or (stack-merge! stack j version) (merged (+ j 1)))))
                  (loop version (+ i 1))
                  (let* ((state (stack-state stack version))
                         (has-shift #f)
                         (reduce-actions '()))
                    (define (process-actions! actions)
                      (let ((shift #f))
                        (vector-for-each*
                         (lambda (a)
                           (case (vector-ref a 0)
                             ((shift recover)
                              (when (and (eq? (vector-ref a 0) 'shift)
                                         (not (vector-ref a 2)) (not (vector-ref a 3)))
                                (set! shift #t))
                              (when (eq? (vector-ref a 0) 'recover) (set! shift #t)))
                             ((reduce)
                              (when (> (vector-ref a 2) 0)
                                (unless (ts-any (lambda (r) (and (= (vector-ref r 1) (vector-ref a 1))
                                                                 (= (vector-ref r 2) (vector-ref a 2))))
                                                reduce-actions)
                                  (set! reduce-actions (append reduce-actions (list a))))))))
                         actions)
                        shift))
                    (if (not (= lookahead-symbol 0))
                        (set! has-shift (process-actions! (vector-ref (lang-entry l state lookahead-symbol) 0)))
                        (begin
                          (for-each (lambda (s)
                                      (unless (= s 0)
                                        (when (process-actions! (vector-ref (lang-entry l state s) 0))
                                          (set! has-shift #t))))
                                    (lang-lookaheads l state))
                          (set! reduce-actions (ts-sort reduce-actions
                                                        (lambda (a b) (> (vector-ref a 1) (vector-ref b 1)))))))
                    (let ((reduction-version #f))
                      (for-each (lambda (a)
                                  (set! reduction-version
                                        (reduce! version (vector-ref a 1) (vector-ref a 2)
                                                 (vector-ref a 3) (vector-ref a 4) #t #f)))
                                reduce-actions)
                      (cond (has-shift
                             (set! can-shift #t)
                             (loop (if (= version starting-version) count (+ version 1)) (+ i 1)))
                            ((and reduction-version (< i max-version-count))
                             (stack-renumber-version! stack reduction-version version)
                             (loop version (+ i 1)))
                            ((not (= lookahead-symbol 0))
                             (stack-remove-version! stack version)
                             (loop version (+ i 1)))
                            (else
                             (loop (if (= version starting-version) count (+ version 1)) (+ i 1))))))))))
        can-shift))
    (define (recover-to-state! v depth goal-state)
      (let ((pop (stack-pop-count! stack v depth))
            (previous #f))
        (gvec-for-each
         (lambda (slice)
           (let ((sv (slice-version slice)))
             (cond ((eqv? sv previous) #t)
                   ((not (= (stack-state stack sv) goal-state))
                    (stack-halt! stack sv))
                   (else
                    (let* ((error-trees (stack-pop-error! stack sv))
                           (subtrees (slice-subtrees slice))
                           (subtrees (if (and (pair? error-trees)
                                              (> (st-child-count (car error-trees)) 0))
                                         (cons (new-node l ts-sym-error-repeat
                                                         (vector->list (st-children (car error-trees))) 0)
                                               subtrees)
                                         subtrees))
                           (split (remove-trailing-extras subtrees)))
                      (when (pair? (car split))
                        (stack-push! stack sv (new-error-node l (car split) #t) #f goal-state))
                      (for-each (lambda (t) (stack-push! stack sv t #f goal-state)) (cdr split))
                      (set! previous sv))))))
         pop)
        (and previous #t)))
    (define (recover! v lookahead)
      (let* ((did-recover #f)
             (previous-count (stack-version-count stack))
             (position (stack-offset stack v))
             (position-rows (stack-rows stack v))
             (summary (stack-summary stack v))
             (node-count-since-error (stack-node-count-since-error stack v))
             (current-error-cost (stack-error-cost stack v)))
        (when (and summary (not (st-error? lookahead)))
          (let loop ((i 0))
            (when (< i (gvec-length summary))
              (let* ((e (gvec-ref summary i))
                     (e-offset (vector-ref e 0)) (e-depth (vector-ref e 1))
                     (e-state (vector-ref e 2)) (e-rows (vector-ref e 3)))
                (if (or (= e-state error-state) (= e-offset position)
                        (let would-merge ((j 0))
                          (and (< j previous-count)
                               (or (and (= (stack-state stack j) e-state)
                                        (= (stack-offset stack j) position))
                                   (would-merge (+ j 1))))))
                    (loop (+ i 1))
                    (let ((depth (if (> node-count-since-error 0) (+ e-depth 1) e-depth))
                          (new-cost (+ current-error-cost
                                       (* e-depth error-cost-per-skipped-tree)
                                       (* (- position e-offset) error-cost-per-skipped-char)
                                       (* (- position-rows e-rows) error-cost-per-skipped-line))))
                      (unless (better-version-exists? v #f new-cost)
                        (if (and (lang-has-actions? l e-state (st-symbol lookahead))
                                 (recover-to-state! v depth e-state))
                            (set! did-recover #t)
                            (loop (+ i 1))))))))))
        (let loop ((i previous-count))
          (when (< i (stack-version-count stack))
            (if (not (stack-active? stack i))
                (begin (stack-remove-version! stack i) (loop i))
                (loop (+ i 1)))))
        (cond
         ((st-eof? lookahead)
          (stack-push! stack v (new-error-node l '() #f) #f 1)
          (accept! v lookahead))
         ((and did-recover (> (stack-version-count stack) max-version-count))
          (stack-halt! stack v))
         ((and did-recover (st-scanner-change? lookahead))
          (stack-halt! stack v))
         ((better-version-exists? v #f (+ current-error-cost error-cost-per-skipped-tree
                                          (* (st-total-bytes lookahead) error-cost-per-skipped-char)
                                          (* (st-total-rows lookahead) error-cost-per-skipped-line)))
          (stack-halt! stack v))
         (else
          (let* ((actions (vector-ref (lang-entry l 1 (st-symbol lookahead)) 0))
                 (n (vector-length actions))
                 (lookahead (if (and (> n 0)
                                     (eq? (vector-ref (vector-ref actions (- n 1)) 0) 'shift)
                                     (vector-ref (vector-ref actions (- n 1)) 2))
                                (let ((c (st-copy lookahead))) (set-flag! c f-extra #t) c)
                                lookahead))
                 (error-repeat (new-node l ts-sym-error-repeat (list lookahead) 0)))
            (when (> node-count-since-error 0)
              (let ((pop (stack-pop-count! stack v 1)))
                (when (> (gvec-length pop) 1)
                  (let ((v0 (slice-version (gvec-ref pop 0))))
                    (let drop () (when (> (stack-version-count stack) (+ v0 1))
                                   (stack-remove-version! stack (+ v0 1)) (drop)))))
                (stack-renumber-version! stack (slice-version (gvec-ref pop 0)) v)
                (set! error-repeat (new-node l ts-sym-error-repeat
                                             (append (slice-subtrees (gvec-ref pop 0))
                                                     (list error-repeat))
                                             0))))
            (stack-push! stack v error-repeat #f error-state)
            (when (st-has-external-tokens? lookahead)
              (stack-set-last-external! stack v (st-last-external-token lookahead))))))))
    (define (handle-error! v lookahead)
      (let ((previous-count (stack-version-count stack)))
        (do-all-potential-reductions! v 0)
        (let ((version-count (stack-version-count stack))
              (position (stack-offset stack v))
              (position-rows (stack-rows stack v))
              (did-insert-missing #f))
          (let loop ((w v))
            (when (< w version-count)
              (unless did-insert-missing
                (let ((state (stack-state stack w)))
                  (let try ((missing 1))
                    (when (< missing (lang-token-count l))
                      (let ((after (lang-next-state l state missing)))
                        (if (and (not (= after 0)) (not (= after state))
                                 (lang-has-reduce-action? l after (st-leaf-symbol lookahead)))
                            (begin
                              (stack-copy-version! stack w)
                              (let ((with-missing (- (stack-version-count stack) 1))
                                    (t (new-missing-leaf l missing state 0 0
                                                         (+ (st-total-bytes lookahead)
                                                            (st-lookahead-bytes lookahead)))))
                                (stack-push! stack with-missing t #f after)
                                (if (do-all-potential-reductions! with-missing (st-leaf-symbol lookahead))
                                    (set! did-insert-missing #t)
                                    (try (+ missing 1)))))
                            (try (+ missing 1))))))))
              (stack-push! stack w #f #f error-state)
              (loop (if (= w v) previous-count (+ w 1)))))
          (do ((i previous-count (+ i 1))) ((>= i version-count))
            (stack-merge! stack v previous-count))
          (stack-record-summary! stack v max-summary-depth)
          (recover! v (if (> (st-child-count lookahead) 0)
                          (breakdown-lookahead lookahead error-state)
                          lookahead)))))
    (define (advance! v allow-reuse)
      (let* ((state (stack-state stack v))
             (position (stack-offset stack v))
             (last-external (stack-last-external stack v))
             (did-reuse #f)
             (lookahead #f)
             (entry #f)
             (needs-lex #t))
        (let ((r (and allow-reuse old-tree (reuse-node v state position last-external))))
          (when r
            (set! lookahead (car r)) (set! state (cadr r)) (set! entry (cddr r))
            (set! did-reuse #t) (set! needs-lex #f)))
        (unless lookahead
          (let ((c (get-cached-token state position last-external)))
            (when c (set! lookahead (car c)) (set! entry (cdr c)) (set! needs-lex #f))))
        (let loop ()
          (when needs-lex
            (set! needs-lex #f)
            (set! lookahead (lex v state))
            (if lookahead
                (begin (set! cached-token lookahead) (set! cached-position position)
                       (set! cached-external last-external)
                       (set! entry (lang-entry l state (st-symbol lookahead))))
                (set! entry (lang-entry l state 0))))
          (let* ((actions (vector-ref entry 0))
                 (n (vector-length actions))
                 (last-reduction #f)
                 (did-reduce #f))
            (let each ((i 0))
              (if (< i n)
                  (let ((a (vector-ref actions i)))
                    (case (vector-ref a 0)
                      ((shift)
                       (if (vector-ref a 3) (each (+ i 1))
                           (let ((next (if (vector-ref a 2) state (vector-ref a 1))))
                             (when (> (st-child-count lookahead) 0)
                               (set! lookahead (breakdown-lookahead lookahead state))
                               (set! next (lang-next-state l state (st-symbol lookahead))))
                             (shift! v next lookahead (vector-ref a 2))
                             (when did-reuse (reusable-node-advance! reusable))
                             'done)))
                      ((reduce)
                       (let ((rv (reduce! v (vector-ref a 1) (vector-ref a 2) (vector-ref a 3)
                                          (vector-ref a 4) (> n 1) (not lookahead))))
                         (set! did-reduce #t)
                         (when rv (set! last-reduction rv))
                         (each (+ i 1))))
                      ((accept) (accept! v lookahead) 'done)
                      ((recover)
                       (when (> (st-child-count lookahead) 0)
                         (set! lookahead (breakdown-lookahead lookahead error-state)))
                       (recover! v lookahead)
                       (when did-reuse (reusable-node-advance! reusable))
                       'done)))
                  (cond
                   (last-reduction
                    (stack-renumber-version! stack last-reduction v)
                    (set! state (stack-state stack v))
                    (if lookahead
                        (set! entry (lang-entry l state (st-leaf-symbol lookahead)))
                        (set! needs-lex #t))
                    (loop))
                   (did-reduce (stack-halt! stack v))
                   ((and (st-keyword? lookahead)
                         (not (= (st-symbol lookahead) (lang-keyword-capture l)))
                         (not (lang-reserved-word? l state (st-symbol lookahead)))
                         (> (vector-length (vector-ref (lang-entry l state (lang-keyword-capture l)) 0)) 0))
                    (set! entry (lang-entry l state (lang-keyword-capture l)))
                    (let ((c (st-copy lookahead))
                          (w (lang-keyword-capture l)))
                      (vector-set! c 0 w)
                      (vector-set! c 17 (logior (logand (vector-ref c 17) (- -1 (logior f-visible f-named)))
                                                (metadata-flags l w)))
                      (set! lookahead c))
                    (loop))
                   ((= state error-state) (recover! v lookahead))
                   ((breakdown-top-of-stack! v)
                    (set! state (stack-state stack v))
                    (set! needs-lex #t)
                    (loop))
                   (else (stack-pause! stack v lookahead)))))))))
    (define (condense-stack!)
      (let ((min-error-cost 1000000000))
        (let loop ((i 0))
          (when (< i (stack-version-count stack))
            (if (stack-halted? stack i)
                (begin (stack-remove-version! stack i) (loop i))
                (let ((status-i (version-status i)))
                  (when (and (not (vector-ref status-i 3)) (< (vector-ref status-i 0) min-error-cost))
                    (set! min-error-cost (vector-ref status-i 0)))
                  (let inner ((j 0) (i i))
                    (if (< j i)
                        (case (compare-versions (version-status j) status-i)
                          ((take-left)
                           (stack-remove-version! stack i)
                           (loop i))
                          ((prefer-left none)
                           (if (stack-merge! stack j i) (loop i) (inner (+ j 1) i)))
                          ((prefer-right)
                           (if (stack-merge! stack j i) (loop i)
                               (begin (stack-swap-versions! stack i j) (inner (+ j 1) i))))
                          ((take-right)
                           (stack-remove-version! stack j)
                           (inner j (- i 1))))
                        (loop (+ i 1))))))))
        (let loop ()
          (when (> (stack-version-count stack) max-version-count)
            (stack-remove-version! stack max-version-count)
            (loop)))
        (when (> (stack-version-count stack) 0)
          (let loop ((i 0) (n (stack-version-count stack)) (has-unpaused #f))
            (when (< i n)
              (if (stack-paused? stack i)
                  (if (and (not has-unpaused) (< accept-count max-version-count))
                      (begin
                        (set! min-error-cost (stack-error-cost stack i))
                        (handle-error! i (stack-resume! stack i))
                        (loop (+ i 1) n #t))
                      (begin (stack-remove-version! stack i) (loop i (- n 1) has-unpaused)))
                  (loop (+ i 1) n #t)))))
        min-error-cost))
    ;; the main loop
    (let outer ((last-position 0))
      (let ((position 0) (last-position last-position))
        (let versions ((v 0))
          (when (< v (stack-version-count stack))
            (let ((allow-reuse (= (stack-version-count stack) 1)))
              (let run ()
                (when (stack-active? stack v)
                  (advance! v allow-reuse)
                  (set! position (stack-offset stack v))
                  (if (or (> position last-position) (and (> v 0) (= position last-position)))
                      (set! last-position position)
                      (run)))))
            (versions (+ v 1))))
        (let ((min-error-cost (condense-stack!)))
          (if (and finished (< (st-error-cost finished) min-error-cost))
              (stack-clear! stack)
              (when (> (stack-version-count stack) 0)
                (outer last-position))))))
    (vector finished l text)))

(define (vector-for-each* fun v)
  (do ((i 0 (+ i 1))) ((= i (vector-length v))) (fun (vector-ref v i))))

(define-public (ts-parse-string l s . opt)
  ;; the tree of a string in UTF-8
  (apply ts-parse-codes l (list->vector (utf8->codes s)) opt))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Reusable nodes of an old tree
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; #(stack last-external) where the stack is a list of #(tree child-index offset)
(define (make-reusable-node) (vector '() #f))
(define (reusable-node-tree r) (and (pair? (vector-ref r 0)) (vector-ref (car (vector-ref r 0)) 0)))
(define (reusable-node-offset r)
  (if (pair? (vector-ref r 0)) (vector-ref (car (vector-ref r 0)) 2) 1000000000))
(define (reusable-node-last-external r) (vector-ref r 1))

(define (reusable-node-reset! r tree)
  (vector-set! r 0 (list (vector tree 0 0)))
  (vector-set! r 1 #f)
  (unless (reusable-node-descend! r) (vector-set! r 0 '())))

(define (reusable-node-descend! r)
  (let ((top (car (vector-ref r 0))))
    (and (> (st-child-count (vector-ref top 0)) 0)
         (begin
           (vector-set! r 0 (cons (vector (st-child (vector-ref top 0) 0) 0 (vector-ref top 2))
                                  (vector-ref r 0)))
           #t))))

(define (reusable-node-advance! r)
  (let* ((last (car (vector-ref r 0)))
         (offset (+ (vector-ref last 2) (st-total-bytes (vector-ref last 0)))))
    (when (st-has-external-tokens? (vector-ref last 0))
      (vector-set! r 1 (st-last-external-token (vector-ref last 0))))
    (let loop ((stack (vector-ref r 0)))
      (let ((next-index (+ (vector-ref (car stack) 1) 1))
            (rest (cdr stack)))
        (if (null? rest)
            (vector-set! r 0 '())
            (let ((tree (vector-ref (car rest) 0)))
              (if (<= (st-child-count tree) next-index)
                  (loop rest)
                  (vector-set! r 0 (cons (vector (st-child tree next-index) next-index offset)
                                         rest)))))))))

(define (reusable-node-advance-past-leaf! r)
  (let loop () (when (reusable-node-descend! r) (loop)))
  (reusable-node-advance! r))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Editing a tree
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define-public (ts-tree-edit tree new-text start old-end new-end)
  ;; the tree of a text where the code points start..old-end were replaced
  ;; by start..new-end of new-text: the subtrees which touch the edit are
  ;; marked as changed (and copied), so that ts-parse-codes reuses the others
  (define (rows-in text from to)
    (let loop ((i from) (n 0))
      (if (>= i to) n (loop (+ i 1) (if (= (vector-ref text i) 10) (+ n 1) n)))))
  (let ((old-text (tree-text tree)))
    (define (edit t offset)
      ;; t starts (with its padding) at offset of the old text
      (let* ((padding-end (+ offset (st-padding t)))
             (end (+ padding-end (st-size t)))
             (lookahead-end (+ end (st-lookahead-bytes t))))
        (cond ((< lookahead-end start) t)
              ((> offset old-end)
               t)
              (else
               (let ((c (st-copy t))
                     (delta (- new-end old-end)))
                 (set-flag! c f-has-changes #t)
                 ;; the new padding and size, in the new text
                 (cond ((< start padding-end)
                        ;; the edit starts in the padding
                        (let ((new-padding-end (if (<= old-end padding-end)
                                                   (+ padding-end delta)
                                                   new-end)))
                          (vector-set! c 1 (- new-padding-end offset))
                          (vector-set! c 2 (rows-in new-text offset new-padding-end))
                          (let ((new-end-pos (if (<= old-end end) (+ end delta) new-padding-end)))
                            (vector-set! c 3 (max 0 (- new-end-pos new-padding-end)))
                            (vector-set! c 4 (rows-in new-text new-padding-end
                                                      (+ new-padding-end (vector-ref c 3)))))))
                       ((<= start end)
                        (let ((new-end-pos (if (<= old-end end) (+ end delta) new-end)))
                          (vector-set! c 3 (- new-end-pos padding-end))
                          (vector-set! c 4 (rows-in new-text padding-end new-end-pos))))
                       (else #t))
                 (when (st-children c)
                   (let ((children (vector-copy*** (st-children c))))
                     (let loop ((i 0) (pos offset))
                       (when (< i (vector-length children))
                         (let ((child (vector-ref children i)))
                           (vector-set! children i (edit child pos))
                           (loop (+ i 1) (+ pos (st-total-bytes child))))))
                     (vector-set! c 7 children)))
                 c)))))
    (vector (edit (tree-root tree) 0) (tree-language tree) new-text)))

(define (vector-copy*** v)
  (let* ((n (vector-length v)) (r (make-vector n #f)))
    (do ((i 0 (+ i 1))) ((= i n) r) (vector-set! r i (vector-ref v i)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Nodes
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; A node is a vector #(subtree start alias field) where start is the offset
;; of the subtree (with its padding), alias the alias symbol or 0 and field
;; the field name or #f.

(define-public (node-subtree n) (vector-ref n 0))
(define-public (node-start-offset n) (+ (vector-ref n 1) (st-padding (vector-ref n 0))))
(define-public (node-end-offset n) (+ (node-start-offset n) (st-size (vector-ref n 0))))
(define-public (node-field n) (vector-ref n 3))

(define-public (node-symbol l n)
  (let ((alias (vector-ref n 2)))
    (if (and alias (not (= alias 0))) alias (st-symbol (vector-ref n 0)))))

(define-public (node-type l n) (lang-symbol-name l (node-symbol l n)))

(define-public (node-named? l n)
  (let ((alias (vector-ref n 2)))
    (if (and alias (not (= alias 0))) (lang-named? l alias) (st-named? (vector-ref n 0)))))

(define (node-visible? l n)
  (let ((alias (vector-ref n 2)))
    (or (and alias (not (= alias 0))) (st-visible? (vector-ref n 0)))))

(define-public (tree-root-node tree) (vector (tree-root tree) 0 0 #f))

(define-public (node-children l n)
  ;; the visible children, looking through the hidden ones, with their fields
  (let ((result '()))
    (define (field-of fields index inherited?)
      (let loop ((f fields))
        (cond ((null? f) #f)
              ((and (= (vector-ref (car f) 1) index) (eq? (vector-ref (car f) 2) inherited?))
               (vector-ref (car f) 0))
              (else (loop (cdr f))))))
    (define (walk t offset inherited-field)
      (let* ((children (st-children t))
             (production (st-production-id t))
             (fields (if (>= (st-symbol t) 0) (vector-ref (lang-field-maps l) production) '()))
             (structural 0))
        (when children
          (let loop ((i 0) (offset offset))
            (when (< i (vector-length children))
              (let* ((child (vector-ref children i))
                     (extra (st-extra? child))
                     (alias (if (or extra (< (st-symbol t) 0)) 0 (lang-alias-at l production structural)))
                     (field (and (not extra)
                                 (or (field-of fields structural #f) inherited-field)))
                     (node (vector child offset alias field)))
                (if (node-visible? l node)
                    (set! result (cons node result))
                    (when (> (st-child-count child) 0)
                      (walk child offset
                            (and (not extra) (or (field-of fields structural #f)
                                                 inherited-field)))))
                (unless extra (set! structural (+ structural 1)))
                (loop (+ i 1) (+ offset (st-total-bytes child)))))))))
    (walk (node-subtree n) (vector-ref n 1) #f)
    (reverse result)))

(define-public (ts-node->string l n)
  ;; the S-expression of tree-sitter (ts_node_string): named nodes only
  (define (show n)
    (let* ((t (node-subtree n))
           (children (ts-filter (lambda (c) (or (node-named? l c) (st-missing? (node-subtree c))))
                                (node-children l n)))
           (head (cond ((st-missing? t)
                        (string-append "MISSING "
                                       (if (node-named? l n) (node-type l n)
                                           (string-append "\"" (node-type l n) "\""))))
                       (else (node-type l n)))))
      (string-append
       "(" head
       (apply string-append
              (ts-map (lambda (c)
                        (string-append " " (if (node-field c) (string-append (node-field c) ": ") "")
                                       (show c)))
                      children))
       ")")))
  (show n))

(define-public (ts-tree->string tree)
  (ts-node->string (tree-language tree) (tree-root-node tree)))
