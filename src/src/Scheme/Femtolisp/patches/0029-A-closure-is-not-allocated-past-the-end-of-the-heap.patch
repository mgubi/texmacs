From a70e41e5e21c36c7fce2d9d3ac913aacd626cac4 Mon Sep 17 00:00:00 2001
From: tm <tm@x>
Date: Sun, 18 Oct 2026 19:05:28 +0100
Subject: [PATCH] A closure is not allocated past the end of the heap

OP_CLOSURE checked curheap > lim-2, which is 2 bytes, before writing 4
words, and gc did not leave room for them: a closure could be written up
to 16 bytes past the heap. Both now count words, as in Julia's femtolisp
(1a81a4770c).
---
 flisp.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/flisp.c b/flisp.c
index a91f0aa..ec5927f 100644
--- a/flisp.c
+++ b/flisp.c
@@ -625,7 +625,10 @@ void gc(int mustgrow)
         }
         grew = !grew;
     }
-    if (curheap > lim)  // all data was live
+    // all data was live: gc again and grow the heap, but always leave 4
+    // words, so that a closure is allocated without another check (TeXmacs,
+    // from Julia's femtolisp: lim-2 was 2 bytes, not 2 words)
+    if ((value_t*)curheap > ((value_t*)lim)-2)
         gc(0);
 }
 
@@ -1794,7 +1797,7 @@ static value_t apply_cl(uint32_t nargs)
             else {
                 PUSH(Stack[bp]); // env has already been captured; share
             }
-            if (curheap > lim-2)
+            if ((value_t*)curheap > ((value_t*)lim)-2)
                 gc(0);
             pv = (value_t*)curheap;
             curheap += (4*sizeof(value_t));
