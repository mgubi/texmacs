From f843282d9f713fc4783b269ea5e3f438d91b7295 Mon Sep 17 00:00:00 2001
From: tm <tm@x>
Date: Tue, 6 Oct 2026 20:21:59 +0100
Subject: [PATCH 17/20] < and = with any number of arguments (nary<, nary=);
 boot image regenerated

---
 compiler.lsp |   7 +-
 flisp.boot   | 186 ++++++++++++++++++++++++++-------------------------
 system.lsp   |   8 +++
 3 files changed, 109 insertions(+), 92 deletions(-)

diff --git a/compiler.lsp b/compiler.lsp
index 63b2b7b..9244206 100644
--- a/compiler.lsp
+++ b/compiler.lsp
@@ -414,6 +414,11 @@
 		    (builtin? (top-level-value ghead)))
 	       (top-level-value ghead)
 	       head)))
+      (if (and (or (eq? head <) (eq? head =))
+	       (not (length= x 3)))
+	  ; TeXmacs: n-ary < and =
+	  (compile-in g env tail?
+		      (cons (if (eq? head <) 'nary< 'nary=) (cdr x)))
       (if (length> (cdr x) 255)
 	  ; more than 255 arguments, need long versions of instructions
 	  (begin (compile-in g env #f head)
@@ -435,7 +440,7 @@
 		  (let ((nargs (compile-arglist g env (cdr x))))
 		    (if b
 			(compile-builtin-call g env tail? x head b nargs)
-			(emit g (if tail? 'tcall 'call) nargs))))))))))
+			(emit g (if tail? 'tcall 'call) nargs)))))))))))
 
 (define (expand-define x)
   (let ((form (cadr x))
