+;; TeXmacs: < and = with any number of arguments (the compiler calls these
+;; when the number is not 2)
+(define (nary-compare test l)
+  (or (null? l) (null? (cdr l))
+      (and (test (car l) (cadr l)) (nary-compare test (cdr l)))))
+(define (nary< . l) (nary-compare (lambda (a b) (< a b)) l))
+(define (nary= . l) (nary-compare (lambda (a b) (= a b)) l))
+
