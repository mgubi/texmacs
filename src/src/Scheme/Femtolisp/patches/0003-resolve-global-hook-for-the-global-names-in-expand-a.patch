From 2aaafc653843d7176fd0f5c5a35e21623606869b Mon Sep 17 00:00:00 2001
From: tm <tm@x>
Date: Tue, 6 Oct 2026 16:26:21 +0100
Subject: [PATCH 03/20] resolve-global: hook for the global names in expand and
 compile (modules of TeXmacs); boot image regenerated

---
 compiler.lsp | 26 +++++++++------
 flisp.boot   | 89 ++++++++++++++++++++++++++--------------------------
 system.lsp   | 14 ++++++---
 3 files changed, 71 insertions(+), 58 deletions(-)

diff --git a/compiler.lsp b/compiler.lsp
index 1a459dc..a0fa203 100644
--- a/compiler.lsp
+++ b/compiler.lsp
@@ -249,10 +249,11 @@
 			       ; update index of most distant captured frame
 	                       (bcode:cdepth g (- (nnn (cdr env)) 1 (car loc))))
 	  (else
-	   (if (and (constant? s)
-		    (printable? (top-level-value s)))
-	       (emit g 'loadv (top-level-value s))
-	       (emit g (aref Is 2) s))))))
+	   (let ((s (resolve-global s)))
+	     (if (and (constant? s)
+		      (printable? (top-level-value s)))
+		 (emit g 'loadv (top-level-value s))
+		 (emit g (aref Is 2) s)))))))
 
 (define (compile-if g env tail? x)
   (let ((elsel (make-label g))
@@ -393,14 +394,17 @@
       (else      (emit g b)))))
 
 (define (compile-app g env tail? x)
-  (let ((head  (car x)))
+  (let* ((head  (car x))
+	 (ghead (if (and (symbol? head) (not (in-env? head env)))
+		    (resolve-global head)
+		    head)))
     (let ((head
 	   (if (and (symbol? head)
 		    (not (in-env? head env))
-		    (bound? head)
-		    (constant? head)
-		    (builtin? (top-level-value head)))
-	       (top-level-value head)
+		    (bound? ghead)
+		    (constant? ghead)
+		    (builtin? (top-level-value ghead)))
+	       (top-level-value ghead)
 	       head)))
       (if (length> (cdr x) 255)
 	  ; more than 255 arguments, need long versions of instructions
@@ -410,6 +414,7 @@
 	  (let ((b (and (builtin? head)
 			(builtin->instruction head))))
 	    (if (and (eq? head 'cadr)
+		     (eq? ghead 'cadr)
 		     (not (in-env? head env))
 		     (equal? (top-level-value 'cadr) cadr)
 		     (length= x 2))
@@ -450,7 +455,8 @@
 	       ((eof-object? x)
 		(compile-in g env tail? (list (top-level-value 'eof-object))))
 	       (else        (emit g 'loadv x))))
-	((or (not (symbol? (car x))) (bound? (car x)) (in-env? (car x) env))
+	((or (not (symbol? (car x))) (bound? (resolve-global (car x)))
+	     (in-env? (car x) env))
 	 (compile-app g env tail? x))
 	(else
 	 (case (car x)
