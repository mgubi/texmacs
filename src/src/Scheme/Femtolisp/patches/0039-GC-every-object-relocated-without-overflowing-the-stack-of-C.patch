-        if ((tag(a)&3) != 0 && ismanaged(a))
-            car_(nc) = relocate_car(a);
-        cdr_(nc) = (d==NIL) ? NIL : relocate(d);
-    }
+    while (n_reloc_pending > 0)
+        scan_object(reloc_pending[--n_reloc_pending], 0);
