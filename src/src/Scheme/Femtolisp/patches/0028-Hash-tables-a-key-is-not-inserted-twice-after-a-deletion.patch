From 19a2b1ac021cecd163e46a09da090248f70c285c Mon Sep 17 00:00:00 2001
From: tm <tm@x>
Date: Sun, 18 Oct 2026 19:05:28 +0100
Subject: [PATCH] Hash tables: a key is not inserted twice after a deletion

A deleted entry keeps its key with the value HT_NOTFOUND. _lookup_bp
inserted a key in the first deleted entry of its chain even when the key
was further in the chain: two entries for the key, and after a deletion
the old one came back with its old value (get gave wrong values, table.keys
and table.foldl listed deleted keys). With 200000 random puts and
deletions on 1000 keys, 2722 gets were wrong and 845 entries were listed
for 667 keys. The key is now searched to the end of its chain (deleted
entries skipped), and inserted in the first deleted entry or else the
empty slot. Found in Julia's femtolisp (edd9a51249, which rewrote the
tables).
---
 llt/htable.inc     | 25 +++++++++++++++++++++++--
 tests/unittest.lsp |  7 +++++++
 2 files changed, 30 insertions(+), 2 deletions(-)

diff --git a/llt/htable.inc b/llt/htable.inc
index dfac596..205bd17 100644
--- a/llt/htable.inc
+++ b/llt/htable.inc
@@ -10,6 +10,12 @@
 #define max_probe(size) ((size)<=(HT_N_INLINE*2) ? (HT_N_INLINE/2) : (size)>>3)
 
 #define HTIMPL(HTNAME, HFUNC, EQFUNC)                                   \
+/* TeXmacs: a deleted entry keeps its key, with the value HT_NOTFOUND, and  \
+   an empty slot has the key HT_NOTFOUND. The insertion took the first    \
+   deleted entry even when the key was further in the chain: a duplicate, \
+   and the old entry came back after a deletion (table.keys and           \
+   table.foldl also saw it). The key is now searched to the end of its    \
+   chain, and inserted in the first deleted entry or the empty slot. */   \
 static void **HTNAME##_lookup_bp(htable_t *h, void *key)                \
 {                                                                       \
     uint_t hv;                                                          \
@@ -18,6 +24,7 @@ static void **HTNAME##_lookup_bp(htable_t *h, void *key)                \
     size_t maxprobe = max_probe(sz);                                    \
     void **tab = h->table;                                              \
     void **ol;                                                          \
+    void **deleted;                                                     \
                                                                         \
     hv = HFUNC((uptrint_t)key);                                         \
  retry_bp:                                                              \
@@ -25,14 +32,23 @@ static void **HTNAME##_lookup_bp(htable_t *h, void *key)                \
     index = (index_t)(hv & (sz-1)) * 2;                                 \
     sz *= 2;                                                            \
     orig = index;                                                       \
+    deleted = NULL;                                                     \
                                                                         \
     do {                                                                \
-        if (tab[index+1] == HT_NOTFOUND) {                              \
+        if (tab[index] == HT_NOTFOUND) {                                \
+            if (deleted != NULL) {                                      \
+                deleted[0] = key;                                       \
+                return &deleted[1];                                     \
+            }                                                           \
             tab[index] = key;                                           \
             return &tab[index+1];                                       \
         }                                                               \
                                                                         \
-        if (EQFUNC(key, tab[index]))                                    \
+        if (tab[index+1] == HT_NOTFOUND) {                              \
+            if (deleted == NULL)                                        \
+                deleted = &tab[index];                                  \
+        }                                                               \
+        else if (EQFUNC(key, tab[index]))                               \
             return &tab[index+1];                                       \
                                                                         \
         index = (index+2) & (sz-1);                                     \
@@ -41,6 +57,11 @@ static void **HTNAME##_lookup_bp(htable_t *h, void *key)                \
             break;                                                      \
     } while (index != orig);                                            \
                                                                         \
+    if (deleted != NULL) {                                              \
+        deleted[0] = key;                                               \
+        return &deleted[1];                                             \
+    }                                                                   \
+                                                                        \
     /* table full */                                                    \
     /* quadruple size, rehash, retry the insert */                      \
     /* it's important to grow the table really fast; otherwise we waste */ \
diff --git a/tests/unittest.lsp b/tests/unittest.lsp
index bee157b..865f3d9 100644
--- a/tests/unittest.lsp
+++ b/tests/unittest.lsp
@@ -95,6 +95,13 @@
 (assert (equal? (< 3 +nan.0) (> +nan.0 (double 3))))
 (assert (equal? (> 3 +nan.0) (> (double 3) +nan.0)))
 (assert (not (>= +nan.0 +nan.0)))
+; TeXmacs: a key put after the deletion of another key of its chain is
+; not added twice (the old entry came back in table.keys)
+(let ((h (table)))
+  (for 0 39 (lambda (i) (put! h i i)))
+  (for 0 39 (lambda (i) (del! h i) (put! h (+ i 1) 'x)))
+  (assert (equal? (table.keys h) '(40)))
+  (assert (equal? (table.foldl (lambda (k v n) (+ n 1)) 0 h) 1)))
 ; TeXmacs: false with one NaN too, also when compiled as instructions
 (assert (not (<= 1 +nan.0)))
 (assert (not (<= +nan.0 1)))
