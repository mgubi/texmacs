From 53d1551781a4f4aada644d8091668b83e8c464ba Mon Sep 17 00:00:00 2001
From: tm <tm@x>
Date: Sun, 18 Oct 2026 19:25:21 +0100
Subject: [PATCH] Undefined behaviour: symbol names, bytecode operands,
 fixnums, keywords

From Julia's femtolisp:
- the name of a symbol is a flexible array: strcpy into char name[1]
  aborts with _FORTIFY_SOURCE (c67787a854);
- the operands of the bytecode, which are not aligned, are read and
  written with memcpy rather than through cast pointers (24efaa4f38);
- fixnum shifts an unsigned value: a left shift of a negative value is
  undefined (cc49e3a3d8);
- fl_is_keyword_name read str[len-1] before an empty name (||).
---
 flisp.c | 20 +++++++++++++++-----
 flisp.h | 11 ++++++-----
 2 files changed, 21 insertions(+), 10 deletions(-)

diff --git a/flisp.c b/flisp.c
index ec5927f..7d7b1d6 100644
--- a/flisp.c
+++ b/flisp.c
@@ -30,6 +30,7 @@
 */
 
 #include <stdlib.h>
+#include <stddef.h>
 #include <stdio.h>
 #include <string.h>
 #include <setjmp.h>
@@ -245,7 +246,8 @@ symbol_t *symtab = NULL;
 
 int fl_is_keyword_name(char *str, size_t len)
 {
-    return ((str[0] == ':' || str[len-1] == ':') && str[1] != '\0');
+    // TeXmacs: len>1, str[len-1] was read before an empty name (||)
+    return len>1 && ((str[0] == ':' || str[len-1] == ':') && str[1] != '\0');
 }
 
 static symbol_t *mk_symbol(char *str)
@@ -253,7 +255,7 @@ static symbol_t *mk_symbol(char *str)
     symbol_t *sym;
     size_t len = strlen(str);
 
-    sym = (symbol_t*)malloc(sizeof(symbol_t)-sizeof(void*) + len + 1);
+    sym = (symbol_t*)malloc((offsetof(symbol_t,name) + len + 1 + 7) & -8);
     assert(((uptrint_t)sym & 0x7) == 0); // make sure malloc aligns 8
     sym->left = sym->right = NULL;
     sym->flags = 0;
@@ -960,9 +962,17 @@ static uint32_t process_keys(value_t kwtable,
      (((int16_t)a[1])<<8)))
 #define PUT_INT32(a,i) (*(int32_t*)(a) = bswap_32((int32_t)(i)))
 #else
-#define GET_INT32(a) (*(int32_t*)a)
-#define GET_INT16(a) (*(int16_t*)a)
-#define PUT_INT32(a,i) (*(int32_t*)(a) = (int32_t)(i))
+// TeXmacs, from Julia's femtolisp: the operands of the bytecode are not
+// aligned, a read through a cast pointer is undefined (memcpy compiles to
+// the same instructions)
+static inline int32_t get_int32(const void *a)
+{ int32_t v; memcpy(&v, a, 4); return v; }
+static inline int16_t get_int16(const void *a)
+{ int16_t v; memcpy(&v, a, 2); return v; }
+static inline void put_int32(void *a, int32_t v) { memcpy(a, &v, 4); }
+#define GET_INT32(a) get_int32(a)
+#define GET_INT16(a) get_int16(a)
+#define PUT_INT32(a,i) put_int32((a), (int32_t)(i))
 #endif
 #define SWAP_INT32(a) (*(int32_t*)(a) = bswap_32(*(int32_t*)(a)))
 #define SWAP_INT16(a) (*(int16_t*)(a) = bswap_16(*(int16_t*)(a)))
diff --git a/flisp.h b/flisp.h
index a6037ed..6c7b63c 100644
--- a/flisp.h
+++ b/flisp.h
@@ -37,10 +37,10 @@ typedef struct _symbol_t {
     // below fields are private
     struct _symbol_t *left;
     struct _symbol_t *right;
-    union {
-        char name[1];
-        void *_pad;    // ensure field aligned to pointer size
-    };
+    // TeXmacs, from Julia's femtolisp: a flexible array, as the name is
+    // longer than the field (strcpy into char name[1] aborts with
+    // _FORTIFY_SOURCE)
+    char name[] __attribute__((aligned(sizeof(void*))));
 } symbol_t;
 
 typedef struct {
@@ -63,7 +63,8 @@ typedef struct {
 #define tag(x) ((x)&0x7)
 #define ptr(x) ((void*)((x)&(~(value_t)0x7)))
 #define tagptr(p,t) (((value_t)(p)) | (t))
-#define fixnum(x) ((value_t)(((fixnum_t)(x))<<2))
+// TeXmacs: shifted unsigned (a left shift of a negative value is undefined)
+#define fixnum(x) ((value_t)(((uptrint_t)(x))<<2))
 #define numval(x)  (((fixnum_t)(x))>>2)
 #ifdef BITS64
 #define fits_fixnum(x) (((x)>>61) == 0 || (~((x)>>61)) == 0)
-- 
