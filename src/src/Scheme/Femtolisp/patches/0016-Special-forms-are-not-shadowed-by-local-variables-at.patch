From e4e4b168708162ee87c5d3647569b283babe4740 Mon Sep 17 00:00:00 2001
From: tm <tm@x>
Date: Tue, 6 Oct 2026 17:52:30 +0100
Subject: [PATCH 16/20] Special forms are not shadowed by local variables at
 the head of a form (the expansions of the macros use them); boot image
 regenerated

---
 compiler.lsp |  9 +++++++--
 flisp.boot   | 11 ++++++-----
 system.lsp   |  7 ++++++-
 3 files changed, 19 insertions(+), 8 deletions(-)

diff --git a/compiler.lsp b/compiler.lsp
index 375ee13..63b2b7b 100644
--- a/compiler.lsp
+++ b/compiler.lsp
@@ -467,6 +467,9 @@
 	      (let ((c (aref v (- (length v) 1))))
 		(and (pair? c) (eq? (car c) '%source) (cdr c)))))))
 
+; TeXmacs: a local variable does not shadow a special form at the head of a
+; form: the macros expand to special forms (cond to begin...), which a local
+; variable named begin would capture otherwise
 (define special-forms
   '(quote if begin prog1 lambda and or while for return set! define trycatch))
 
@@ -487,8 +490,10 @@
 	       ((eof-object? x)
 		(compile-in g env tail? (list (top-level-value 'eof-object))))
 	       (else        (emit g 'loadv x))))
-	((or (not (symbol? (car x))) (bound? (resolve-global (car x)))
-	     (in-env? (car x) env))
+	((or (not (symbol? (car x)))
+	     (and (not (memq (car x) special-forms))
+		  (or (bound? (resolve-global (car x)))
+		      (in-env? (car x) env))))
 	 (compile-app g env tail? x))
 	; TeXmacs: a call of a function which is not defined yet (or of a
 	; macro defined later): the hook may give another form to compile
diff --git a/flisp.boot b/flisp.boot
