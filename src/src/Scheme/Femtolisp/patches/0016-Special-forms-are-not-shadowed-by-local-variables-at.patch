   quote lambda define let-syntax)) %fl:macrocall?))
   #fn("7000r0c0q]31i2041;" #(#fn("6000r1c0qm02|;" #(#fn("9000r1|?640|;|M?670|M5<0i4:|Mi3132~|N31K;" #())))))))
 							      #fn(assq)))) expand-in)))) expand)
diff --git a/system.lsp b/system.lsp
index 53facab..e24addf 100644
--- a/system.lsp
+++ b/system.lsp
@@ -907,7 +907,12 @@
 					  (car e)
 					  (expand-in (car e) env))
 				      (loop (cdr e))))))))
-	  (cond ((and bnd (pair? (cdr bnd)))  ; local macro
+	  (cond ((memq head '(quote lambda define))  ; never shadowed (TeXmacs)
+		 (case head
+		   ((quote)  e)
+		   ((lambda) (expand-lambda e env))
+		   (else     (expand-define e env))))
+		((and bnd (pair? (cdr bnd)))  ; local macro
 		 (expand-in (apply (cadr bnd) (cdr e))
 			    (local-expansion-env (caddr bnd) env)))
 		((or bnd                      ; bound lexical or toplevel var
