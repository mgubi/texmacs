From 7e218a948c4590e2299ed3d2ac48b04265ded73a Mon Sep 17 00:00:00 2001
From: tm <tm@x>
Date: Tue, 6 Oct 2026 16:55:21 +0100
Subject: [PATCH 07/20] Compiler: a builtin called with a wrong number of
 arguments is a plain call, the error is raised at run time; boot image
 regenerated

---
 compiler.lsp | 9 +++++++++
 flisp.boot   | 9 ++++++---
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/compiler.lsp b/compiler.lsp
index a0fa203..29fba26 100644
--- a/compiler.lsp
+++ b/compiler.lsp
@@ -366,6 +366,14 @@
     (lambda (b)
       (get b2i b #f))))
 
+; a call of a builtin with a wrong number of arguments is compiled as a
+; plain call: the error is raised when it is evaluated (TeXmacs: as Guile)
+(define (builtin-argc-ok? head nargs)
+  (let ((count (get arg-counts head #f)))
+    (and (or (not count) (= nargs count))
+	 (not (and (= nargs 0) (or (eq? head -) (eq? head /))))
+	 (not (and (< nargs 2) (eq? head apply))))))
+
 (define (compile-builtin-call g env tail? x head b nargs)
   (let ((count (get arg-counts head #f)))
     (if (and count
@@ -412,6 +420,7 @@
 		 (let ((nargs (compile-arglist g env (cdr x))))
 		   (emit g (if tail? 'tcall.l 'call.l) nargs)))
 	  (let ((b (and (builtin? head)
+			(builtin-argc-ok? head (length (cdr x)))
 			(builtin->instruction head))))
 	    (if (and (eq? head 'cadr)
 		     (eq? ghead 'cadr)
