   255 compile-in #fn(":000r1e0i30i32670c1540c2|43;" #(emit tcall.l call.l))
   compile-arglist #fn(";000r1~c0<16c02i10c0<16X02e1~i3132@16J02c2c031e0>16<02e3i33b2326L0e4i30i31^i33„342e5i30c042;|7A0e4i30i31^~34530]2c6qe7i30i31i33N3341;" #(cadr
   in-env? #fn(top-level-value) length= compile-in emit #fn("=000r1~6H0e0i40i41i42i43i10~|47;e1i40i42670c2540c3|43;" #(compile-builtin-call
