From a9d28fadb5e93beae37cb22eebcf7ab431cfa72b Mon Sep 17 00:00:00 2001
From: tm <tm@x>
Date: Sun, 18 Oct 2026 15:57:56 +0100
Subject: [PATCH] No signal mask saved by the jumps of the errors on macOS

On macOS setjmp saves the signal mask and longjmp restores it, a system
call each (sigprocmask, sigreturn): about a fifth of the time of the
external scanners of tree-sitter in TeXmacs, which C calls for nearly
every token through FL_TRY. femtolisp installs no signal handler and its
jumps never leave one, so there is nothing to save: _setjmp and _longjmp
there (fl_setjmp, fl_longjmp). glibc's setjmp saves no mask, and other
systems keep setjmp.
---
 flisp.c |  4 ++--
 flisp.h | 13 ++++++++++++-
 2 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/flisp.c b/flisp.c
index 573e18d..ab7e8a1 100644
--- a/flisp.c
+++ b/flisp.c
@@ -136,7 +136,7 @@ value_t fl_lasterror;
   fl_exception_context_t _ctx; int l__tr, l__ca; \
   _ctx.sp=SP; _ctx.frame=curr_frame; _ctx.rdst=readstate; _ctx.prev=fl_ctx; \
   _ctx.ngchnd = N_GCHND; fl_ctx = &_ctx;                                    \
-  if (!setjmp(_ctx.buf)) \
+  if (!fl_setjmp(_ctx.buf)) \
     for (l__tr=1; l__tr; l__tr=0, (void)(fl_ctx=fl_ctx->prev))
 
 #define FL_CATCH \
@@ -175,7 +175,7 @@ void fl_raise(value_t e)
     fl_exception_context_t *thisctx = fl_ctx;
     if (fl_ctx->prev)   // don't throw past toplevel
         fl_ctx = fl_ctx->prev;
-    longjmp(thisctx->buf, 1);
+    fl_longjmp(thisctx->buf, 1);
 }
 
 static value_t make_error_msg(char *format, va_list args)
diff --git a/flisp.h b/flisp.h
index 6d3bc15..e17df8f 100644
--- a/flisp.h
+++ b/flisp.h
@@ -4,6 +4,17 @@
 #include <setjmp.h>
 #include <stdint.h>
 
+// the jumps of the errors save and restore no signal mask (a system call
+// each on macOS, where setjmp saves it; glibc's does not): they never leave
+// a signal handler
+#ifdef __APPLE__
+#define fl_setjmp(b) _setjmp(b)
+#define fl_longjmp(b, v) _longjmp(b, v)
+#else
+#define fl_setjmp(b) setjmp(b)
+#define fl_longjmp(b, v) longjmp(b, v)
+#endif
+
 typedef uptrint_t value_t;
 typedef int_t fixnum_t;
 #ifdef BITS64
@@ -183,7 +194,7 @@ extern value_t fl_lasterror;
 #define FL_TRY_EXTERN                                                   \
   fl_exception_context_t _ctx; int l__tr, l__ca;                        \
   fl_savestate(&_ctx); fl_ctx = &_ctx;                                  \
-  if (!setjmp(_ctx.buf))                                                \
+  if (!fl_setjmp(_ctx.buf))                                             \
     for (l__tr=1; l__tr; l__tr=0, (void)(fl_ctx=fl_ctx->prev))
 
 #define FL_CATCH_EXTERN \
-- 
