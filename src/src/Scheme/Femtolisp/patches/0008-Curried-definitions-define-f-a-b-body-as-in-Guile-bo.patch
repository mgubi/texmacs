diff --git a/system.lsp b/system.lsp
index edd63dd..40e2b33 100644
--- a/system.lsp
+++ b/system.lsp
@@ -773,6 +773,15 @@
 	(if f (apply f (cdr e))
 	    e))))
 
+;; curried definitions, as in Guile (TeXmacs): (define ((f a) b) body) is
+;; (define (f a) (lambda (b) body))
+(define (define-head-name h) (if (pair? h) (define-head-name (car h)) h))
+(define (uncurry-define e)
+  (if (and (pair? (cdr e)) (pair? (cadr e)) (pair? (caadr e)))
+      (uncurry-define
+       (list (car e) (caadr e) (list* 'lambda (cdadr e) (cddr e))))
+      e))
+
 (define (expand e)
   ; symbol resolves to toplevel; i.e. has no shadowing definition
   (define (top? s env) (not (or (bound? (resolve-global s)) (assq s env))))
@@ -844,6 +853,7 @@
 	   . ,name))))
   
   (define (expand-define e env)
+    (set! e (uncurry-define e))
     (if (or (null? (cdr e)) (atom? (cadr e)))
 	(if (null? (cddr e))
 	    e
