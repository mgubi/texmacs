From 0719a43e685cb8f5b053bd37109398dcbb043990 Mon Sep 17 00:00:00 2001
From: tm <tm@x>
Date: Tue, 6 Oct 2026 17:03:56 +0100
Subject: [PATCH 10/21] compile-unknown-call: hook for the calls of names which
 are not defined at compile time; boot image regenerated

---
 compiler.lsp | 13 +++++++++++++
 flisp.boot   | 29 +++++++++++++++++------------
 mkboot1.lsp  |  2 +-
 3 files changed, 31 insertions(+), 13 deletions(-)

diff --git a/compiler.lsp b/compiler.lsp
index 65dd3ca..ee37a61 100644
--- a/compiler.lsp
+++ b/compiler.lsp
@@ -452,6 +452,14 @@
 
 (define (fits-i8 x) (and (fixnum? x) (>= x -128) (<= x 127)))
 
+(define special-forms
+  '(quote if begin prog1 lambda and or while for return set! define trycatch))
+
+; the hook for the calls (f ...) where f is not bound at compile time: a form
+; to compile instead, or #f; an embedding redefines it (as resolve-global)
+(if (not (bound? 'compile-unknown-call))
+    (define (compile-unknown-call x env) #f))
+
 (define (compile-in g env tail? x)
   (cond ((symbol? x) (compile-sym g env x [loada loadc loadg]))
 	((atom? x)
@@ -467,6 +475,11 @@
 	((or (not (symbol? (car x))) (bound? (resolve-global (car x)))
 	     (in-env? (car x) env))
 	 (compile-app g env tail? x))
+	; TeXmacs: a call of a function which is not defined yet (or of a
+	; macro defined later): the hook may give another form to compile
+	((and (not (memq (car x) special-forms))
+	      (compile-unknown-call x env))
+	 => (lambda (y) (compile-in g env tail? y)))
 	(else
 	 (case (car x)
 	   (quote    (if (self-evaluating? (cadr x))
