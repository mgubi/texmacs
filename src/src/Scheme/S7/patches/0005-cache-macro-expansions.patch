+/* TeXmacs: caching macro expansions, as Guile does ((*s7* 'cache-macro-expansions?), #f by default).
+ *   op_macro_d calls a macro with the arguments of its call, cdr of the call, which is the same list each
+ *   time the same code runs: it is the key of a weak eq? hash table whose values are (macro . expansion).
+ *   Only op_macro_d caches: a macro applied as a function (by apply, for-each, sort!...) can be given a
+ *   list which s7 reuses with other contents.  The first call of some code goes through apply, which
+ *   turns the call into OP_MACRO_D, so the expansion is cached from the second call on.
+ *   When the macro of a call is the one of the entry (not redefined, not shadowed), the expansion is
+ *   evaluated without calling the macro again; otherwise OP_EVAL_MACRO_CACHE stores the new expansion.
+ *   Not cached: bacros (expanded in the caller's environment), calls without arguments (no key of
+ *   their own), and expansions which are multiple values.  The table is emptied when it gets large.
+ *   The optimizer treats an expansion as new code, evaluated once: it can leave there information
+ *   which holds only for that evaluation (a named let in the expansion of a loop macro then sees the
+ *   variables of the first call).  So the entry also has the set of the pairs which the macro made
+ *   (not the ones of its arguments, which are code of the caller, shared as before), and each time
+ *   the expansion is used again, those pairs are copied: the evaluator gets new pairs, as from the
+ *   macro, which is not called.
+ */
+#define Macro_Cache_Max_Entries 100000
+
+static void macro_cache_reset(s7_scheme *sc)
+{
+  if (sc->macro_cache_loc >= 0)
+    {
+      s7_gc_unprotect_at(sc, sc->macro_cache_loc);
+      sc->macro_cache_loc = -1;
+    }
+  sc->macro_cache = sc->F;
+  if (sc->cache_macro_expansions)
+    {
+      sc->macro_cache = g_make_weak_hash_table(sc, list_2(sc, make_integer(sc, 1024), global_value(sc->is_eq_symbol)));
+      sc->macro_cache_loc = s7_gc_protect(sc, sc->macro_cache);
+    }
+}
+
+static s7_pointer macro_cache_copy(s7_scheme *sc, s7_pointer made, s7_pointer p)
+{
+  /* a copy of the pairs of p which are in the set made, sharing the others */
+  s7_pointer head, tail;
+  if ((!is_pair(p)) || (s7_hash_table_ref(sc, made, p) == sc->F)) return(p);
+  head = cons(sc, macro_cache_copy(sc, made, car(p)), sc->nil);
+  tail = head;
+  for (p = cdr(p); (is_pair(p)) && (s7_hash_table_ref(sc, made, p) != sc->F); p = cdr(p))
+    {
+      set_cdr(tail, cons(sc, macro_cache_copy(sc, made, car(p)), sc->nil));
+      tail = cdr(tail);
+    }
+  set_cdr(tail, p);
+  return(head);
+}
+
+static bool macro_cache_hit_1(s7_scheme *sc) /* sc->code: the macro, sc->args: the arguments of the call */
+{
+  s7_pointer entry;
+  if ((!is_pair(sc->args)) || (!is_hash_table(sc->macro_cache))) return(false);
+  entry = s7_hash_table_ref(sc, sc->macro_cache, sc->args);
+  if ((is_pair(entry)) && (car(entry) == sc->code))
+    {
+      const bool old_gc_off = sc->gc_off;
+      sc->gc_off = true;                    /* the copy is small, and its pieces are not yet protected */
+      sc->code = macro_cache_copy(sc, cddr(entry), cadr(entry));
+      sc->gc_off = old_gc_off;
+      return(true);
+    }
+  return(false);
+}
+
+static void macro_cache_mark_pairs(s7_scheme *sc, s7_pointer set, s7_pointer p)
+{
+  /* all the pairs of p in set (cdr iteratively, car recursively) */
+  while ((is_pair(p)) && (s7_hash_table_ref(sc, set, p) == sc->F))
+    {
+      s7_hash_table_set(sc, set, p, sc->T);
+      macro_cache_mark_pairs(sc, set, car(p));
+      p = cdr(p);
+    }
 }
 
+static void macro_cache_made_pairs(s7_scheme *sc, s7_pointer set, s7_pointer p, s7_pointer made)
+{
+  /* the pairs of p which are not in set (the pairs of the arguments, and those already seen), put in made */
+  while ((is_pair(p)) && (s7_hash_table_ref(sc, set, p) == sc->F))
+    {
+      s7_hash_table_set(sc, set, p, sc->T);
+      s7_hash_table_set(sc, made, p, sc->T);
+      macro_cache_made_pairs(sc, set, car(p), made);
+      p = cdr(p);
+    }
+}
+
+#define macro_cache_lookup(Sc) ((Sc->cache_macro_expansions) && (macro_cache_hit_1(Sc)))
+
+static void macro_cache_store(s7_scheme *sc) /* OP_EVAL_MACRO_CACHE: sc->code: the macro, sc->args: the key, sc->value: the expansion */
+{
+  if ((is_pair(sc->args)) && (is_hash_table(sc->macro_cache)) && (!is_multiple_value(sc->value)))
+    {
+      if (hash_table_entries(sc->macro_cache) >= Macro_Cache_Max_Entries)
+	macro_cache_reset(sc);
+      begin_temp(sc->y, g_make_hash_table(sc, list_2(sc, make_integer(sc, 64), global_value(sc->is_eq_symbol))));
+      macro_cache_mark_pairs(sc, sc->y, sc->args);
+      begin_temp(sc->v, g_make_hash_table(sc, list_2(sc, make_integer(sc, 16), global_value(sc->is_eq_symbol))));
+      macro_cache_made_pairs(sc, sc->y, sc->value, sc->v);
+      sc->v = cons(sc, sc->value, sc->v);
+      sc->v = cons(sc, sc->code, sc->v);
+      s7_hash_table_set(sc, sc->macro_cache, sc->args, sc->v);
+      end_temp(sc->v);
+      end_temp(sc->y);
+    }
+}
