# kinetic scrolling (the cursor is at the end, so scroll up): a wheel step scrolls partly at once and glides on;
# the log lines "scroll_where" give the positions
wait 7000
window #2
# the document is inserted by wheel-inertia.scm
wait 500
wheel 300 400 0 3
wait 30
snapshot i0
wait 150
snapshot i1
wait 600
snapshot i2
wheel 300 400 0 3
wheel 300 400 0 3
wheel 300 400 0 3
wait 800
snapshot i3
