

#include "Base"

OTHER_CFLAGS = -DSDLTEXMACS $(TM_CPPFLAGS)
OTHER_CPLUSPLUSFLAGS = $(OTHER_CFLAGS) $(TM_CXXQT) $(TM_CXXFREETYPE) $(TM_CXXSDL)  $(TM_CXXGUILE)  $(TM_CXXSPARKLE) $(TM_CXXPDF)
OTHER_LDFLAGS = -Wl,-stack_size,0x1000000,-headerpad_max_install_names $(TM_LDFLAGS) $(TM_LIBS) $(TM_LDSDL)
PRODUCT_NAME = TeXmacsSDL
