

#include "Base"

OTHER_CFLAGS = -DVUETEXMACS $(TM_CPPFLAGS) $(TM_CXXQT) $(TM_CXXFREETYPE) $(TM_CXXSDL)  $(TM_CXXGUILE)  $(TM_CXXSPARKLE) $(TM_CXXPDF)
OTHER_CPLUSPLUSFLAGS = -std=c++20 $(OTHER_CFLAGS)
OTHER_LDFLAGS = -Wl,-stack_size,0x1000000,-headerpad_max_install_names $(TM_LDFLAGS) $(TM_LIBS) $(TM_LDVUE) -lSDL3_ttf -lmupdf -lmupdf-third
PRODUCT_NAME = TeXmacsVue
