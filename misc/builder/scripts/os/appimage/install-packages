                automake \
                build-essential \
                cmake \
                git \
                libtool \
                pkg-config \
                rsync \
                subversion \
                texinfo \
                unzip \
                binutils-gold \
                libglew-dev \
                mesa-common-dev \
                libglm-dev \
                libgles2-mesa-dev \
