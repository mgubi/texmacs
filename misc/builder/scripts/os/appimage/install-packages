				libfreetype6-dev \
				libssl-dev \
				libsqlite3-dev \
				libdouble-conversion-dev \
				libicu-dev \
				libinput-dev \
				libwayland-egl1-mesa \
				libxcomposite-dev \
				libxrandr-dev \
				libfontconfig1-dev \
