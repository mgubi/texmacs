#!/usr/bin/env python3

import os
import re
import sys
import shutil

def rename_folders(directory):
    # check if the directory exists
    if not os.path.isdir(directory):
        print(f"Directory {directory} does not exist")
        sys.exit(1)

    # change to the directory
    os.chdir(directory)

    # get the list of folders in the directory
    folders = [f for f in os.listdir('.') if os.path.isdir(f)]

    # loop through the folders and rename them
    for folder in folders:
        # 1. Handle Special Explicit Mappings
        mapping = {
            "wayland-protocols": "wayland-protocols",
            "xcb-proto": "xcbproto",
            "xcb-util-image": "xcb-util-image",
            "xcb-util-keysyms": "xcb-util-keysyms",
            "xcb-util-wm": "xcb-util-wm",
            "xcb-util-renderutil": "xcb-util-renderutil",
            "xcb-util-cursor": "xcb-util-cursor",
            # Ensure libxcb doesn't catch xcb-util-xxx
            "libxcb-": "libxcb", 
            # Ensure libxml2 doesn't just become 'libxml' if that's what your Makefile expects
            "libxml2-": "libxml2"
        }

        renamed = False
        for key, target in mapping.items():
            if folder.startswith(key):
                if folder == target: # already renamed
                    renamed = True
                    break
                shutil.move(folder, target)
                print(f"Renamed {folder} -> {target}")
                renamed = True
                break
        
        if renamed:
            continue

        # 2. General logic for simple libraries (freetype-2.1.0 -> freetype)
        # We only apply this if it hasn't been handled by the specific mapping above
        if '-' in folder and not folder.startswith("qt"):
            # This regex captures everything before the first hyphen followed by a digit
            # e.g., 'freetype-2.13.3' -> 'freetype', but 'libxcb-render' stays 'libxcb-render'
            new_folder_name = re.sub(r'-[0-9].*', '', folder)
            
            if new_folder_name != folder:
                if os.path.exists(new_folder_name):
                    print(f"Warning: Cannot rename {folder} to {new_folder_name}, destination exists.")
                else:
                    shutil.move(folder, new_folder_name)
                    print(f"Renamed {folder} -> {new_folder_name}")

if __name__ == "__main__":
    target_dir = sys.argv[1] if len(sys.argv) > 1 else '.'
    rename_folders(target_dir)
